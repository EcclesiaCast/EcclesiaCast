<Project Sdk="Microsoft.NET.Sdk">

  <!-- The render comparator: reads two sets of measures (RenderResult, as the
       WPF and the Avalonia benches write them) and says case by case whether
       the projected letters look the same, by the criteria of section 7.2 of
       docs/plan-mac.md. A plain library: it draws nothing and opens nothing.
       It is run by a test (EcclesiaCast.Desktop.Tests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EcclesiaCast.Presentation\EcclesiaCast.Presentation.csproj" />
  </ItemGroup>

</Project>
