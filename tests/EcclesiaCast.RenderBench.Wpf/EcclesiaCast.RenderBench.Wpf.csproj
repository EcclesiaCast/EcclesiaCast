<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws the render test set (tests/casos-de-render) with the real WPF
       controls, in memory, and leaves pictures and measures in
       artifacts/render/wpf. WinExe on purpose: a console program opens a black
       window every time it runs, and this one shows nothing at all. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <CETCompat>false</CETCompat>
    <RootNamespace>EcclesiaCast.RenderBench.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EcclesiaCast.App\EcclesiaCast.App.csproj" />
    <ProjectReference Include="..\..\src\EcclesiaCast.Presentation\EcclesiaCast.Presentation.csproj" />
  </ItemGroup>

</Project>
