<!-- The looks of App.xaml, one of each, for the picture «muestrario». The
     Avalonia twin is tests/EcclesiaCast.Desktop.Tests/Muestrario.axaml: a
     change here goes there too. -->
<UserControl x:Class="EcclesiaCast.ScreenBench.Wpf.Muestrario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EcclesiaCast.App.Controls;assembly=EcclesiaCast.App"
             Width="640" Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="16">
        <TextBlock Text="BOTONES" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
        <WrapPanel>
            <Button Content="Botón" Style="{StaticResource DarkButton}" Margin="0,0,8,8"/>
            <Button Content="Black" controls:ShortcutHint.Text="F1" Style="{StaticResource DarkButton}" Margin="0,0,8,8"/>
            <Button Content="Aceptar" Style="{StaticResource AccentButton}" Margin="0,0,8,8"/>
            <Button Content="Apagado" IsEnabled="False" Style="{StaticResource DarkButton}" Margin="0,0,8,8"/>
            <Button Content="«" Style="{StaticResource FoldButton}" Margin="0,0,8,8"/>
            <ToggleButton Style="{StaticResource VersionsExpanderStyle}" Margin="0,0,8,8"/>
            <ToggleButton Style="{StaticResource VersionsExpanderStyle}" IsChecked="True" Margin="0,0,8,8"/>
        </WrapPanel>
        <WrapPanel>
            <Button x:Name="ChipPlain" Content="RVR1960" Style="{StaticResource VersionChip}" Margin="0,0,8,8"/>
            <Button x:Name="ChipPrimary" Content="NVI" Style="{StaticResource VersionChip}" Margin="0,0,8,8"/>
            <Button x:Name="ChipSecondary" Content="DHH" Style="{StaticResource VersionChip}" Margin="0,0,8,8"/>
            <RadioButton Content="Canciones" Style="{StaticResource TabButton}" IsChecked="True" GroupName="tabs" Margin="0,0,4,8"/>
            <RadioButton Content="Biblia" Style="{StaticResource TabButton}" GroupName="tabs" Margin="0,0,8,8"/>
        </WrapPanel>
        <Button Content="Reina-Valera 1960" Style="{StaticResource VersionRow}" Width="240" HorizontalAlignment="Left"/>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Height="140">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="BIBLIOTECA" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Text="Todavía no hay canciones. Creá una o traelas de otro programa." Style="{StaticResource PlaceholderText}"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Height="140">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PLAYLIST" Style="{StaticResource PanelTitle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Visible" Margin="8,0,4,8">
                        <StackPanel>
                            <TextBlock Foreground="White" Text="Cuán grande es Él" Margin="4,3"/>
                            <TextBlock Foreground="White" Text="Santo, santo, santo" Margin="4,3"/>
                            <TextBlock Foreground="White" Text="Juan 3:16" Margin="4,3"/>
                            <TextBlock Foreground="White" Text="Anuncios" Margin="4,3"/>
                            <TextBlock Foreground="White" Text="Sublime gracia" Margin="4,3"/>
                            <TextBlock Foreground="White" Text="Salmo 23" Margin="4,3"/>
                            <TextBlock Foreground="White" Text="Bendición final" Margin="4,3"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Text="LISTAS Y AYUDAS" Style="{StaticResource PanelTitle}" Margin="0,16,0,8"/>
        <WrapPanel>
            <ComboBox Width="180" SelectedIndex="0" Margin="0,0,8,8">
                <ComboBoxItem Content="Segoe UI"/>
                <ComboBoxItem Content="Arial"/>
            </ComboBox>
            <ComboBox Width="180" IsEditable="True" Text="Medios" Margin="0,0,8,8">
                <ComboBoxItem Content="Medios"/>
                <ComboBoxItem Content="Fondos"/>
            </ComboBox>
            <ComboBox Width="140" SelectedIndex="0" IsEnabled="False" Margin="0,0,8,8">
                <ComboBoxItem Content="Apagada"/>
            </ComboBox>
        </WrapPanel>
        <TextBlock Text="Texto de ayuda del diseño de aprendizaje." Foreground="{StaticResource MutedBrush}"
                   Style="{StaticResource LearningHint}" Margin="0,0,0,8"/>

        <TextBlock Text="EDITOR" Style="{StaticResource PanelTitle}" Margin="0,8,0,8"/>
        <StackPanel Orientation="Horizontal">
            <Border Width="160" Height="80" Background="{StaticResource CheckerBrush}" Margin="0,0,16,0">
                <Thumb Style="{StaticResource BoxHandle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"/>
            </Border>
            <Image Source="{StaticResource AppLogoImage}" Width="64" Height="64" VerticalAlignment="Top"/>
            <Border Width="40" Height="24" Background="{StaticResource LiveBrush}" CornerRadius="4" Margin="16,0,0,0" VerticalAlignment="Top"/>
            <Border Width="40" Height="24" Background="{StaticResource OnTopBrush}" CornerRadius="4" Margin="8,0,0,0" VerticalAlignment="Top"/>
        </StackPanel>
    </StackPanel>
</UserControl>
