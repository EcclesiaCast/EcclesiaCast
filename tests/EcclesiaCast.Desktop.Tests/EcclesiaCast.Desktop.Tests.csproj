<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the Avalonia interface. Avalonia.Headless draws in memory with
       real Skia (not the headless stand-in), so the letters are measured and
       drawn as on the screen, and no window ever opens. They run on Windows
       and on a Mac. xUnit v3 test projects are executables. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The pictures are read pixel by pixel. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EcclesiaCast.Desktop\EcclesiaCast.Desktop.csproj" />
    <ProjectReference Include="..\EcclesiaCast.RenderCompare\EcclesiaCast.RenderCompare.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!-- LibVLC itself, for the test that plays a real video: the same Windows
       package as the program, and on a Mac the official one (3.1.3.2), which
       carries the Apple-chip build (batch 1 checked it). -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <!-- A 3-second test pattern (ffmpeg's testsrc, 320×180, no sound). -->
  <ItemGroup>
    <None Include="..\medios\prueba-3s.mp4" Link="medios\prueba-3s.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
