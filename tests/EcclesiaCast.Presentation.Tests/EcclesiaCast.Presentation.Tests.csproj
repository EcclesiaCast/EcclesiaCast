<Project Sdk="Microsoft.NET.Sdk">

  <!-- Smoke tests of the view models: they run on Windows and on a Mac, so the
       whole MainViewModel is built and driven on every change, with made-up
       platform services and a library in a temporary folder. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EcclesiaCast.Core\EcclesiaCast.Core.csproj" />
    <ProjectReference Include="..\..\src\EcclesiaCast.Data\EcclesiaCast.Data.csproj" />
    <ProjectReference Include="..\..\src\EcclesiaCast.Presentation\EcclesiaCast.Presentation.csproj" />
  </ItemGroup>

</Project>
