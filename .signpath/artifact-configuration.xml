<?xml version="1.0" encoding="utf-8"?>
<!-- What SignPath signs in the artifact the release workflow uploads: the
     zip that actions/upload-artifact makes, with the Inno Setup installer
     inside. Paste it into the project's artifact configuration on SignPath. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="EcclesiaCast-*-setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
