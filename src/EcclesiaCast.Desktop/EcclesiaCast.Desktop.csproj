<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Avalonia interface (the Mac plan, phase 2). For now a library with
       the projector's controls; in batch 11 it becomes the program. It uses
       Presentation, Core and Data and knows nothing of WPF: the App project
       does not reference it, the two interfaces live side by side. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EcclesiaCast.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The video frames are copied from VLC's buffer into the bitmaps. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="EcclesiaCast.Presentation.Platform" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EcclesiaCast.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EcclesiaCast.Core\EcclesiaCast.Core.csproj" />
    <ProjectReference Include="..\EcclesiaCast.Data\EcclesiaCast.Data.csproj" />
    <ProjectReference Include="..\EcclesiaCast.Presentation\EcclesiaCast.Presentation.csproj" />
  </ItemGroup>

  <!-- The free fonts that come with the program (SIL OFL 1.1), each in its
       folder with its license: Selawik (Microsoft, the measures of Segoe UI),
       Carlito (the measures of Calibri) and Anton (titles). The licenses go
       out next to the program. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\**\*.ttf" />
    <None Include="Assets\Fonts\**\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>

</Project>
