<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Avalonia program (the Mac plan): the projector's controls and,
       since batch 11, the test program for the Mac (a provisional operator's
       window over the real MainViewModel). It uses Presentation, Core, Data
       and Platform.Mac and knows nothing of WPF: the App project does not
       reference it, the two interfaces live side by side. A WinExe, so on
       Windows it never opens a console. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The name stays EcclesiaCast.Desktop: the fonts are found at
         avares://EcclesiaCast.Desktop/… The Mac bundle is EcclesiaCast.app all the same. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EcclesiaCast.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The video frames are copied from VLC's buffer into the bitmaps. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="EcclesiaCast.Presentation.Platform" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EcclesiaCast.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EcclesiaCast.Core\EcclesiaCast.Core.csproj" />
    <ProjectReference Include="..\EcclesiaCast.Data\EcclesiaCast.Data.csproj" />
    <ProjectReference Include="..\EcclesiaCast.Presentation\EcclesiaCast.Presentation.csproj" />
    <ProjectReference Include="..\EcclesiaCast.Platform.Mac\EcclesiaCast.Platform.Mac.csproj" />
  </ItemGroup>

  <!-- The free fonts that come with the program (SIL OFL 1.1), each in its
       folder with its license: Selawik (Microsoft, the measures of Segoe UI),
       Carlito (the measures of Calibri) and Anton (titles). The licenses go
       out next to the program. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\**\*.ttf" />
    <None Include="Assets\Fonts\**\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- On Windows, the very folders and calls of the WPF program: these files
       are plain .NET (no WPF, no Windows-only types), so they are shared
       with Platform.Windows instead of copied. The program picks them or
       Platform.Mac's when it starts. -->
  <ItemGroup>
    <Compile Include="..\EcclesiaCast.Platform.Windows\WindowsPlatformPaths.cs" Link="Platform\Windows\WindowsPlatformPaths.cs" />
    <Compile Include="..\EcclesiaCast.Platform.Windows\WindowsOutputWindowNative.cs" Link="Platform\Windows\WindowsOutputWindowNative.cs" />
    <Compile Include="..\EcclesiaCast.Platform.Windows\WindowsPowerGuard.cs" Link="Platform\Windows\WindowsPowerGuard.cs" />
    <Compile Include="..\EcclesiaCast.Platform.Windows\PowerThrottling.cs" Link="Platform\Windows\PowerThrottling.cs" />
  </ItemGroup>

  <!-- What comes with the program: the Bibles (with their licenses) and the
       sample video backgrounds, as the Windows installer leaves them. In the
       Mac bundle they move to Contents/Resources (mac/bundle.sh). -->
  <ItemGroup>
    <None Include="..\..\installer\bibles\*.ecbiblias;..\..\installer\bibles\LICENCIAS.md" Link="bibles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\installer\fondos\*.mp4;..\..\installer\fondos\LICENCIA.md" Link="fondos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- LibVLC itself: the official VideoLAN packages, as the tests use them.
       The Mac one (3.1.3.2) carries the Apple-chip build; a publish for
       osx-arm64 takes only that tree, under libvlc/osx-arm64/lib (batch 1). -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) Or $(RuntimeIdentifier.StartsWith('osx'))">
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And !$(RuntimeIdentifier.StartsWith('osx'))">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

</Project>
