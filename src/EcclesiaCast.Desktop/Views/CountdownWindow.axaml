<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EcclesiaCast.Presentation.ViewModels"
        x:Class="EcclesiaCast.Desktop.Views.CountdownWindow"
        x:DataType="vm:CountdownViewModel"
        Title="Cuenta regresiva"
        Width="520" SizeToContent="Height"
        CanResize="False">
    <Window.Styles>
        <Style Selector="TextBox.time">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.text">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Styles>
    <StackPanel Margin="18">

        <TextBlock Text="Se proyecta sobre el fondo que tengas puesto, hasta que la detengas."
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <!-- Cuánto falta: minutos desde ahora, o una hora del reloj -->
        <RadioButton Name="ByMinutesChoice" IsChecked="{Binding ByMinutes}"
                     Foreground="White" VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Empezar en" VerticalAlignment="Center" Foreground="White"/>
                <TextBox Name="MinutesBox" Classes="time" Text="{Binding Minutes}" Width="56" Margin="8,0"/>
                <TextBlock Text="minutos" VerticalAlignment="Center" Foreground="White"/>
            </StackPanel>
        </RadioButton>

        <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
            <Button Content="5" Width="44" Theme="{StaticResource DarkButton}" Click="Preset_Click" Tag="5"/>
            <Button Content="10" Width="44" Theme="{StaticResource DarkButton}" Margin="6,0,0,0" Click="Preset_Click" Tag="10"/>
            <Button Content="15" Width="44" Theme="{StaticResource DarkButton}" Margin="6,0,0,0" Click="Preset_Click" Tag="15"/>
            <Button Content="30" Width="44" Theme="{StaticResource DarkButton}" Margin="6,0,0,0" Click="Preset_Click" Tag="30"/>
        </StackPanel>

        <RadioButton Name="ByClockChoice" IsChecked="{Binding ByClock}" Margin="0,14,0,0"
                     Foreground="White" VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Empezar a las" VerticalAlignment="Center" Foreground="White"/>
                <TextBox Name="ClockBox" Classes="time" Text="{Binding Clock}" Width="76" Margin="8,0"
                         ToolTip.Tip="Hora del reloj, en 24 horas: 10:30, 19:00"/>
                <TextBlock Text="(hora del reloj)" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </StackPanel>
        </RadioButton>

        <TextBlock Classes="label" Text="Texto de arriba" Margin="0,18,0,4"/>
        <TextBox Classes="text" Text="{Binding Heading}"/>

        <TextBlock Classes="label" Text="Cuando llega a cero" Margin="0,14,0,4"/>
        <TextBox Classes="text" Text="{Binding FinishedMessage}"
                 ToolTip.Tip="Queda en pantalla hasta que la detengas. Vacío deja el 0:00."/>

        <TextBlock Name="ErrorText" Text="{Binding Error}" Foreground="#E86A6A" FontSize="12"
                   Margin="0,10,0,0" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Detener la que corre" Theme="{StaticResource DarkButton}"
                    Padding="16,8" Margin="0,0,8,0" Click="Stop_Click" IsVisible="{Binding IsRunning}"/>
            <Button Content="Proyectar" Theme="{StaticResource AccentButton}" Padding="22,8"
                    IsDefault="True" Click="Start_Click"/>
            <Button Content="Cancelar" Theme="{StaticResource DarkButton}" Padding="20,8"
                    Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
