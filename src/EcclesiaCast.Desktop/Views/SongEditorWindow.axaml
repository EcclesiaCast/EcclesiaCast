<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EcclesiaCast.Presentation.ViewModels"
        x:Class="EcclesiaCast.Desktop.Views.SongEditorWindow"
        x:DataType="vm:SongEditorViewModel"
        Title="Canción"
        Width="680" Height="680"
        MinWidth="520" MinHeight="480">
    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="Button.tag">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Styles>
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0">
            <TextBlock Classes="label" Text="Título *"/>
            <TextBox Name="TitleBox"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*,12,*">
            <StackPanel Grid.Column="0">
                <TextBlock Classes="label" Text="Artista"/>
                <TextBox Name="ArtistBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Classes="label" Text="Copyright / CCLI"/>
                <TextBox Name="CopyrightBox"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Classes="label" Text="Tema de proyección"/>
            <ComboBox Name="ThemeCombo" FontSize="13" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                      ToolTip.Tip="'(Tema principal)' sigue al tema principal de las canciones. Para retocar el tema de esta canción: clic derecho en la canción → Tema de esta canción…">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SongThemeChoice">
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="3" Classes="label" Text="Letra *" Margin="0,16,0,4"/>
        <TextBlock Grid.Row="4" FontSize="11" Foreground="{StaticResource FaintBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="Cada párrafo es una diapositiva: separá las diapositivas con una línea en blanco. Para marcar el coro y las estrofas, poné el cursor en el párrafo y tocá un botón: agrega arriba una línea como [Coro] o [Estrofa 1], que no se proyecta y le pone nombre a los párrafos que siguen."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Marcar como:" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Classes="tag" Content="Coro" Tag="Coro" Click="Tag_Click"
                    Theme="{StaticResource DarkButton}"
                    ToolTip.Tip="Pone [Coro] arriba del párrafo donde está el cursor"/>
            <Button Classes="tag" Content="Estrofa" Tag="Estrofa" Click="Tag_Click"
                    Theme="{StaticResource DarkButton}" Margin="6,0,0,0"
                    ToolTip.Tip="Pone [Estrofa 1], [Estrofa 2]… arriba del párrafo donde está el cursor: se numera sola"/>
            <Button Classes="tag" Content="Puente" Tag="Puente" Click="Tag_Click"
                    Theme="{StaticResource DarkButton}" Margin="6,0,0,0"
                    ToolTip.Tip="Pone [Puente] arriba del párrafo donde está el cursor"/>
            <Button Classes="tag" Content="Final" Tag="Final" Click="Tag_Click"
                    Theme="{StaticResource DarkButton}" Margin="6,0,0,0"
                    ToolTip.Tip="Pone [Final] arriba del párrafo donde está el cursor"/>
        </StackPanel>

        <!-- Sin corrector de ortografía todavía en la versión de Mac (fase 5). -->
        <TextBox Grid.Row="6" Name="LyricsBox"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Padding="10,8"/>

        <DockPanel Grid.Row="7" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" Theme="{StaticResource DarkButton}" IsCancel="True"
                        Padding="18,9" Click="Cancel_Click"/>
                <Button Content="Guardar" Theme="{StaticResource AccentButton}" Click="Save_Click"
                        Padding="18,9" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Name="ErrorText" Text="{Binding Error}" Foreground="#E08A8A" FontSize="12"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
