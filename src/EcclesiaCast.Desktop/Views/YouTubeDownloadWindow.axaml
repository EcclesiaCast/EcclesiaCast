<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EcclesiaCast.Presentation.ViewModels"
        x:Class="EcclesiaCast.Desktop.Views.YouTubeDownloadWindow"
        x:DataType="vm:YouTubeDownloadViewModel"
        Title="Descargar video"
        Width="480" SizeToContent="Height"
        CanResize="False">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding Title}"
                   FontSize="15" Foreground="White" TextWrapping="Wrap"/>

        <TextBlock Name="StatusText" Text="{Binding Status}"
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>

        <ProgressBar Name="Bar" Classes="work" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="100"
                     Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"/>

        <TextBlock Text="{Binding Quality}"
                   FontSize="11" Foreground="{StaticResource FaintBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Name="CloseButton" Content="{Binding CloseText}" Theme="{StaticResource DarkButton}"
                    Padding="20,8" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
