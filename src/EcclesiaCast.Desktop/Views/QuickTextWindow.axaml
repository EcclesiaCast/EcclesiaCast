<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EcclesiaCast.Desktop.Views.QuickTextWindow"
        Title="Edición rápida"
        Width="520" Height="320"
        MinWidth="380" MinHeight="240">
    <Grid Margin="18" RowDefinitions="Auto,*,Auto">

        <TextBlock Name="MessageText" Text="Corregí el texto de esta diapositiva (solo el texto — el formato no cambia)."
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- The WPF one underlines doubtful words; there is no spelling
             checker here yet (Feature.SpellCheck) -->
        <TextBox Name="Editor" Grid.Row="1"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 Padding="10,8" FontSize="15"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Guardar" Theme="{StaticResource AccentButton}" Click="Save_Click" Padding="20,8"/>
            <Button Content="Cancelar" Theme="{StaticResource DarkButton}" IsCancel="True" Padding="20,8"
                    Margin="8,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
