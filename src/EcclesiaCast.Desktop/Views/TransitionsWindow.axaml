<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:EcclesiaCast.Desktop.Controls"
        x:Class="EcclesiaCast.Desktop.Views.TransitionsWindow"
        Title="Transiciones de la pantalla"
        Width="500" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="TextBlock.row">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.row.unit">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,12"/>
        </Style>
    </Window.Styles>
    <StackPanel Margin="20">
        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                   Text="Cuánto tarda en aparecer o desaparecer cada cosa, en segundos. Con 0 corta de golpe. La transición de la letra se elige en cada tema (Proyección → Temas…)."/>

        <Grid Margin="0,16,0,0" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="row" Text="Logo (F3)"/>
            <controls:NumericField Name="LogoField" Grid.Column="1" Minimum="0" Maximum="10" Step="0.1" Decimals="1"/>
            <TextBlock Grid.Column="2" Text="s" Margin="6,0,0,0" Classes="row unit"/>
        </Grid>
        <TextBlock Classes="hint"
                   Text="El logo aparece y desaparece fundiéndose en este tiempo."/>

        <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="row" Text="Cambio de imagen o video"/>
            <controls:NumericField Name="MediaField" Grid.Column="1" Minimum="0" Maximum="10" Step="0.1" Decimals="1"/>
            <TextBlock Grid.Column="2" Text="s" Margin="6,0,0,0" Classes="row unit"/>
        </Grid>
        <TextBlock Classes="hint"
                   Text="Cuánto tarda la imagen nueva en reemplazar a la anterior. Con un video pesado conviene dejarlo corto."/>

        <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="row" Text="Pantalla negra (F1)"/>
            <controls:NumericField Name="BlackField" Grid.Column="1" Minimum="0" Maximum="10" Step="0.1" Decimals="1"/>
            <TextBlock Grid.Column="2" Text="s" Margin="6,0,0,0" Classes="row unit"/>
        </Grid>
        <TextBlock Classes="hint"
                   Text="La pantalla se va a negro y vuelve en este tiempo."/>

        <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="row" Text="Apagar la salida (Esc)"/>
            <controls:NumericField Name="OutputField" Grid.Column="1" Minimum="0" Maximum="10" Step="0.1" Decimals="1"/>
            <TextBlock Grid.Column="2" Text="s" Margin="6,0,0,0" Classes="row unit"/>
        </Grid>
        <TextBlock Classes="hint"
                   Text="Al apagar la proyección, la pantalla se funde a negro antes de cerrarse. Con 0 se apaga de golpe."/>

        <TextBlock Foreground="{StaticResource FaintBrush}" FontSize="11" TextWrapping="Wrap"
                   Text="Con el modo PC de bajo rendimiento todo corta de golpe, sin importar estos tiempos."/>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="Valores de fábrica" Theme="{StaticResource DarkButton}" Padding="14,8"
                    Click="Defaults_Click"/>
            <Button Content="Guardar" Theme="{StaticResource AccentButton}" IsDefault="True"
                    Click="Save_Click" Padding="20,8" Margin="140,0,0,0"/>
            <Button Content="Cancelar" Theme="{StaticResource DarkButton}" IsCancel="True"
                    Padding="20,8" Margin="8,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
