<Window x:Class="EcclesiaCast.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EcclesiaCast.App.Controls"
        xmlns:services="clr-namespace:EcclesiaCast.App.Services"
        Title="EcclesiaCast — Operador"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding ToggleBlackCommand}"/>
        <KeyBinding Key="F2" Command="{Binding ToggleClearCommand}"/>
        <KeyBinding Key="F3" Command="{Binding ToggleLogoCommand}"/>
        <KeyBinding Key="F4" Command="{Binding ClearBackgroundCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding HideOutputCommand}"/>
        <!-- Una sola caja para buscar en canciones, versículos y medios -->
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding SearchEverythingCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding SearchEverythingCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- LIVE · PREVIEW · ESCENARIO as the tabs of one box. Both boxes carry
             this strip, so whichever one is on show has it in the same place.
             The radio buttons need no group name: each strip is its own group. -->
        <DataTemplate x:Key="OutputTabsTemplate">
            <StackPanel Orientation="Horizontal" Margin="8,6,10,4">
                <RadioButton Style="{StaticResource TabButton}" Padding="9,4" FontSize="11"
                             IsChecked="{Binding MergedTab, Converter={StaticResource IndexIs}, ConverterParameter=0}"
                             ToolTip="Lo que se está proyectando ahora">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource LiveBrush}" Margin="0,0,6,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="LIVE"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Content="PREVIEW" Style="{StaticResource TabButton}" Padding="9,4" FontSize="11"
                             Margin="2,0,0,0"
                             IsChecked="{Binding MergedTab, Converter={StaticResource IndexIs}, ConverterParameter=1}"
                             ToolTip="La diapositiva que va a salir después"/>
                <RadioButton Content="ESCENARIO" Style="{StaticResource TabButton}" Padding="9,4" FontSize="11"
                             Margin="2,0,0,0"
                             IsChecked="{Binding MergedTab, Converter={StaticResource IndexIs}, ConverterParameter=2}"
                             ToolTip="Lo que ven los músicos y quien predica en la pantalla de escenario, aunque no esté prendida"/>
            </StackPanel>
        </DataTemplate>

        <!-- Controls of the video on screen. Used under LIVE and, while the
             boxes are merged, under PREVIEW too. -->
        <DataTemplate x:Key="VideoTransportTemplate">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PlaybackTimeText}" FontSize="11"
                               VerticalAlignment="Center" TextAlignment="Right"
                               Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="⏮" FontSize="12" Padding="8,3"
                                Style="{StaticResource DarkButton}"
                                AutomationProperties.Name="Volver al principio"
                                Command="{Binding RestartVideoCommand}"
                                ToolTip="Volver al principio del video"/>
                        <Button Content="⏪ 10s" FontSize="11" Padding="7,3" Margin="4,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding SkipBackwardCommand}"
                                ToolTip="Retroceder 10 segundos"/>
                        <Button FontSize="12" Padding="10,3" Margin="4,0,0,0"
                                AutomationProperties.Name="Reproducir o pausar"
                                Command="{Binding TogglePlayPauseCommand}"
                                ToolTip="Reproducir o pausar el video que está en pantalla">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                    <Setter Property="Content" Value="▶"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVideoPlaying}" Value="True">
                                            <Setter Property="Content" Value="⏸"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="10s ⏩" FontSize="11" Padding="7,3" Margin="4,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding SkipForwardCommand}"
                                ToolTip="Adelantar 10 segundos"/>
                    </StackPanel>
                </DockPanel>
                <!-- Barra de progreso, arrastrable -->
                <Slider Minimum="0" Maximum="{Binding PlaybackDurationSeconds}"
                        Value="{Binding PlaybackPositionSeconds}"
                        IsMoveToPointEnabled="True" Margin="0,6,0,0"
                        ToolTip="Arrastrá para moverte dentro del video"/>
            </StackPanel>
        </DataTemplate>
        <!-- Menú de clic derecho de las tarjetas de la barra de medios. Es uno solo,
             compartido: se arma al abrirse (MediaMenu_Opened) según qué tarjeta lo
             abrió y cuántas hay elegidas. -->
        <ContextMenu x:Key="MediaCardMenu" Opened="MediaMenu_Opened">
            <MenuItem Header="Agregar a la playlist"
                      Command="{Binding PlacementTarget.Tag.AddMediaToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <!-- Sólo en una imagen o un video de archivo, con una sola tarjeta elegida -->
            <MenuItem x:Name="UseAsLogoItem" Header="Usar como logo"
                      Command="{Binding PlacementTarget.Tag.UseMediaAsLogoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      ToolTip="Lo suma a la lista de logos para mostrarlo con F3. No cambia el logo que está en pantalla."/>
            <!-- Sus pestañas se llenan al abrirse -->
            <MenuItem x:Name="MoveToTabItem" Header="Mover a la pestaña…" SubmenuOpened="MoveToTab_SubmenuOpened">
                <MenuItem Header="(cargando)" IsEnabled="False"/>
            </MenuItem>
            <!-- Sólo en las páginas web guardadas: no tienen Propiedades de encuadre,
                 así que el nombre se cambia desde acá -->
            <MenuItem x:Name="RenameMediaItem" Header="Cambiar nombre…" Visibility="Collapsed"
                      Command="{Binding PlacementTarget.Tag.RenameMediaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator Visibility="{Binding PlacementTarget.DataContext.IsYouTube, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="Descargar para uso local"
                      Visibility="{Binding PlacementTarget.DataContext.IsYouTube, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                      Command="{Binding PlacementTarget.Tag.DownloadYouTubeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      ToolTip="Guarda el video en la computadora para no depender de internet durante la reunión"/>
            <Separator x:Name="InspectSeparator"/>
            <MenuItem x:Name="InspectItem" Header="Propiedades (Inspector)…"
                      Command="{Binding PlacementTarget.Tag.InspectMediaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <!-- Sólo en los videos de archivo (los de YouTube no tienen qué aliviar) -->
            <MenuItem Header="Hacer una copia liviana…"
                      Command="{Binding PlacementTarget.Tag.MakeLightCopyOfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      ToolTip="Para un video de 4K o de 50 cuadros o más que anda a los saltos: se hace una copia más liviana para proyectar. El original queda donde está y la biblioteca guarda los dos.">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Type, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="Video">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <!-- Sólo en las páginas que el programa dibujó de un PDF o una presentación -->
            <MenuItem x:Name="ReimportItem" Header="Volver a importar en alta calidad…" Visibility="Collapsed"
                      Command="{Binding PlacementTarget.Tag.ReimportDocumentPageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      ToolTip="Dibuja de nuevo todas las páginas de este documento al doble de tamaño, para que no se pixelen con zoom."/>
            <MenuItem x:Name="OpenLocationItem" Header="Abrir ubicación del archivo"
                      Command="{Binding PlacementTarget.Tag.OpenMediaLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem x:Name="RemoveMediaItem" Header="Quitar de la biblioteca"
                      Command="{Binding PlacementTarget.Tag.DeleteMediaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Menú ══
             Todo lo que se hace de vez en cuando (importar, copias de
             seguridad, el diseño de la ventana) vive acá; los botones quedan
             para lo que se usa en medio del servicio. -->
        <Menu Grid.Row="0" Padding="6,2" FontSize="12">

            <MenuItem Header="_Archivo">
                <MenuItem Header="Buscar canciones en internet…" Command="{Binding SearchSongsOnlineCommand}"/>
                <MenuItem Header="Traer canciones de ProPresenter…" Command="{Binding ImportFromProPresenterCommand}"/>
                <MenuItem Header="Importar canciones (.txt, .pro)…" Command="{Binding ImportSongsCommand}"/>
                <MenuItem Header="Importar una Biblia (JSON o Zefania XML)…" Command="{Binding ImportBibleCommand}"/>
                <MenuItem Header="Exportar paquete de Biblias…" Command="{Binding ExportBiblePackageCommand}"
                          ToolTip="Guarda varias versiones en un solo archivo (.ecbiblias) para llevarlas a otra computadora tuya."/>
                <MenuItem Header="Importar paquete de Biblias…" Command="{Binding ImportBiblePackageCommand}"/>
                <MenuItem Header="Agregar imágenes, videos, PDF o PowerPoint…" Command="{Binding ImportMediaCommand}"/>
                <Separator/>
                <MenuItem Header="Guardar una copia de la biblioteca…" Command="{Binding SaveBackupCommand}"/>
                <MenuItem Header="Restaurar desde una copia…" Command="{Binding RestoreBackupCommand}"/>
                <Separator/>
                <MenuItem Header="Salir" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="_Edición">
                <MenuItem Header="Nueva canción" Command="{Binding NewSongCommand}"/>
                <MenuItem Header="Editar la canción elegida" Command="{Binding EditSongCommand}"/>
                <Separator/>
                <MenuItem Header="Nueva playlist" Command="{Binding NewPlaylistCommand}"/>
                <Separator/>
                <MenuItem Header="Temas…" Command="{Binding OpenThemesCommand}"/>
                <MenuItem Header="Logos…" Command="{Binding OpenLogosCommand}"/>
                <Separator/>
                <MenuItem Header="Buscar en todo" InputGestureText="Ctrl+K" Command="{Binding SearchEverythingCommand}"/>
            </MenuItem>

            <MenuItem Header="_Ver" SubmenuOpened="ViewMenu_SubmenuOpened">
                <MenuItem x:Name="LibraryRightItem" Header="Canciones y playlist a la derecha"
                          IsCheckable="True" Click="LibraryRight_Click"/>
                <MenuItem x:Name="PlaylistTopItem" Header="Playlist arriba de las canciones"
                          IsCheckable="True" Click="PlaylistTop_Click"/>
                <MenuItem x:Name="MediaTopItem" Header="Medios arriba de las diapositivas"
                          IsCheckable="True" Click="MediaTop_Click"/>
                <MenuItem x:Name="SplitOutputItem" Header="Separar el PREVIEW del LIVE"
                          IsCheckable="True" Click="SplitOutput_Click"
                          ToolTip="Por defecto, LIVE, PREVIEW y ESCENARIO son pestañas de un solo recuadro. Tildado, vuelven a ser dos recuadros, uno arriba del otro."/>
                <MenuItem x:Name="LiveBottomItem" Header="Preview arriba del Live"
                          IsCheckable="True" Click="LiveBottom_Click"/>
                <Separator/>
                <MenuItem x:Name="LibraryCollapsedItem" Header="Achicar canciones y Biblia"
                          IsCheckable="True" Click="LibraryCollapsedItem_Click"/>
                <MenuItem x:Name="PlaylistCollapsedItem" Header="Achicar la playlist"
                          IsCheckable="True" Click="PlaylistCollapsedItem_Click"/>
                <MenuItem x:Name="MediaCollapsedItem" Header="Achicar la barra de medios"
                          IsCheckable="True" Click="MediaCollapsedItem_Click"
                          ToolTip="Deja sólo la cabecera de la barra de medios (con sus botones) y le da el lugar a las diapositivas."/>
                <MenuItem x:Name="ToolsCollapsedItem" Header="Achicar las herramientas de texto"
                          IsCheckable="True" Click="ToolsCollapsedItem_Click"
                          ToolTip="Texto rápido, aviso al pie, resaltar, notas, música y tiempos quedan como una tira de íconos."/>
                <MenuItem x:Name="LeftRailItem" Header="Canciones y playlist como íconos"
                          IsCheckable="True" Click="LeftRailItem_Click"
                          ToolTip="Achica canciones, Biblia y playlist a una columna angosta de íconos."/>
                <Separator/>
                <MenuItem Header="Modo PC de bajo rendimiento" IsCheckable="True"
                          IsChecked="{Binding IsLowPerformance, Mode=TwoWay}"
                          ToolTip="Para computadoras viejas o sin placa de video: las transiciones cortan, el panel LIVE muestra la imagen fija del video y las vistas previas se dibujan sin sombra ni contorno. Lo que ve la congregación conserva su diseño."/>
                <MenuItem Header="Reiniciar el sonido" Click="RestartSound_Click"
                          ToolTip="Si no suena nada después de cambiar la salida de audio de Windows (parlantes, auriculares, Bluetooth): vuelve a abrir el sonido de la música y de los videos, en el mismo lugar. Los videos de YouTube siguen solos la salida de Windows."/>
                <Separator/>
                <!-- Con los atajos a la vista (F1, Esc…) o sin ellos, con menos texto.
                     Cambia sólo lo que se lee en la ventana: los atajos andan en los dos. -->
                <MenuItem x:Name="LearningModeItem" Header="Diseño de aprendizaje (con atajos a la vista)"
                          IsCheckable="True" Click="LearningMode_Click"/>
                <MenuItem x:Name="AdvancedModeItem" Header="Diseño avanzado (menos texto, sin atajos)"
                          IsCheckable="True" Click="AdvancedMode_Click"/>
                <Separator/>
                <MenuItem Header="Volver al diseño original" Click="ResetLayout_Click"/>
            </MenuItem>

            <MenuItem Header="_Proyección">
                <MenuItem Header="Poner en vivo / apagar la salida" Command="{Binding ToggleOutputCommand}"/>
                <Separator/>
                <MenuItem Header="Black" InputGestureText="F1" Command="{Binding ToggleBlackCommand}"/>
                <MenuItem Header="Clear" InputGestureText="F2" Command="{Binding ToggleClearCommand}"/>
                <MenuItem Header="Logo" InputGestureText="F3" Command="{Binding ToggleLogoCommand}"/>
                <MenuItem Header="Sin fondo" InputGestureText="F4" Command="{Binding ClearBackgroundCommand}"/>
                <Separator/>
                <MenuItem Header="Pantalla de escenario" Command="{Binding ToggleStageCommand}"/>
                <MenuItem Header="Editar los escenarios…" Command="{Binding EditStageCommand}"/>
                <MenuItem Header="Poner el cronómetro del escenario en cero" Command="{Binding ResetStageTimerCommand}"/>
                <!-- Antes era un botón que se pintaba mientras la cuenta corre:
                     ahora el ítem lo dice con una tilde. -->
                <MenuItem Command="{Binding OpenCountdownCommand}">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="Cuenta regresiva…"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCountdownRunning}" Value="True">
                                    <Setter Property="Header" Value="✔ Cuenta regresiva en marcha… (detener o cambiar)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="Transiciones…" Click="Transitions_Click"
                          ToolTip="Cuántos segundos tardan en aparecer y desaparecer el logo, los cambios de imagen o video, la pantalla negra y el apagado de la salida."/>
                <MenuItem Header="Controlar desde el celular…" Command="{Binding OpenRemoteCommand}"/>
                <Separator/>
                <MenuItem Header="Actualizar la lista de pantallas" Command="{Binding RefreshDisplaysCommand}"/>
            </MenuItem>

            <MenuItem Header="A_yuda">
                <MenuItem Header="Guía de uso (en internet)" Click="Guide_Click"/>
                <Separator/>
                <MenuItem Header="Buscar actualizaciones…" Command="{Binding CheckForUpdatesCommand}"/>
                <MenuItem Header="Buscar actualizaciones al abrir" IsCheckable="True"
                          IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}"
                          ToolTip="Una vez por día, a los pocos segundos de abrir el programa, mira en GitHub si hay una versión nueva. No manda nada tuyo. Nunca interrumpe mientras se proyecta."/>
                <Separator/>
                <MenuItem Header="Acerca de EcclesiaCast" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Hay una versión nueva. Discreto a propósito: va en la fila del menú,
             porque la barra de abajo no tiene lugar de sobra, no abre nada solo
             y queda hasta que se actualice o se salte esa versión. -->
        <Button x:Name="UpdateAvailableButton" Grid.Row="0" Content="⬆ Versión nueva"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,2,12,2" Padding="10,2" FontSize="12"
                Foreground="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                Style="{StaticResource DarkButton}"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                Command="{Binding ShowUpdateCommand}"
                ToolTip="{Binding UpdateToolTip}"/>

        <!-- ══ Barra superior ══ -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,9">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="EcclesiaCast"
                           FontSize="17" FontWeight="SemiBold" Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="24,0,0,0">
                    <Button Content="Black" controls:ShortcutHint.Text="F1" Command="{Binding ToggleBlackCommand}"
                            ToolTip="Pantalla en negro: tapa todo (letra y fondo) sin apagar la salida.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBlackActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Clear" controls:ShortcutHint.Text="F2" Command="{Binding ToggleClearCommand}" Margin="6,0,0,0"
                            ToolTip="Saca la letra de la pantalla y deja el fondo (imagen o video) a la vista. Se vuelve a apretar para traer la letra de nuevo.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsClearActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Logo: el botón lo prende/apaga, la flecha elige cuál -->
                    <Button Content="Logo" controls:ShortcutHint.Text="F3" Command="{Binding ToggleLogoCommand}" Margin="6,0,0,0"
                            ToolTip="{Binding ActiveLogoName, StringFormat='Muestra el logo a pantalla completa. Ahora está elegido: {0}'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogoActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Los botones que son sólo un ícono llevan su nombre escrito:
                         un lector de pantalla, si no, anuncia el nombre del emoji. -->
                    <Button x:Name="LogoPickerButton" Content="▾" Padding="8,7" Margin="2,0,0,0"
                            Style="{StaticResource DarkButton}"
                            AutomationProperties.Name="Elegir logo"
                            Click="LogoPicker_Click"
                            ToolTip="Elegir qué logo se muestra (general, jóvenes, mujeres…)"/>
                    <Button Content="🖼▦" Padding="8,7" Margin="2,0,0,0"
                            Style="{StaticResource DarkButton}"
                            AutomationProperties.Name="Logo de fondo"
                            Command="{Binding UseLogoAsBackgroundCommand}"
                            IsEnabled="{Binding CanUseLogoAsBackground}"
                            ToolTip="Poner el logo de fondo, detrás de la letra, con el desenfoque que tenga configurado"/>
                    <Button Content="Sin fondo" controls:ShortcutHint.Text="F4" Margin="6,0,0,0"
                            Style="{StaticResource DarkButton}"
                            Command="{Binding ClearBackgroundCommand}"
                            IsEnabled="{Binding HasBackground}"
                            ToolTip="Quita la imagen o el video de fondo y deja la letra sola sobre el fondo del tema"/>
                    <Button Content="🎨 Temas" Margin="14,0,0,0"
                            Style="{StaticResource DarkButton}"
                            Command="{Binding OpenThemesCommand}"
                            ToolTip="Tipografía, colores, márgenes y fondos"/>

                    <!-- Escenario: la pantalla que miran los músicos -->
                    <Button Content="🎭 Escenario" Margin="14,0,0,0"
                            Command="{Binding ToggleStageCommand}"
                            ToolTip="Prende la pantalla de escenario para los músicos y quien predica, con el escenario elegido en el ▾">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStageVisible}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="▾" Padding="8,7" Margin="2,0,0,0"
                            Style="{StaticResource DarkButton}"
                            AutomationProperties.Name="Ajustes del escenario"
                            Click="StageOptions_Click"
                            ToolTip="Cambiar de escenario (cantantes, predicador…), editarlos y elegir en qué pantalla va"/>

                    <!-- Celular: control remoto por la red de la iglesia -->
                    <Button Content="📱" Padding="9,7" Margin="8,0,0,0"
                            AutomationProperties.Name="Controlar desde el celular"
                            Command="{Binding OpenRemoteCommand}"
                            ToolTip="Controlar la proyección desde el celular, por la red de la iglesia">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRemoteRunning}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Buscar en todo: canciones, versículos y medios -->
                    <Button Content="🔍" Padding="9,7" Margin="8,0,0,0"
                            Style="{StaticResource DarkButton}"
                            AutomationProperties.Name="Buscar en canciones, versículos y medios"
                            Command="{Binding SearchEverythingCommand}"
                            ToolTip="Buscar en canciones, versículos y medios a la vez (Ctrl+K)"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Salida:" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="220"
                              ItemsSource="{Binding Displays}"
                              SelectedItem="{Binding SelectedDisplay}"
                              DisplayMemberPath="Label"
                              VerticalAlignment="Center"
                              ToolTip="Monitor o proyector donde sale la imagen"/>
                    <Button Content="↻"
                            Style="{StaticResource DarkButton}"
                            AutomationProperties.Name="Actualizar pantallas"
                            Command="{Binding RefreshDisplaysCommand}"
                            ToolTip="Actualizar pantallas"
                            Padding="9,6" Margin="6,0,14,0"/>
                    <Button Command="{Binding ToggleOutputCommand}"
                            ToolTip="Prende o apaga la ventana de salida en la pantalla elegida.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Setter Property="Content" Value="🔴  Poner en vivo"/>
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProjecting}" Value="True">
                                        <Setter Property="Content" Value="Apagar salida"/>
                                        <Setter Property="controls:ShortcutHint.Text" Value="Esc"/>
                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ══ Zona central: biblioteca | slides | preview/live ══
             La barra de medios va abajo de las dos primeras columnas; la
             columna derecha (preview, live y texto rápido) baja entera. -->
        <Grid x:Name="MainArea" Grid.Row="2" Margin="10,10,10,0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ContentRow" Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition x:Name="MediaRow" Height="170" MinHeight="86"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="270" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="320" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo: biblioteca + playlist -->
            <Grid x:Name="LeftPanel" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="LibraryRow" Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition x:Name="PlaylistRow" Height="240" MinHeight="120"/>
                </Grid.RowDefinitions>
                <GridSplitter x:Name="PlaylistSplitter" Grid.Row="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Height="6" Background="Transparent"/>

                <Border x:Name="LibraryPanel" Grid.Row="0" Style="{StaticResource Panel}">
                    <DockPanel>
                        <!-- Selector de pestaña, y la flecha que achica el panel -->
                        <DockPanel DockPanel.Dock="Top" Margin="10,10,10,8">
                            <Button x:Name="LibraryCollapseButton" DockPanel.Dock="Right"
                                    Content="▾" FontSize="11" Padding="7,2"
                                    Style="{StaticResource FoldButton}"
                                    AutomationProperties.Name="Achicar o agrandar canciones y Biblia"
                                    Click="LibraryCollapse_Click"
                                    ToolTip="Achicar este panel para darle lugar a la playlist (o volver a agrandarlo)"/>
                            <Button DockPanel.Dock="Right" Content="⇤" FontSize="11" Padding="7,2"
                                    Style="{StaticResource FoldButton}"
                                    AutomationProperties.Name="Achicar canciones y playlist a una columna de íconos"
                                    Click="LeftRail_Enter_Click"
                                    ToolTip="Achicar canciones, Biblia y playlist a una columna de íconos, para darle lugar a las diapositivas"/>
                            <StackPanel Orientation="Horizontal">
                                <!-- El punto rojo dice que lo que está en pantalla viene de esa sección -->
                                <RadioButton Style="{StaticResource TabButton}"
                                             GroupName="LibraryTab"
                                             IsChecked="{Binding IsBibleTabActive, Converter={StaticResource InverseBool}}"
                                             Command="{Binding ShowSongsTabCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Canciones"/>
                                        <Ellipse Width="7" Height="7" Margin="6,0,0,0" VerticalAlignment="Center"
                                                 Fill="{StaticResource LiveBrush}" ToolTip="En vivo"
                                                 Visibility="{Binding IsSongsOnAir, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource TabButton}"
                                             GroupName="LibraryTab" Margin="4,0,0,0"
                                             IsChecked="{Binding IsBibleTabActive}"
                                             Command="{Binding ShowBibleTabCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Biblia"/>
                                        <Ellipse Width="7" Height="7" Margin="6,0,0,0" VerticalAlignment="Center"
                                                 Fill="{StaticResource LiveBrush}" ToolTip="En vivo"
                                                 Visibility="{Binding IsBibleOnAir, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </DockPanel>

                        <Grid x:Name="LibraryBody">
                            <!-- ── Pestaña Canciones ── -->
                            <DockPanel Visibility="{Binding IsBibleTabActive, Converter={StaticResource InverseBoolToVis}}">
                                <DockPanel DockPanel.Dock="Top">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,10,8">
                                        <Button Content="➕" FontSize="11" Padding="7,4"
                                                Style="{StaticResource DarkButton}"
                                                AutomationProperties.Name="Agregar canciones"
                                                Click="AddSongMenu_Click"
                                                ToolTip="Agregar canciones: crear una desde cero, buscarla en internet, traerlas de ProPresenter o importar archivos"/>
                                        <Button Content="✏️" FontSize="11" Padding="7,4" Margin="4,0,0,0"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding EditSongCommand}"
                                                AutomationProperties.Name="Editar canción"
                                                ToolTip="Editar canción"/>
                                        <Button Content="🗑" FontSize="11" Padding="7,4" Margin="4,0,0,0"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding DeleteSongCommand}"
                                                AutomationProperties.Name="Eliminar canción"
                                                ToolTip="Eliminar canción"/>
                                    </StackPanel>
                                    <TextBlock Text="CANCIONES" Style="{StaticResource PanelTitle}" Margin="12,0,12,0"
                                               Cursor="Hand" MouseLeftButtonUp="LibraryTitle_MouseLeftButtonUp"
                                               ToolTip="Clic: achicar este panel para darle lugar a la playlist"/>
                                </DockPanel>
                                <TextBox DockPanel.Dock="Top"
                                         Margin="12,0,12,8" Padding="8,6"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         CaretBrush="White"
                                         FontSize="13"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Buscar por título, artista o letra"/>
                                <ListBox x:Name="SongsList" ItemsSource="{Binding Songs}"
                                         PreviewMouseLeftButtonDown="SongsList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="SongsList_PreviewMouseMove"
                                         SelectedItem="{Binding SelectedSong}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ToolTip="Doble clic proyecta · arrastrala a la playlist · clic derecho: más opciones">
                                    <ListBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding ProjectFirstSlideCommand}"/>
                                    </ListBox.InputBindings>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,6"/>
                                            <!-- Sin un nombre explícito, un lector de pantalla lee el
                                                 nombre del tipo en vez del de la canción. -->
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Artist}"/>
                                            <Setter Property="Tag"
                                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                            <Setter Property="ContextMenu">
                                                <Setter.Value>
                                                    <ContextMenu>
                                                        <MenuItem Header="Editar canción (diseño)"
                                                                  Command="{Binding PlacementTarget.Tag.EditSongDesignForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="Editar como texto plano"
                                                                  Command="{Binding PlacementTarget.Tag.EditSongTextForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Agregar a la playlist"
                                                                  Command="{Binding PlacementTarget.Tag.AddSongToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Duplicar canción"
                                                                  Command="{Binding PlacementTarget.Tag.DuplicateSongCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Eliminar canción"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteSongForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="bd" Background="Transparent"
                                                                CornerRadius="4" Margin="6,1"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <!-- Sin artista, el renglón no ocupa lugar -->
                                                <TextBlock Text="{Binding Artist}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Artist}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Artist}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- ── Pestaña Biblia ── -->
                            <DockPanel Visibility="{Binding IsBibleTabActive, Converter={StaticResource BoolToVis}}">
                                <!-- Versiones: una fila de botones con la abreviatura. Clic = usar sólo
                                     esa; Ctrl+clic = sumar o sacar la segunda. El botón ▾ abre la lista
                                     con los nombres completos. -->
                                <DockPanel x:Name="VersionsHeader" DockPanel.Dock="Top" Margin="12,0,12,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="AddPassageButton" Content="➕ Playlist" FontSize="11" Padding="7,4" Margin="0,0,4,0"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding OpenAddPassageCommand}"
                                                AutomationProperties.Name="Agregar a la playlist"
                                                ToolTip="Abre una cajita para agregar un pasaje a la playlist: ya trae el tramo escrito en el buscador, o el versículo que está en pantalla, o el capítulo; se puede escribir otro («juan 8 del 5 al 10»). También: clic derecho sobre un versículo."/>
                                        <Button Content="📥" FontSize="11" Padding="7,4"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding ImportBibleCommand}"
                                                AutomationProperties.Name="Importar Biblia"
                                                ToolTip="Importar Biblia (JSON o Zefania XML). Una versión instalada se exporta con el clic derecho sobre ella."/>
                                    </StackPanel>
                                    <ToggleButton x:Name="VersionsExpander" DockPanel.Dock="Left"
                                                  IsChecked="{Binding IsBibleVersionsExpanded}"
                                                  Style="{StaticResource VersionsExpanderStyle}"
                                                  AutomationProperties.Name="Mostrar los nombres completos de las versiones"
                                                  ToolTip="Abrir la lista con los nombres completos de las versiones"/>
                                    <TextBlock Text="VERSIONES"
                                               ToolTip="Clic: usar sólo esa versión · Ctrl+clic: sumar o sacar la segunda · Clic derecho: editar, exportar o eliminar"
                                               FontSize="10" Foreground="{StaticResource FaintBrush}"
                                               Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- La cajita del ➕ Playlist: una cita, el texto del pasaje y Agregar -->
                                <Popup x:Name="AddPassagePopup"
                                       IsOpen="{Binding IsAddPassageOpen, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=VersionsHeader}"
                                       Placement="Bottom" VerticalOffset="2"
                                       StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       Opened="AddPassagePopup_Opened">
                                    <Border Width="300" Padding="12" Margin="0,0,8,8"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="6"
                                            KeyDown="AddPassagePopup_KeyDown">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="Agregar a la playlist" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="White"/>
                                            <TextBox x:Name="AddPassageBox" Margin="0,8,0,0" Padding="8,6"
                                                     Background="{StaticResource SurfaceAltBrush}"
                                                     Foreground="White" CaretBrush="White"
                                                     BorderBrush="{StaticResource LineBrush}"
                                                     FontSize="13"
                                                     Text="{Binding AddPassageText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Cita a agregar"
                                                     ToolTip="Por ejemplo: juan 8 del 5 al 10, sal 23, 1 co 13">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ConfirmAddPassageCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Text="{Binding AddPassageHeading}" Margin="0,8,0,0"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"/>
                                            <ScrollViewer MaxHeight="150" Margin="0,4,0,0"
                                                          VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding AddPassagePreview}" FontSize="12"
                                                           Foreground="White" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        Margin="0,10,0,0">
                                                <Button Content="Cancelar" Margin="0,0,6,0" Padding="10,5" FontSize="12"
                                                        Style="{StaticResource DarkButton}"
                                                        Click="AddPassageCancel_Click"/>
                                                <Button Content="Agregar" Padding="12,5" FontSize="12"
                                                        Style="{StaticResource AccentButton}"
                                                        IsEnabled="{Binding CanAddPassage}"
                                                        Command="{Binding ConfirmAddPassageCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Cerrada: sólo las abreviaturas -->
                                <ItemsControl x:Name="VersionsRow" DockPanel.Dock="Top"
                                              Margin="12,0,12,2"
                                              ItemsSource="{Binding BibleVersionOptions}"
                                              Tag="{Binding}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBibleVersionsExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource VersionChip}"
                                                    Margin="0,0,4,4"
                                                    Content="{Binding Info.Abbreviation}"
                                                    Command="{Binding Tag.ChooseVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    AutomationProperties.Name="{Binding Info.Name}"
                                                    ToolTip="{Binding Info.Name, StringFormat='{}{0}&#10;Clic: usar sólo esta · Ctrl+clic: sumarla como segunda versión'}"
                                                    ContextMenu="{StaticResource VersionMenu}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Que el Ctrl+clic no quede escondido en el globito -->
                                <TextBlock DockPanel.Dock="Top" Margin="12,0,12,6"
                                           Style="{StaticResource LearningHint}"
                                           Text="Ctrl+clic: sumar una segunda versión"
                                           FontSize="10" Foreground="{StaticResource FaintBrush}"/>

                                <!-- Abierta: una fila por versión, con el nombre completo -->
                                <Border DockPanel.Dock="Top" Margin="12,0,12,6"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="4" MaxHeight="130">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBibleVersionsExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="VersionsList"
                                                      ItemsSource="{Binding BibleVersionOptions}"
                                                      Tag="{Binding}" Margin="3">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource VersionRow}"
                                                            ToolTip="Clic: usar sólo esta · Ctrl+clic: sumarla como segunda versión"
                                                            Command="{Binding Tag.ChooseVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            AutomationProperties.Name="{Binding Info.Name}"
                                                            ContextMenu="{StaticResource VersionMenu}">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Info.Abbreviation}"
                                                                       FontSize="11" Margin="8,0,0,0"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Info.Name}" FontSize="12"
                                                                       Foreground="White"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- La caja de búsqueda y, a su derecha, el historial 🕘 de lo proyectado -->
                                <DockPanel x:Name="BibleQueryRow" DockPanel.Dock="Top" Margin="12,0,12,6">
                                <Button x:Name="BibleHistoryButton" DockPanel.Dock="Right"
                                        Content="🕘" FontSize="13" Padding="8,5" Margin="6,0,0,0"
                                        Style="{StaticResource DarkButton}"
                                        Click="BibleHistoryButton_Click"
                                        AutomationProperties.Name="Historial de versículos"
                                        ToolTip="Historial de los versículos que proyectaste: clic carga y marca el versículo, doble clic lo proyecta. También: flecha ↓ en la caja vacía."/>
                                <TextBox x:Name="BibleQueryBox"
                                         Padding="8,6"
                                         PreviewKeyDown="BibleQueryBox_PreviewKeyDown"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         CaretBrush="White"
                                         FontSize="13"
                                         Text="{Binding BibleQuery, UpdateSourceTrigger=PropertyChanged}"
                                         KeyUp="BibleQueryBox_KeyUp"
                                         PreviewMouseDown="BibleQueryBox_PreviewMouseDown"
                                         ToolTip="Escribí el libro y se filtra la lista («ju» → Jueces, Juan, Judas; Enter abre el primero). «juan 3» abre el capítulo, «juan 3 16» marca el versículo y Enter lo proyecta. Con ? adelante busca palabras en los versículos (?paz). Ctrl+K busca en canciones, Biblia y medios a la vez.">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ProjectReferenceCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                </DockPanel>

                                <!-- El historial: lo más reciente arriba -->
                                <Popup x:Name="BibleHistoryPopup"
                                       PlacementTarget="{Binding ElementName=BibleQueryRow}"
                                       Placement="Bottom" VerticalOffset="2"
                                       StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       Opened="BibleHistoryPopup_Opened"
                                       Closed="BibleHistoryPopup_Closed">
                                    <Border Width="300" Padding="8" Margin="0,0,8,8"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="6"
                                            KeyDown="BibleHistoryPopup_KeyDown">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
                                        </Border.Effect>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Versículos proyectados" Margin="4,0,0,6"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            <Button DockPanel.Dock="Bottom" Content="Borrar historial"
                                                    HorizontalAlignment="Right" Margin="0,8,0,0"
                                                    Padding="10,4" FontSize="11"
                                                    Style="{StaticResource DarkButton}"
                                                    Command="{Binding ClearBibleHistoryCommand}"/>
                                            <Grid>
                                                <ListBox x:Name="HistoryListBox"
                                                         ItemsSource="{Binding BibleHistory}"
                                                         MaxHeight="280"
                                                         Background="Transparent" BorderThickness="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         AutomationProperties.Name="Versículos proyectados"
                                                         PreviewMouseLeftButtonDown="HistoryListBox_PreviewMouseLeftButtonDown">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Padding" Value="8,5"/>
                                                            <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="bd" Background="Transparent"
                                                                                CornerRadius="4" Margin="0,1"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Display}" FontSize="13" Foreground="White"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="Todavía no proyectaste ningún versículo desde el buscador."
                                                           Margin="4,4,4,4" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{StaticResource FaintBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Items.Count, ElementName=HistoryListBox}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </Popup>
                                <TextBlock DockPanel.Dock="Bottom"
                                           Text="{Binding BibleStatusText}"
                                           FontSize="10" Foreground="{StaticResource FaintBrush}"
                                           TextWrapping="Wrap"
                                           Margin="12,4,12,10"/>

                                <Grid>
                                    <!-- Lista de libros, en orden bíblico -->
                                    <ListBox ItemsSource="{Binding BibleBooksAvailable}"
                                             SelectedItem="{Binding SelectedBibleBook}"
                                             Visibility="{Binding ShowBooksList, Converter={StaticResource BoolToVis}}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="10,4"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="bd" Background="Transparent"
                                                                    CornerRadius="4" Margin="6,0"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="White"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Capítulos del libro elegido, como grilla numérica -->
                                    <DockPanel Visibility="{Binding ShowChaptersView, Converter={StaticResource BoolToVis}}">
                                        <DockPanel DockPanel.Dock="Top" Margin="10,0,10,6">
                                            <Button DockPanel.Dock="Left" Content="◀ Libros"
                                                    Style="{StaticResource DarkButton}"
                                                    FontSize="11" Padding="8,4"
                                                    Command="{Binding BackToBooksCommand}"/>
                                            <TextBlock Text="{Binding ChaptersTitle}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="White"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ScrollViewer x:Name="ChaptersScroll" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="ChaptersGrid"
                                                          ItemsSource="{Binding BibleChapters}"
                                                          Margin="8,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Number}"
                                                                Width="40" Height="32" Margin="2"
                                                                Padding="0" FontSize="12"
                                                                Command="{Binding DataContext.SelectChapterCommand, ElementName=ChaptersGrid}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>

                                    <!-- Resultados de búsqueda por texto -->
                                    <ListBox x:Name="BibleResultsList"
                                         PreviewMouseLeftButtonDown="BibleResultsList_PreviewMouseLeftButtonDown"
                                         ItemsSource="{Binding BibleSearchResults}"
                                         Visibility="{Binding ShowBibleResults, Converter={StaticResource BoolToVis}}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ToolTip="Doble clic proyecta el versículo y carga el capítulo">
                                    <ListBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding ProjectBibleResultCommand}"
                                                    CommandParameter="{Binding SelectedItem, ElementName=BibleResultsList}"/>
                                    </ListBox.InputBindings>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Reference}"/>
                                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Text}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="bd" Background="Transparent"
                                                                CornerRadius="4" Margin="6,1"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Reference}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Text}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap" MaxHeight="32"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border x:Name="PlaylistPanel" Grid.Row="2" Style="{StaticResource Panel}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel x:Name="PlaylistTools" DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,8,10,4">
                                <Button Content="➕" FontSize="11" Padding="6,3"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding NewPlaylistCommand}"
                                        AutomationProperties.Name="Nueva playlist" ToolTip="Nueva playlist"/>
                                <Button Content="✏️" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding RenamePlaylistCommand}"
                                        AutomationProperties.Name="Renombrar playlist" ToolTip="Renombrar"/>
                                <Button Content="⧉" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding DuplicatePlaylistCommand}"
                                        AutomationProperties.Name="Duplicar playlist"
                                        ToolTip="Duplicar (ej. el domingo pasado)"/>
                                <Button Content="🗑" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding DeletePlaylistCommand}"
                                        AutomationProperties.Name="Eliminar playlist" ToolTip="Eliminar"/>
                            </StackPanel>
                            <!-- Clic en el título: achica la playlist a sólo esta línea -->
                            <TextBlock x:Name="PlaylistTitle" Text="▾  PLAYLIST" Style="{StaticResource PanelTitle}"
                                       Cursor="Hand" Background="Transparent"
                                       MouseLeftButtonUp="PlaylistTitle_MouseLeftButtonUp"
                                       ToolTip="Clic: achicar la playlist (o volver a agrandarla)"/>
                        </DockPanel>
                        <ComboBox x:Name="PlaylistPicker" DockPanel.Dock="Top" Margin="12,0,12,6"
                                  ItemsSource="{Binding Playlists}"
                                  SelectedItem="{Binding SelectedPlaylist}"
                                  DisplayMemberPath="Name" FontSize="12"
                                  ToolTip="Orden de la reunión: elegí la playlist que vas a usar hoy"/>
                        <Grid x:Name="PlaylistBody" AllowDrop="True" Background="Transparent"
                              DragOver="PlaylistBody_DragOver" DragLeave="PlaylistBody_DragLeave" Drop="PlaylistBody_Drop">
                            <TextBlock Text="Arrastrá canciones acá (o clic derecho), pasajes con «➕ Playlist»&#10;en Biblia y medios con clic derecho · doble clic proyecta.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlaylistItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox x:Name="PlaylistList"
                                     ItemsSource="{Binding PlaylistItems}"
                                     SelectedItem="{Binding SelectedPlaylistItem}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewKeyDown="PlaylistList_PreviewKeyDown"
                                     ToolTip="Clic: ver sin proyectar · doble clic: proyectar · Supr: quitar">
                                <ListBox.InputBindings>
                                    <KeyBinding Key="Enter"
                                                Command="{Binding ProjectPlaylistItemCommand}"
                                                CommandParameter="{Binding SelectedItem, ElementName=PlaylistList}"/>
                                </ListBox.InputBindings>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Caption}"/>
                                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PlaylistItem_PreviewMouseLeftButtonDown"/>
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="Subir"
                                                              Command="{Binding PlacementTarget.Tag.MovePlaylistItemUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Bajar"
                                                              Command="{Binding PlacementTarget.Tag.MovePlaylistItemDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Quitar de la playlist"
                                                              Command="{Binding PlacementTarget.Tag.RemovePlaylistItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                            Margin="6,1" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock x:Name="icon" Text="🎵" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="BiblePassage">
                                                <Setter TargetName="icon" Property="Text" Value="📖"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Media">
                                                <Setter TargetName="icon" Property="Text" Value="🎞"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Presentation">
                                                <Setter TargetName="icon" Property="Text" Value="📑"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- Dónde cae la canción que se está arrastrando -->
                            <Rectangle x:Name="PlaylistDropLine" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       VerticalAlignment="Top" Margin="10,0,10,0"
                                       Fill="{StaticResource AccentBrush}" IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- La misma celda que el panel izquierdo: cuando éste se achica a
                 íconos, queda esta columna. Cada botón saca el panel del riel
                 y abre lo suyo. -->
            <Border x:Name="LeftRail" Grid.Column="0" Style="{StaticResource Panel}"
                    Visibility="Collapsed">
                <StackPanel Margin="3,8,3,8">
                    <Button Content="🎵" FontSize="16" Width="36" Height="36" Padding="0"
                            Style="{StaticResource FoldButton}"
                            AutomationProperties.Name="Canciones"
                            Click="LeftRail_Songs_Click"
                            ToolTip="Canciones: sacar el panel del riel y ver la lista"/>
                    <Button Content="📖" FontSize="16" Width="36" Height="36" Padding="0" Margin="0,4,0,0"
                            Style="{StaticResource FoldButton}"
                            AutomationProperties.Name="Biblia"
                            Click="LeftRail_Bible_Click"
                            ToolTip="Biblia: sacar el panel del riel y buscar un versículo"/>
                    <Button Content="📋" FontSize="16" Width="36" Height="36" Padding="0" Margin="0,4,0,0"
                            Style="{StaticResource FoldButton}"
                            AutomationProperties.Name="Playlist"
                            Click="LeftRail_Playlist_Click"
                            ToolTip="Playlist: sacar el panel del riel y ver el orden de la reunión"/>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="6,8,6,8"/>
                    <Button Content="⇥" FontSize="12" Width="36" Height="28" Padding="0"
                            Style="{StaticResource FoldButton}"
                            AutomationProperties.Name="Volver a mostrar canciones y playlist"
                            Click="LeftRail_Exit_Click"
                            ToolTip="Volver a mostrar canciones, Biblia y playlist"/>
                </StackPanel>
            </Border>

            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Alto de la barra de medios, ajustable por el operador -->
            <GridSplitter x:Name="MediaSplitter" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Height="8" Background="Transparent"
                          ToolTip="Arrastrá para agrandar o achicar la barra de medios"/>

            <!-- Panel central: la grilla de diapositivas -->
            <Border x:Name="SlidesPanel" Grid.Column="2">
                <!-- Borde rojo mientras lo que está en pantalla es lo de esta grilla -->
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGridOnAir}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource LiveBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Qué hay en la grilla y, si es otra cosa, qué está en pantalla -->
                    <DockPanel Grid.Row="0" Margin="12,8,12,8" LastChildFill="False"
                               Visibility="{Binding HasGridTitle, Converter={StaticResource BoolToVis}}">
                        <!-- Sólo con una presentación en la grilla -->
                        <Button DockPanel.Dock="Right" Content="➕ Playlist" FontSize="11" Padding="8,3" Margin="10,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding AddPresentationToPlaylistCommand}"
                                Visibility="{Binding IsPresentationOpen, Converter={StaticResource BoolToVis}}"
                                ToolTip="Agregar la presentación entera a la playlist: las flechas pasan por sus páginas y siguen con lo que viene después"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding ShowOtherLive, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Lo que se está viendo en la pantalla ahora">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource LiveBrush}" Margin="0,0,6,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="En vivo: " FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding LiveTitle}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="White" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding GridTitle}"
                                   FontSize="15" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Left" Margin="10,0,0,0" Padding="6,1" CornerRadius="3"
                                Background="{StaticResource LiveBrush}" VerticalAlignment="Center"
                                Visibility="{Binding ShowGridLiveBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="EN VIVO" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="Elegí una canción o buscá un pasaje bíblico (ej. &quot;Juan 3:16&quot;)&#10;y sus diapositivas aparecen acá.&#10;&#10;Clic en una diapositiva la proyecta · doble clic en la lista arranca desde la primera&#10;· flechas ←→ navegan en vivo.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSlides}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasPreviewMedia}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer x:Name="SlidesScroll" VerticalScrollBarVisibility="Auto" Padding="6" Background="Transparent"
                                          AllowDrop="True" DragOver="SlidesScroll_DragOver"
                                          DragLeave="SlidesScroll_DragLeave" Drop="SlidesScroll_Drop"
                                          PreviewMouseWheel="SlidesScroll_PreviewMouseWheel">
                                <ItemsControl x:Name="SlideGrid" ItemsSource="{Binding Slides}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ProjectSlideCommand, ElementName=SlideGrid}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    Tag="{Binding DataContext, ElementName=SlideGrid}"
                                                    ContextMenuOpening="SlideCard_ContextMenuOpening"
                                                    PreviewMouseLeftButtonDown="SlideCard_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="SlideCard_PreviewMouseMove"
                                                    AutomationProperties.Name="{Binding Label}"
                                                    AutomationProperties.HelpText="{Binding PreviewText}"
                                                    ToolTip="{Binding CardToolTip}">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Editar canción (diseño)"
                                                                  Command="{Binding PlacementTarget.Tag.EditSongDesignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="Edición rápida (solo texto)"
                                                                  Command="{Binding PlacementTarget.Tag.QuickEditSlideCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="Editar como texto plano (canción)"
                                                                  Command="{Binding PlacementTarget.Tag.EditSongAsTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Copiar"
                                                                  Command="{Binding PlacementTarget.Tag.CopySlideCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="Pegar"
                                                                  Command="{Binding PlacementTarget.Tag.PasteSlideCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="Duplicar"
                                                                  Command="{Binding PlacementTarget.Tag.DuplicateSlideCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Eliminar"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteSlideCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="card" Margin="6"
                                                                Width="{Binding DataContext.SlideCardWidth, ElementName=SlideGrid}"
                                                                Height="{Binding DataContext.SlideCardHeight, ElementName=SlideGrid}"
                                                                CornerRadius="6" Background="#10141E"
                                                                BorderBrush="{StaticResource LineBrush}"
                                                                BorderThickness="1" Padding="10">
                                                            <Grid>
                                                                <!-- Todas las tarjetas del mismo tamaño: la letra
                                                                     se achica hasta que entra entera -->
                                                                <TextBlock x:Name="cardText" Text="{Binding PreviewText}"
                                                                           FontSize="{Binding DataContext.SlideCardFontSize, ElementName=SlideGrid}"
                                                                           Foreground="White"
                                                                           TextWrapping="Wrap"
                                                                           controls:TextFit.MaxFontSize="{Binding DataContext.SlideCardFontSize, ElementName=SlideGrid}"/>
                                                                <!-- Una página de presentación: la miniatura, no el texto -->
                                                                <TextBlock x:Name="pageIcon" Text="🎞" FontSize="28" Visibility="Collapsed"
                                                                           Foreground="{StaticResource MutedBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <Image x:Name="pageImage" Source="{Binding PageImage}" Stretch="Uniform"
                                                                       Visibility="Collapsed"/>
                                                                <!-- El rótulo va en la esquina, encima del texto,
                                                                     para no robarle un renglón arriba -->
                                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                        Margin="0,0,-6,-6" Padding="5,1"
                                                                        CornerRadius="4" Background="#E6262D3D">
                                                                    <TextBlock Text="{Binding Label}"
                                                                               FontSize="{Binding DataContext.SlideLabelFontSize, ElementName=SlideGrid}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource MutedBrush}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="card" Property="Background" Value="#1A2030"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsPage}" Value="True">
                                                                <Setter TargetName="cardText" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="pageIcon" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="pageImage" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="card" Property="Padding" Value="4"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPreviewed}" Value="True">
                                                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                            <!-- El último proyectado de esta grilla, aunque ya no esté en el aire:
                                                                 borde apagado; en el aire, rojo -->
                                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                                <Setter TargetName="card" Property="BorderBrush" Value="#7A4048"/>
                                                                <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOnAir}" Value="True">
                                                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource LiveBrush}"/>
                                                                <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Un medio de la playlist abierto con un clic: se ve acá y
                                 recién el doble clic (o el botón) lo pone en pantalla -->
                            <Grid Margin="24,16" Visibility="{Binding HasPreviewMedia, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border CornerRadius="6" Background="#10141E" ClipToBounds="True"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Image Source="{Binding PreviewMediaImage}" Stretch="Uniform"
                                               Visibility="{Binding HasPreviewMediaImage, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="🎞" FontSize="64" Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasPreviewMediaImage, Converter={StaticResource InverseBoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <TextBlock Text="Doble clic en la playlist o este botón lo pone en pantalla."
                                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="▶  Proyectar" Style="{StaticResource AccentButton}" Padding="16,7"
                                            Command="{Binding ProjectPreviewMediaCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Una página web en lugar de la grilla («🌐 Web» en la barra de
                         medios). Se crea al abrirla por primera vez; mientras está en
                         vivo y cerrada sigue ahí, invisible: ver SyncWebPanel. -->
                    <!-- Tamaño de las diapositivas: al pie de la grilla. Sólo cambia cómo se
                         ven las tarjetas; Ctrl + rueda del mouse hace lo mismo. -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="12,0,12,8">
                        <TextBlock Text="🔍" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider Width="110" Minimum="0.6" Maximum="1.8" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" Value="{Binding SlideCardScale}"
                                AutomationProperties.Name="Tamaño de las diapositivas"
                                ToolTip="Tamaño de las diapositivas. También: Ctrl + rueda del mouse sobre la grilla."/>
                    </StackPanel>
                    <controls:WebPanel x:Name="WebPanelView" Grid.RowSpan="3" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Panel derecho: live, preview y texto rápido (llega hasta abajo).
                 Lo que está en pantalla va primero: es lo que más se mira. -->
            <Grid x:Name="RightPanel" Grid.Column="4" Grid.RowSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*" MinHeight="130"/>
                </Grid.RowDefinitions>

                <Border x:Name="PreviewPanel" Grid.Row="2" Style="{StaticResource Panel}"
                        Visibility="{Binding ShowPreviewPanel, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OutputTabsTemplate}"
                                        Visibility="{Binding IsOutputMerged, Converter={StaticResource BoolToVis}}"/>
                        <!-- Qué muestra: la diapositiva que sigue, o la pantalla
                             de escenario tal como la ven los músicos -->
                        <DockPanel Visibility="{Binding IsOutputSplit, Converter={StaticResource BoolToVis}}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,6,10,4">
                                <RadioButton Content="Siguiente" Style="{StaticResource TabButton}"
                                             GroupName="PreviewMode" Padding="8,3" FontSize="11"
                                             IsChecked="{Binding PreviewShowsStage, Converter={StaticResource InverseBool}}"
                                             ToolTip="La diapositiva que va a salir después"/>
                                <RadioButton Content="Escenario" Style="{StaticResource TabButton}"
                                             GroupName="PreviewMode" Padding="8,3" FontSize="11" Margin="2,0,0,0"
                                             IsChecked="{Binding PreviewShowsStage}"
                                             ToolTip="Lo que ven los músicos y quien predica en la pantalla de escenario, aunque no esté prendida"/>
                            </StackPanel>
                            <TextBlock Text="PREVIEW" Style="{StaticResource PanelTitle}"/>
                        </DockPanel>
                        <!-- Los dos cuadros (este y el LIVE) llevan siempre la proporción de la
                             pantalla de salida: no se estiran con el panel -->
                        <controls:AspectFitBox Margin="12,0,12,12" AspectRatio="{Binding OutputAspectRatio}">
                        <Border Background="#0B0D12" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <!-- El próximo texto va sobre el fondo que va a quedar: un
                                     anuncio en primer plano sale al proyectar la diapositiva -->
                                <controls:ProjectedView Slide="{Binding PreviewSlide}"
                                                        FillMedia="{Binding Projection.PreviewBackgroundFill}"
                                                        BackgroundBlur="{Binding Projection.BackgroundBlur}"
                                                        Logo="{Binding Projection.ActiveLogo}"
                                                        Visibility="{Binding PreviewIsStage, Converter={StaticResource InverseBoolToVis}}">
                                    <!-- La página que sigue en una presentación va primero; si no hay, el
                                         fondo que va a quedar -->
                                    <controls:ProjectedView.BackgroundMedia>
                                        <MultiBinding Converter="{StaticResource FirstNonNull}">
                                            <Binding Path="PreviewPageMedia"/>
                                            <Binding Path="Projection.PreviewBackground"/>
                                        </MultiBinding>
                                    </controls:ProjectedView.BackgroundMedia>
                                </controls:ProjectedView>
                                <Viewbox Stretch="Uniform"
                                         Visibility="{Binding PreviewIsStage, Converter={StaticResource BoolToVis}}">
                                    <controls:StageView Width="1920" Height="1080"
                                                        DataContext="{Binding Projection}"
                                                        Layout="{Binding DataContext.ActiveStageLayout, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Viewbox>
                            </Grid>
                        </Border>
                        </controls:AspectFitBox>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoTransportTemplate}"
                                        Margin="12,-4,12,12"
                                        Visibility="{Binding ShowTransportInPreview, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="LivePanel" Grid.Row="0" Style="{StaticResource Panel}"
                        Visibility="{Binding ShowLivePanel, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Con los recuadros separados, el título; fusionados, las pestañas -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsOutputSplit, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="9" Height="9"
                                     Fill="{StaticResource LiveBrush}"
                                     VerticalAlignment="Center"
                                     Margin="12,1,0,0"/>
                            <TextBlock Text="LIVE · PROYECTADO" Style="{StaticResource PanelTitle}" Margin="7,10,12,8"/>
                        </StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OutputTabsTemplate}"
                                        Visibility="{Binding IsOutputMerged, Converter={StaticResource BoolToVis}}"/>
                        <controls:AspectFitBox Margin="12,0,12,12" AspectRatio="{Binding OutputAspectRatio}">
                        <Border Background="#0B0D12" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProjecting}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource LiveBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <controls:ProjectedView x:Name="LiveView"
                                                    Slide="{Binding Projection.Slide}"
                                                    Cursor="IBeam"
                                                    PreviewMouseLeftButtonDown="LiveView_PreviewMouseLeftButtonDown"
                                                    PreviewMouseLeftButtonUp="LiveView_PreviewMouseLeftButtonUp"
                                                    PreviewMouseMove="LiveView_PreviewMouseMove"
                                                    ToolTip="Clic en una palabra: se resalta esa en la pantalla · Arrastrá sobre varias: se resalta la frase · Shift: suma otra marca sin sacar las anteriores · Clic otra vez sobre lo resaltado: se quita"
                                                    State="{Binding Projection.State}"
                                                    Overlay="{Binding Projection.Overlay}"
                                                    OverlayFontFamily="{Binding Projection.OverlayFontFamily}"
                                                    OverlayFontSize="{Binding Projection.OverlayFontSize}"
                                                    Countdown="{Binding Projection.Countdown}"
                                                    Highlight="{Binding Projection.Highlight}"
                                                    BackgroundMedia="{Binding Projection.Background}"
                                                    FillMedia="{Binding Projection.BackgroundFill}"
                                                    BackgroundBlur="{Binding Projection.BackgroundBlur}"
                                                    LiveVideoFrame="{Binding Projection.LiveFrame}"
                                                    Logo="{Binding Projection.ActiveLogo}"/>
                        </Border>
                        </controls:AspectFitBox>

                        <!-- Transporte del video que está en pantalla, pegado a
                             lo que muestra: sólo con video (archivo o YouTube) -->
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoTransportTemplate}"
                                        Margin="12,-4,12,12"
                                        Visibility="{Binding HasVideoPlayback, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Las tres formas de escribir sobre lo proyectado, en pestañas -->
                <Border x:Name="ToolsPanel" Grid.Row="4" Style="{StaticResource Panel}">
                    <DockPanel>
                        <!-- Achicadas, las pestañas quedan en su ícono (el código cambia
                             el contenido) y un clic en cualquiera la vuelve a abrir -->
                        <DockPanel DockPanel.Dock="Top" Margin="10,10,10,8">
                            <Button x:Name="ToolsCollapseButton" DockPanel.Dock="Right" VerticalAlignment="Top"
                                    Content="▾" FontSize="11" Padding="7,5"
                                    Style="{StaticResource FoldButton}"
                                    AutomationProperties.Name="Achicar o agrandar las herramientas de texto"
                                    Click="ToolsCollapse_Click"
                                    ToolTip="Achicar las herramientas de texto a una tira de íconos (o volver a agrandarlas)"/>
                        <WrapPanel x:Name="ToolsTabs" Orientation="Horizontal" ButtonBase.Click="ToolsTab_Click">
                            <RadioButton x:Name="TabQuick" Content="Texto rápido"
                                         Style="{StaticResource TabButton}" GroupName="WriteTab"
                                         IsChecked="True"
                                         AutomationProperties.Name="Texto rápido"
                                         ToolTip="Un anuncio a pantalla completa, con el tema de las canciones"/>
                            <RadioButton x:Name="TabOverlay" Content="Aviso al pie"
                                         Style="{StaticResource TabButton}" GroupName="WriteTab" Margin="4,0,0,0"
                                         AutomationProperties.Name="Aviso al pie"
                                         ToolTip="Una franja al pie de la pantalla, encima de todo lo demás"/>
                            <RadioButton x:Name="TabHighlight" Content="Resaltar"
                                         Style="{StaticResource TabButton}" GroupName="WriteTab" Margin="4,0,0,0"
                                         AutomationProperties.Name="Resaltar"
                                         ToolTip="Pinta una palabra como con marcador sobre lo que está proyectado"/>
                            <RadioButton x:Name="TabNotes" Content="Notas"
                                         Style="{StaticResource TabButton}" GroupName="WriteTab" Margin="4,0,0,0"
                                         AutomationProperties.Name="Notas"
                                         ToolTip="Notas para quien predica: se ven sólo en la pantalla de escenario"/>
                            <RadioButton x:Name="TabMusic" Content="Música"
                                         Style="{StaticResource TabButton}" GroupName="WriteTab" Margin="4,0,0,0"
                                         AutomationProperties.Name="Música"
                                         ToolTip="Pasar, pausar y bajar o subir la música del Spotify (o el reproductor) que esté abierto en esta computadora"/>
                            <RadioButton x:Name="TabTimes" Content="Tiempos"
                                         Style="{StaticResource TabButton}" GroupName="WriteTab" Margin="4,0,0,0"
                                         AutomationProperties.Name="Tiempos"
                                         ToolTip="Cuánto dura cada parte de la reunión (alabanza, anuncios, prédica) y un cronómetro; el escenario muestra lo que queda"/>
                        </WrapPanel>
                        </DockPanel>

                        <Grid x:Name="ToolsBody">
                            <!-- ── Texto rápido ── -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=TabQuick, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Bottom"
                                        Content="Proyectar ▶" controls:ShortcutHint.Text="Ctrl+Enter"
                                        Style="{StaticResource AccentButton}"
                                        Command="{Binding GoLiveCommand}"
                                        Margin="12,8,12,12" Padding="10,8"
                                        ToolTip="Manda lo escrito a la pantalla, con el tema de las canciones"/>
                                <StackPanel DockPanel.Dock="Top" Margin="12,0,12,10">
                                    <TextBlock Text="Tipografía" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox IsEditable="True" FontSize="12"
                                              ItemsSource="{Binding SystemFonts}"
                                              Text="{Binding QuickTextFont, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Letra del texto rápido. Vacía: la del tema de las canciones."/>
                                </StackPanel>
                                <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         CaretBrush="White"
                                         Margin="12,0,12,0"
                                         Padding="8,6" FontSize="14"
                                         services:SpellChecking.Enabled="True"
                                         ToolTip="Escribí un aviso y proyectalo al instante · Enter hace un renglón nuevo, Ctrl+Enter proyecta">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding GoLiveCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>

                            <!-- ── Aviso al pie ── -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=TabOverlay, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource LearningHint}"
                                           Text="Aparece en una franja abajo, por encima de todo — incluso con Black puesto."
                                           FontSize="11" Foreground="{StaticResource FaintBrush}"
                                           TextWrapping="Wrap" Margin="12,0,12,8"/>
                                <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tipografía" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox IsEditable="True" FontSize="12"
                                                  ItemsSource="{Binding SystemFonts}"
                                                  Text="{Binding OverlayFont, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Letra del aviso. Vacía: Segoe UI."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Tamaño" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" Margin="0,0,0,4"/>
                                        <controls:NumericField Minimum="20" Maximum="160" Step="2"
                                                               Value="{Binding OverlayFontSize}"
                                                               ToolTip="Tamaño de la letra del aviso, de 20 a 160. El de siempre es 54."/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8,12,12">
                                    <Button Content="Mostrar" Command="{Binding ShowOverlayCommand}" Padding="16,8"
                                            ToolTip="Pone la franja en pantalla">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverlayActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Quitar" Style="{StaticResource DarkButton}" Padding="16,8" Margin="6,0,0,0"
                                            Command="{Binding HideOverlayCommand}"
                                            ToolTip="Saca la franja del aviso"/>
                                </StackPanel>
                                <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding OverlayText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         CaretBrush="White"
                                         Margin="12,0,12,0"
                                         Padding="8,6" FontSize="14"
                                         services:SpellChecking.Enabled="True"
                                         ToolTip="Ej: «el auto ABC 123 está con las luces prendidas»">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ShowOverlayCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>

                            <!-- ── Resaltar en vivo ── -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=TabHighlight, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource LearningHint}"
                                           Text="Escribí una o varias palabras o frases separadas por ; («gracia; fe») y se pintan al instante en todas las veces que aparecen. También podés marcar con el mouse sobre el LIVE: ahí se resalta sólo esa vez, y con Shift se suman más."
                                           FontSize="11" Foreground="{StaticResource FaintBrush}"
                                           TextWrapping="Wrap" Margin="12,0,12,8"/>
                                <TextBox DockPanel.Dock="Top"
                                         Text="{Binding HighlightText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         CaretBrush="White"
                                         Margin="12,0,12,0"
                                         Padding="8,6" FontSize="14"
                                         VerticalContentAlignment="Center"/>
                                <Button DockPanel.Dock="Top" Content="Quitar el resaltado"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding ClearHighlightCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="12,10,12,0" Padding="14,7"
                                        ToolTip="Saca todo el resaltado amarillo del texto proyectado, el escrito acá y el marcado en el LIVE"/>
                                <Grid/>
                            </DockPanel>

                            <!-- ── Música: la lista de audios propia y, abajo, las teclas multimedia de Windows ── -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsChecked, ElementName=TabMusic, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0,12,10">
                                    <!-- Título y botones de la lista -->
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="➕" FontSize="11" Padding="7,3" Style="{StaticResource DarkButton}"
                                                    Command="{Binding ImportAudioCommand}"
                                                    AutomationProperties.Name="Agregar audios"
                                                    ToolTip="Agregar audios (mp3, wav, m4a, ogg o flac). También se pueden arrastrar desde el Explorador."/>
                                            <Button Content="↑" FontSize="11" Padding="8,3" Margin="4,0,0,0" Style="{StaticResource DarkButton}"
                                                    Command="{Binding MoveAudioUpCommand}"
                                                    AutomationProperties.Name="Subir el audio elegido"
                                                    ToolTip="Subir el audio elegido en la lista"/>
                                            <Button Content="↓" FontSize="11" Padding="8,3" Margin="4,0,0,0" Style="{StaticResource DarkButton}"
                                                    Command="{Binding MoveAudioDownCommand}"
                                                    AutomationProperties.Name="Bajar el audio elegido"
                                                    ToolTip="Bajar el audio elegido en la lista"/>
                                            <Button Content="A–Z" FontSize="11" Padding="7,3" Margin="4,0,0,0" Style="{StaticResource DarkButton}"
                                                    Command="{Binding SortAudioByNameCommand}"
                                                    ToolTip="Ordenar toda la lista por nombre"/>
                                            <Button Content="🗑" FontSize="11" Padding="7,3" Margin="4,0,0,0" Style="{StaticResource DarkButton}"
                                                    Command="{Binding RemoveAudioCommand}"
                                                    AutomationProperties.Name="Quitar el audio elegido"
                                                    ToolTip="Quitar el audio elegido de la lista (el archivo no se borra)"/>
                                        </StackPanel>
                                        <TextBlock Text="AUDIOS" Style="{StaticResource PanelTitle}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- La lista: doble clic o Enter reproduce, Supr quita -->
                                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="4" MinHeight="110" MaxHeight="210">
                                        <Grid>
                                            <ListBox x:Name="AudioList" ItemsSource="{Binding AudioTracks}"
                                                     SelectedItem="{Binding SelectedAudio}"
                                                     Background="Transparent" BorderThickness="0" Padding="2"
                                                     MaxHeight="206"
                                                     AllowDrop="True"
                                                     PreviewMouseLeftButtonDown="AudioList_PreviewMouseLeftButtonDown"
                                                     PreviewKeyDown="AudioList_PreviewKeyDown"
                                                     DragOver="AudioList_DragOver" Drop="AudioList_Drop"
                                                     AutomationProperties.Name="Lista de audios"
                                                     ToolTip="Doble clic o Enter: reproducir · Supr: quitar de la lista">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="bd" CornerRadius="3" Padding="6,5" Margin="0,1"
                                                                            Background="Transparent">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel>
                                                            <!-- El que está cargado en el reproductor -->
                                                            <TextBlock DockPanel.Dock="Left" Text="▶" FontSize="10" Width="16"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource AccentSoftBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <!-- Lista vacía: dice qué hacer -->
                                            <TextBlock Text="Arrastrá acá tus audios (mp3, wav, m4a, ogg, flac) o tocá ➕"
                                                       IsHitTestVisible="False"
                                                       Style="{StaticResource PlaceholderText}"
                                                       Visibility="{Binding HasAudios, Converter={StaticResource InverseBoolToVis}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- El reproductor -->
                                    <TextBlock Text="{Binding AudioNowPlayingText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AudioTimeText}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                        <Slider Minimum="0" Maximum="{Binding AudioDurationSeconds}"
                                                Value="{Binding AudioPositionSeconds}"
                                                IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                                AutomationProperties.Name="Posición del audio"
                                                ToolTip="Arrastrá para moverte dentro del audio"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,6,0,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                    ToolTip="Volumen de los audios: no cambia el del video ni el de Windows">
                                            <TextBlock Text="🔈" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <Slider Minimum="0" Maximum="100" Width="76" VerticalAlignment="Center"
                                                    Value="{Binding AudioVolume}" IsMoveToPointEnabled="True"
                                                    AutomationProperties.Name="Volumen de los audios"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="⏮" FontSize="12" Padding="8,4" Style="{StaticResource DarkButton}"
                                                    Command="{Binding PreviousAudioCommand}"
                                                    AutomationProperties.Name="Audio anterior"
                                                    ToolTip="Audio anterior (si ya pasaron unos segundos, vuelve al principio de éste)"/>
                                            <Button Content="⏪" FontSize="12" Padding="7,4" Margin="3,0,0,0" Style="{StaticResource DarkButton}"
                                                    Command="{Binding SkipAudioBackCommand}"
                                                    AutomationProperties.Name="Atrasar 10 segundos"
                                                    ToolTip="Atrasar 10 segundos"/>
                                            <Button FontSize="12" Padding="11,4" Margin="3,0,0,0"
                                                    Command="{Binding ToggleAudioPlayPauseCommand}"
                                                    AutomationProperties.Name="Reproducir o pausar el audio"
                                                    ToolTip="Reproducir o pausar">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                                        <Setter Property="Content" Value="▶"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAudioPlaying}" Value="True">
                                                                <Setter Property="Content" Value="⏸"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="⏩" FontSize="12" Padding="7,4" Margin="3,0,0,0" Style="{StaticResource DarkButton}"
                                                    Command="{Binding SkipAudioForwardCommand}"
                                                    AutomationProperties.Name="Adelantar 10 segundos"
                                                    ToolTip="Adelantar 10 segundos"/>
                                            <Button Content="⏭" FontSize="12" Padding="8,4" Margin="3,0,0,0" Style="{StaticResource DarkButton}"
                                                    Command="{Binding NextAudioCommand}"
                                                    AutomationProperties.Name="Audio siguiente"
                                                    ToolTip="Audio siguiente"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Otro reproductor (Spotify…): las teclas multimedia de Windows -->
                                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,14,0,0"/>
                                    <TextBlock Text="SPOTIFY U OTRO REPRODUCTOR" Style="{StaticResource PanelTitle}" Margin="0,10,0,6"/>
                                    <controls:SystemMediaPlayer/>
                                    <UniformGrid Columns="3" Margin="0,8,0,0">
                                        <Button Content="🔉" FontSize="14" Padding="0,7" Margin="0,0,3,0" Style="{StaticResource DarkButton}"
                                                Tag="VolumeDown" Click="MusicKey_Click"
                                                AutomationProperties.Name="Bajar el volumen" ToolTip="Bajar el volumen"/>
                                        <Button Content="🔊" FontSize="14" Padding="0,7" Margin="3,0" Style="{StaticResource DarkButton}"
                                                Tag="VolumeUp" Click="MusicKey_Click"
                                                AutomationProperties.Name="Subir el volumen" ToolTip="Subir el volumen"/>
                                        <Button Content="🔇" FontSize="14" Padding="0,7" Margin="3,0,0,0" Style="{StaticResource DarkButton}"
                                                Tag="Mute" Click="MusicKey_Click"
                                                AutomationProperties.Name="Silenciar" ToolTip="Silenciar o volver a oír"/>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource LearningHint}"
                                               Text="Muestra y maneja lo que suene en esta computadora (Spotify o el reproductor que esté abierto). El volumen es el de toda la computadora, el mismo que sale por el proyector."
                                               FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ── Tiempos: secciones de la reunión y cronómetro ── -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsChecked, ElementName=TabTimes, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="12,0,12,10">
                                    <!-- La sección en marcha -->
                                    <TextBlock Text="{Binding CurrentSectionName}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SectionClockText}" FontSize="40" FontWeight="SemiBold"
                                               AutomationProperties.Name="Tiempo que queda de la sección">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSectionOvertime}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF5A5A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Padding="12,6" Margin="0,0,4,4" MinWidth="86"
                                                Command="{Binding ToggleSectionTimerCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                                    <Setter Property="Content" Value="▶ Iniciar"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSectionRunning}" Value="True">
                                                            <Setter Property="Content" Value="⏸ Pausar"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="⟲" Padding="10,6" Margin="0,0,4,4"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding ResetSectionTimerCommand}"
                                                AutomationProperties.Name="Volver a cero"
                                                ToolTip="Volver al tiempo completo de la sección, detenido"/>
                                        <Button Content="−1 min" Padding="9,6" Margin="0,0,4,4"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding TakeMinuteFromSectionCommand}"
                                                ToolTip="Quitar un minuto a lo que queda"/>
                                        <Button Content="+1 min" Padding="9,6" Margin="0,0,4,4"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding AddMinuteToSectionCommand}"
                                                ToolTip="Darle un minuto más"/>
                                        <Button Content="Siguiente ⏭" Padding="9,6" Margin="0,0,0,4"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding NextSectionTimerCommand}"
                                                ToolTip="Pasar a la sección que sigue (si estaba corriendo, sigue corriendo)"/>
                                    </WrapPanel>

                                    <!-- La lista de secciones, editable -->
                                    <TextBlock Text="SECCIONES DE LA REUNIÓN" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource FaintBrush}" Margin="0,12,0,4"
                                               ToolTip="Tocá el círculo para elegir con cuál se trabaja. Cambiá el nombre o los minutos escribiendo."/>
                                    <ItemsControl x:Name="SectionsList" ItemsSource="{Binding MeetingSections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                                    <RadioButton DockPanel.Dock="Left" GroupName="CurrentSection"
                                                                 IsChecked="{Binding IsCurrent, Mode=TwoWay}"
                                                                 VerticalAlignment="Center" Margin="0,0,8,0"
                                                                 AutomationProperties.Name="Usar esta sección"
                                                                 ToolTip="Trabajar con esta sección"/>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0">
                                                        <Button Content="▲" FontSize="9" Padding="5,3" Style="{StaticResource DarkButton}"
                                                                Command="{Binding DataContext.MoveSectionUpCommand, ElementName=SectionsList}"
                                                                CommandParameter="{Binding}" ToolTip="Subir"/>
                                                        <Button Content="▼" FontSize="9" Padding="5,3" Margin="2,0,0,0" Style="{StaticResource DarkButton}"
                                                                Command="{Binding DataContext.MoveSectionDownCommand, ElementName=SectionsList}"
                                                                CommandParameter="{Binding}" ToolTip="Bajar"/>
                                                        <Button Content="✕" FontSize="10" Padding="6,3" Margin="2,0,0,0" Style="{StaticResource DarkButton}"
                                                                Command="{Binding DataContext.RemoveSectionCommand, ElementName=SectionsList}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="Quitar la sección" ToolTip="Quitar la sección"/>
                                                    </StackPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0">
                                                        <TextBox Text="{Binding Minutes, UpdateSourceTrigger=LostFocus, StringFormat='0'}"
                                                                 Width="40" HorizontalContentAlignment="Center"
                                                                 Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                                                                 BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                                                                 Padding="2,4" FontSize="12" VerticalContentAlignment="Center"
                                                                 AutomationProperties.Name="Minutos de la sección"
                                                                 ToolTip="Minutos de esta sección"/>
                                                        <TextBlock Text="min" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                   Foreground="{StaticResource MutedBrush}"/>
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                             Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                                                             BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                                                             Padding="6,4" FontSize="12" VerticalContentAlignment="Center"
                                                             AutomationProperties.Name="Nombre de la sección"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="＋ Sección" Style="{StaticResource DarkButton}"
                                            HorizontalAlignment="Left" FontSize="11" Padding="10,4" Margin="0,2,0,0"
                                            Command="{Binding AddSectionCommand}"/>

                                    <!-- El cronómetro del servicio -->
                                    <TextBlock Text="CRONÓMETRO" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource FaintBrush}" Margin="0,14,0,2"
                                               ToolTip="Cuánto lleva el servicio. Es el mismo que muestra el recuadro «Cronómetro» del escenario."/>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Padding="10,5" MinWidth="82" Margin="0,0,4,0"
                                                    Command="{Binding ToggleStopwatchCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                        <Setter Property="Content" Value="▶ Iniciar"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStopwatchRunning}" Value="True">
                                                                <Setter Property="Content" Value="⏸ Pausar"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="⟲" Padding="10,5" Style="{StaticResource DarkButton}"
                                                    Command="{Binding ResetStopwatchCommand}"
                                                    AutomationProperties.Name="Poner el cronómetro en cero"
                                                    ToolTip="Poner el cronómetro en cero (queda detenido)"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StopwatchText}" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ── Notas para la plataforma ── -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=TabNotes, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource LearningHint}"
                                           Text="Sólo se ven en la pantalla de escenario: el guion del predicador, un aviso para la banda. La congregación nunca las ve."
                                           FontSize="11" Foreground="{StaticResource FaintBrush}"
                                           TextWrapping="Wrap" Margin="12,0,12,8"/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8,12,12">
                                    <Button Content="Mostrar" Command="{Binding ShowStageNotesCommand}" Padding="16,8"
                                            ToolTip="Manda las notas a la pantalla de escenario">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStageNotesActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Quitar" Style="{StaticResource DarkButton}" Padding="16,8" Margin="6,0,0,0"
                                            Command="{Binding HideStageNotesCommand}"
                                            ToolTip="Saca las notas del escenario"/>
                                </StackPanel>
                                <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding StageNotesText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         CaretBrush="White"
                                         Margin="12,0,12,0"
                                         Padding="8,6" FontSize="14"
                                         services:SpellChecking.Enabled="True"
                                         ToolTip="Ej: los puntos del mensaje, o «cantamos el coro dos veces»">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ShowStageNotesCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ══ Barra de medios ══ -->
            <Border x:Name="MediaPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    PreviewKeyDown="MediaPanel_PreviewKeyDown"
                    AllowDrop="True" DragEnter="MediaPanel_DragOver" DragOver="MediaPanel_DragOver"
                    DragLeave="MediaPanel_DragLeave" Drop="MediaPanel_Drop">
                <!-- Borde rojo mientras lo que está en pantalla es un medio de la barra -->
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMediaOnAir}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource LiveBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,10,2">
                        <Button Content="📥 Agregar" FontSize="11" Padding="8,4"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding ImportMediaCommand}"
                                ToolTip="Agregar imágenes o videos a la pestaña actual"/>
                        <Button Content="▶ YouTube" FontSize="11" Padding="8,4" Margin="6,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding OpenYouTubeCommand}"
                                ToolTip="Buscar en YouTube e iniciar sesión con tu cuenta (Premium: sin anuncios)"/>
                        <Button Content="🌐 Web" FontSize="11" Padding="8,4" Margin="6,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding OpenWebCommand}"
                                ToolTip="Abrir una página web en el cuadro central y proyectarla: como foto o en vivo"/>
                        <Button Content="🖥 Ventana" FontSize="11" Padding="8,4" Margin="6,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding OpenWindowPickerCommand}"
                                ToolTip="Proyectar otra ventana de esta computadora (un PowerPoint, un reproductor, un navegador) en vivo, tal como se ve"/>
                        <Button Content="🔗" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding AddYouTubeLinkCommand}"
                                ToolTip="Agregar un video de YouTube pegando el link"/>
                        <Button Content="🎲" FontSize="12" Padding="8,4" Margin="6,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding RandomBackgroundCommand}"
                                ToolTip="Poner un fondo al azar de esta pestaña. No repite ninguno hasta haberlos usado a todos."/>
                    </StackPanel>
                    <!-- Clic en el título: achica la barra a sólo esta línea -->
                    <TextBlock x:Name="MediaTitle" Text="▾  MEDIOS" Style="{StaticResource PanelTitle}"
                               Margin="12,8,6,4" VerticalAlignment="Center"
                               Cursor="Hand" Background="Transparent"
                               MouseLeftButtonUp="MediaTitle_MouseLeftButtonUp"
                               ToolTip="Clic: achicar la barra de medios a esta línea (o volver a agrandarla)"/>
                    <!-- Nueva pestaña: junto al título, para que la lista de pestañas
                         use todo el alto de la barra -->
                    <Button x:Name="MediaNewTabButton" Content="＋" FontSize="12" Padding="7,2"
                            Style="{StaticResource DarkButton}"
                            Command="{Binding NewMediaTabCommand}"
                            AutomationProperties.Name="Nueva pestaña de medios"
                            ToolTip="Nueva pestaña (categoría)"/>
                    <CheckBox x:Name="MediaContinuousCheck" Content="▶▶ continua" FontSize="11" Foreground="{StaticResource MutedBrush}"
                              VerticalAlignment="Center" Margin="12,0,0,0"
                              IsChecked="{Binding ContinuousPlayback}"
                              ToolTip="En esta pestaña, al terminar un video arranca el siguiente, y al final vuelve al primero. Sirve para dejar un bucle de avisos antes de la reunión."/>
                    <CheckBox x:Name="MediaRandomCheck" Content="🎲 al azar por canción" FontSize="11" Foreground="{StaticResource MutedBrush}"
                              VerticalAlignment="Center" Margin="10,0,0,0"
                              IsChecked="{Binding RandomBackgroundPerSong}"
                              ToolTip="Cada canción que proyectás se lleva un fondo distinto de esta pestaña, sin repetir hasta usarlos todos. Si elegís un fondo a mano, se respeta: el sorteo sólo elige cuando no hay fondo o cuando el que está salió sorteado."/>
                </DockPanel>

                <!-- Todo lo que está debajo de la cabecera: achicada la barra, sólo queda ésta -->
                <DockPanel x:Name="MediaBody">
                <!-- ── Controles del fondo que está en pantalla ── -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                        Padding="12,6,12,8"
                        Visibility="{Binding HasBackground, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <!-- Desenfoque: sirve para imágenes y para videos -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="14,0,0,0">
                            <TextBlock Text="Desenfoque" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
                            <controls:NumericField Minimum="0" Maximum="100" Step="5" Decimals="0"
                                                   Value="{Binding BackgroundBlur}"
                                                   ToolTip="Difumina el fondo en vivo para que la letra se lea. 0 = nítido."/>
                            <Button Content="✕" FontSize="11" Padding="7,3" Margin="4,0,0,0"
                                    Style="{StaticResource DarkButton}"
                                    Command="{Binding ClearBlurCommand}"
                                    ToolTip="Volver el fondo nítido"/>
                        </StackPanel>

                        <TextBlock Text="FONDO EN PANTALLA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- ── Pestañas por categoría, apiladas a la izquierda ──
                     Una lista en vez de una fila: entran más nombres, y se
                     lee cuál está elegida de un vistazo. -->
                <DockPanel DockPanel.Dock="Left" Width="118" Margin="10,2,0,6">
                    <!-- Tamaño de los medios: abajo de las pestañas (Ctrl + rueda también) -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="🔍" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Width="92" Minimum="0.7" Maximum="2.5" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" Value="{Binding MediaCardScale}"
                                AutomationProperties.Name="Tamaño de los medios"
                                ToolTip="Tamaño de las tarjetas de medios. También: Ctrl + rueda del mouse sobre la barra."/>
                    </StackPanel>
                    <ListBox x:Name="MediaTabsList" ItemsSource="{Binding MediaTabs}" SelectedItem="{Binding SelectedMediaTab}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <!-- Un medio arrastrado desde la barra se suelta sobre una pestaña
                                     para mudarlo a ella; Tag = "drop" la resalta mientras pasa -->
                                <Setter Property="AllowDrop" Value="True"/>
                                <EventSetter Event="DragOver" Handler="MediaTab_DragOver"/>
                                <EventSetter Event="DragLeave" Handler="MediaTab_DragLeave"/>
                                <EventSetter Event="Drop" Handler="MediaTab_Drop"/>
                                <!-- El menú de clic derecho se arma en el código: los Click
                                     dentro de un estilo rompen la carga de la ventana. -->
                                <EventSetter Event="Loaded" Handler="MediaTab_Loaded"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="4" Margin="0,1" Padding="10,5" Background="Transparent"
                                                    BorderBrush="Transparent" BorderThickness="1">
                                                <DockPanel>
                                                    <!-- Pestaña silenciada: sus medios se proyectan sin sonido -->
                                                    <TextBlock x:Name="muteIcon" DockPanel.Dock="Right" Text="🔇" FontSize="11"
                                                               Margin="4,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               ToolTip="Esta pestaña está silenciada">
                                                        <TextBlock.Visibility>
                                                            <MultiBinding Converter="{StaticResource TabMutedToVis}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.MutedMediaTabs"
                                                                         RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Visibility>
                                                    </TextBlock>
                                                    <TextBlock x:Name="label" Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                    <Setter TargetName="label" Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="Tag" Value="drop">
                                                    <Setter TargetName="bd" Property="Background" Value="#442F63C9"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="label" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>

                <Grid>
                    <TextBlock Margin="16,0,16,8"
                               Text="Agregá imágenes o videos con 📥 y aplicalos con un clic.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MediaItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Fondo transparente: así el espacio vacío recibe el clic y se puede
                         arrastrar un rectángulo para elegir varias tarjetas -->
                    <ScrollViewer x:Name="MediaScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
                                  PreviewMouseLeftButtonDown="MediaScroll_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="MediaScroll_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="MediaScroll_PreviewMouseLeftButtonUp"
                                  LostMouseCapture="MediaScroll_LostMouseCapture"
                                  PreviewMouseWheel="MediaScroll_PreviewMouseWheel">
                        <ItemsControl x:Name="MediaCards" ItemsSource="{Binding MediaItems}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Un clic proyecta y deja elegida sólo esta tarjeta; con Ctrl o Mayús
                                         el clic suma a la selección y no proyecta (MediaCard_Click).
                                         Un solo menú compartido por todas: uno por tarjeta eran
                                         cientos de objetos en una pestaña grande. -->
                                    <Button Click="MediaCard_Click"
                                            Cursor="Hand" Margin="6,2"
                                            Tag="{Binding DataContext, ElementName=MediaScroll}"
                                            AutomationProperties.Name="{Binding Name}"
                                            ContextMenu="{StaticResource MediaCardMenu}"
                                            Loaded="MediaCard_Loaded"
                                            PreviewMouseLeftButtonDown="MediaCard_PreviewMouseLeftButtonDown"
                                            PreviewMouseRightButtonDown="MediaCard_PreviewMouseRightButtonDown"
                                            PreviewMouseMove="MediaCard_PreviewMouseMove"
                                            ToolTip="{Binding Name}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="card" CornerRadius="4"
                                                        Width="{Binding DataContext.MediaCardWidth, ElementName=MediaScroll}"
                                                        Height="{Binding DataContext.MediaCardHeight, ElementName=MediaScroll}"
                                                        Background="#10141E"
                                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                        Tag="{Binding DataContext, ElementName=MediaScroll}"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <!-- Con el encuadre real: escala, zoom, corrimiento, tamaño fijo, relleno,
                                                             brillo y tinte, igual que en la pantalla (sin desenfoque: no se nota acá) -->
                                                        <controls:FramedMediaPreview x:Name="preview" Media="{Binding}" DecodeWidth="320"/>
                                                        <Border Background="#66000000" VerticalAlignment="Bottom" Padding="4,1">
                                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                                                       FontSize="{Binding DataContext.MediaNameFontSize, ElementName=MediaScroll}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                        <TextBlock Text="🎞" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="Collapsed" x:Name="videoIcon"/>
                                                        <!-- Elegida: borde y fondo de acento (distinto del borde fino del mouse encima) -->
                                                        <Border x:Name="selected" Visibility="Collapsed" IsHitTestVisible="False"
                                                                CornerRadius="3" Background="#552F63C9"
                                                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"/>
                                                        <!-- En pantalla ahora: borde rojo -->
                                                        <Border x:Name="onAir" Visibility="Collapsed" IsHitTestVisible="False"
                                                                CornerRadius="3"
                                                                BorderBrush="{StaticResource LiveBrush}" BorderThickness="2"/>
                                                        <!-- Se reproduce por internet: sin conexión no anda -->
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3"
                                                                Padding="4,1" CornerRadius="3" Background="#B3000000"
                                                                Visibility="{Binding IsYouTube, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="Se reproduce por internet. Clic derecho → Descargar para uso local, para no depender de la conexión.">
                                                            <TextBlock Text="🌐 internet" FontSize="8" FontWeight="SemiBold" Foreground="White"/>
                                                        </Border>
                                                        <!-- Una página web guardada: un clic la abre en el panel web -->
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3"
                                                                Padding="4,1" CornerRadius="3" Background="#B3000000"
                                                                Visibility="{Binding IsWeb, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="Una página web. Un clic la abre en el panel web; se proyecta con sus botones.">
                                                            <TextBlock Text="🌐 página" FontSize="8" FontWeight="SemiBold" Foreground="White"/>
                                                        </Border>
                                                        <!-- Una ventana de otro programa guardada: un clic la busca y la proyecta -->
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3"
                                                                Padding="4,1" CornerRadius="3" Background="#B3000000"
                                                                Visibility="{Binding IsWindow, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="Una ventana de otro programa. Un clic la proyecta en vivo, si el programa está abierto.">
                                                            <TextBlock Text="🖥 ventana" FontSize="8" FontWeight="SemiBold" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Video">
                                                        <Setter TargetName="videoIcon" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <Trigger Property="controls:MediaCardState.IsSelected" Value="True">
                                                        <Setter TargetName="selected" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="controls:MediaCardState.IsLive" Value="True">
                                                        <Setter TargetName="onAir" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- El rectángulo de selección al arrastrar en el espacio vacío -->
                    <Border x:Name="MediaBand" Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#332F63C9" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"/>
                </Grid>
                </DockPanel>
            </DockPanel>
            </Border>
        </Grid>

        <!-- ══ Barra de estado ══ -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   Margin="14,8,14,10" TextWrapping="Wrap"/>
    </Grid>
</Window>
