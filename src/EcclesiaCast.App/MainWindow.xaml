<Window x:Class="EcclesiaCast.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EcclesiaCast.App.Controls"
        xmlns:services="clr-namespace:EcclesiaCast.App.Services"
        Title="EcclesiaCast — Operador"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding ToggleBlackCommand}"/>
        <KeyBinding Key="F2" Command="{Binding ToggleClearCommand}"/>
        <KeyBinding Key="F3" Command="{Binding ToggleLogoCommand}"/>
        <KeyBinding Key="F4" Command="{Binding ClearBackgroundCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding HideOutputCommand}"/>
        <!-- Una sola caja para buscar en canciones, versículos y medios -->
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding SearchEverythingCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding SearchEverythingCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Menú ══
             Todo lo que se hace de vez en cuando (importar, copias de
             seguridad, el diseño de la ventana) vive acá; los botones quedan
             para lo que se usa en medio del servicio. -->
        <Menu Grid.Row="0" Background="{StaticResource BgBrush}" Padding="6,2"
              FontSize="12">
            <Menu.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter Property="Padding" Value="8,3"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Menu.ItemContainerStyle>

            <MenuItem Header="_Archivo">
                <MenuItem Header="Buscar canciones en internet…" Command="{Binding SearchSongsOnlineCommand}"/>
                <MenuItem Header="Traer canciones de ProPresenter…" Command="{Binding ImportFromProPresenterCommand}"/>
                <MenuItem Header="Importar canciones (.txt, .pro)…" Command="{Binding ImportSongsCommand}"/>
                <MenuItem Header="Importar una Biblia (JSON o Zefania XML)…" Command="{Binding ImportBibleCommand}"/>
                <MenuItem Header="Agregar imágenes, videos, PDF o PowerPoint…" Command="{Binding ImportMediaCommand}"/>
                <Separator/>
                <MenuItem Header="Guardar una copia de la biblioteca…" Command="{Binding SaveBackupCommand}"/>
                <MenuItem Header="Restaurar desde una copia…" Command="{Binding RestoreBackupCommand}"/>
                <Separator/>
                <MenuItem Header="Salir" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="_Edición">
                <MenuItem Header="Nueva canción" Command="{Binding NewSongCommand}"/>
                <MenuItem Header="Editar la canción elegida" Command="{Binding EditSongCommand}"/>
                <Separator/>
                <MenuItem Header="Nueva playlist" Command="{Binding NewPlaylistCommand}"/>
                <MenuItem Header="Nueva lista inteligente…" Command="{Binding EditSmartPlaylistCommand}"/>
                <Separator/>
                <MenuItem Header="Temas…" Command="{Binding OpenThemesCommand}"/>
                <MenuItem Header="Logos…" Command="{Binding OpenLogosCommand}"/>
                <Separator/>
                <MenuItem Header="Buscar en todo" InputGestureText="Ctrl+K" Command="{Binding SearchEverythingCommand}"/>
            </MenuItem>

            <MenuItem Header="_Ver" SubmenuOpened="ViewMenu_SubmenuOpened">
                <MenuItem x:Name="LibraryRightItem" Header="Canciones y playlist a la derecha"
                          IsCheckable="True" Click="LibraryRight_Click"/>
                <MenuItem x:Name="PlaylistTopItem" Header="Playlist arriba de las canciones"
                          IsCheckable="True" Click="PlaylistTop_Click"/>
                <MenuItem x:Name="MediaTopItem" Header="Medios arriba de las diapositivas"
                          IsCheckable="True" Click="MediaTop_Click"/>
                <MenuItem x:Name="LiveBottomItem" Header="Preview arriba del Live"
                          IsCheckable="True" Click="LiveBottom_Click"/>
                <Separator/>
                <MenuItem x:Name="LibraryCollapsedItem" Header="Achicar canciones y Biblia"
                          IsCheckable="True" Click="LibraryCollapsedItem_Click"/>
                <MenuItem x:Name="PlaylistCollapsedItem" Header="Achicar la playlist"
                          IsCheckable="True" Click="PlaylistCollapsedItem_Click"/>
                <Separator/>
                <MenuItem Header="Volver al diseño original" Click="ResetLayout_Click"/>
            </MenuItem>

            <MenuItem Header="_Proyección">
                <MenuItem Header="Poner en vivo / apagar la salida" Command="{Binding ToggleOutputCommand}"/>
                <Separator/>
                <MenuItem Header="Black" InputGestureText="F1" Command="{Binding ToggleBlackCommand}"/>
                <MenuItem Header="Clear" InputGestureText="F2" Command="{Binding ToggleClearCommand}"/>
                <MenuItem Header="Logo" InputGestureText="F3" Command="{Binding ToggleLogoCommand}"/>
                <MenuItem Header="Sin fondo" InputGestureText="F4" Command="{Binding ClearBackgroundCommand}"/>
                <Separator/>
                <MenuItem Header="Pantalla de escenario" Command="{Binding ToggleStageCommand}"/>
                <MenuItem Header="Poner el cronómetro del escenario en cero" Command="{Binding ResetStageTimerCommand}"/>
                <MenuItem Header="Cuenta regresiva…" Command="{Binding OpenCountdownCommand}"/>
                <MenuItem Header="Controlar desde el celular…" Command="{Binding OpenRemoteCommand}"/>
                <Separator/>
                <MenuItem Header="Actualizar la lista de pantallas" Command="{Binding RefreshDisplaysCommand}"/>
            </MenuItem>

            <MenuItem Header="A_yuda">
                <MenuItem Header="Guía de uso (en internet)" Click="Guide_Click"/>
                <MenuItem Header="Acerca de EcclesiaCast" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ══ Barra superior ══ -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,9">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="EcclesiaCast"
                           FontSize="17" FontWeight="SemiBold" Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="24,0,0,0">
                    <Button Content="Black  (F1)" Command="{Binding ToggleBlackCommand}"
                            ToolTip="Pantalla en negro: tapa todo (letra y fondo) sin apagar la salida.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBlackActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Clear  (F2)" Command="{Binding ToggleClearCommand}" Margin="6,0,0,0"
                            ToolTip="Saca la letra de la pantalla y deja el fondo (imagen o video) a la vista. Se vuelve a apretar para traer la letra de nuevo.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsClearActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Logo: el botón lo prende/apaga, la flecha elige cuál -->
                    <Button Content="Logo  (F3)" Command="{Binding ToggleLogoCommand}" Margin="6,0,0,0"
                            ToolTip="{Binding ActiveLogoName, StringFormat='Muestra el logo a pantalla completa. Ahora está elegido: {0}'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogoActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Los botones que son sólo un ícono llevan su nombre escrito:
                         un lector de pantalla, si no, anuncia el nombre del emoji. -->
                    <Button x:Name="LogoPickerButton" Content="▾" Padding="8,7" Margin="2,0,0,0"
                            Style="{StaticResource DarkButton}"
                            AutomationProperties.Name="Elegir logo"
                            Click="LogoPicker_Click"
                            ToolTip="Elegir qué logo se muestra (general, jóvenes, mujeres…)"/>
                    <Button Content="🖼▦" Padding="8,7" Margin="2,0,0,0"
                            Style="{StaticResource DarkButton}"
                            AutomationProperties.Name="Logo de fondo"
                            Command="{Binding UseLogoAsBackgroundCommand}"
                            IsEnabled="{Binding CanUseLogoAsBackground}"
                            ToolTip="Poner el logo de fondo, detrás de la letra, con el desenfoque que tenga configurado"/>
                    <Button Content="Sin fondo  (F4)" Margin="6,0,0,0"
                            Style="{StaticResource DarkButton}"
                            Command="{Binding ClearBackgroundCommand}"
                            IsEnabled="{Binding HasBackground}"
                            ToolTip="Quita la imagen o el video de fondo y deja la letra sola sobre el fondo del tema"/>
                    <Button Content="🎨 Temas" Margin="14,0,0,0"
                            Style="{StaticResource DarkButton}"
                            Command="{Binding OpenThemesCommand}"
                            ToolTip="Tipografía, colores, márgenes y fondos"/>

                    <!-- Escenario: la pantalla que miran los músicos -->
                    <Button Content="🎭 Escenario" Margin="14,0,0,0"
                            Command="{Binding ToggleStageCommand}"
                            ToolTip="Prende la pantalla para los músicos: la letra que está en vivo, la que sigue, la hora y el cronómetro">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStageVisible}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="▾" Padding="8,7" Margin="2,0,0,0"
                            Style="{StaticResource DarkButton}"
                            AutomationProperties.Name="Ajustes del escenario"
                            Click="StageOptions_Click"
                            ToolTip="En qué pantalla va el escenario y qué muestra"/>

                    <!-- Celular: control remoto por la red de la iglesia -->
                    <Button Content="📱" Padding="9,7" Margin="8,0,0,0"
                            AutomationProperties.Name="Controlar desde el celular"
                            Command="{Binding OpenRemoteCommand}"
                            ToolTip="Controlar la proyección desde el celular, por la red de la iglesia">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRemoteRunning}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Buscar en todo: canciones, versículos y medios -->
                    <Button Content="🔍" Padding="9,7" Margin="8,0,0,0"
                            Style="{StaticResource DarkButton}"
                            AutomationProperties.Name="Buscar en canciones, versículos y medios"
                            Command="{Binding SearchEverythingCommand}"
                            ToolTip="Buscar en canciones, versículos y medios a la vez (Ctrl+K)"/>

                    <!-- Cuenta regresiva antes del servicio -->
                    <Button Content="⏱" Padding="9,7" Margin="8,0,0,0"
                            AutomationProperties.Name="Cuenta regresiva"
                            Command="{Binding OpenCountdownCommand}"
                            ToolTip="Proyectar una cuenta regresiva antes de empezar («Empezamos en 5:00»)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCountdownRunning}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Copia de seguridad de toda la biblioteca -->
                    <Button Content="💾" Padding="9,7" Margin="2,0,0,0"
                            Style="{StaticResource DarkButton}"
                            AutomationProperties.Name="Copia de seguridad de la biblioteca"
                            Click="Backup_Click"
                            ToolTip="Guardar una copia de toda la biblioteca, o restaurar una copia guardada"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Salida:" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="220"
                              ItemsSource="{Binding Displays}"
                              SelectedItem="{Binding SelectedDisplay}"
                              DisplayMemberPath="Label"
                              VerticalAlignment="Center"
                              ToolTip="Monitor o proyector donde sale la imagen"/>
                    <Button Content="↻"
                            Style="{StaticResource DarkButton}"
                            AutomationProperties.Name="Actualizar pantallas"
                            Command="{Binding RefreshDisplaysCommand}"
                            ToolTip="Actualizar pantallas"
                            Padding="9,6" Margin="6,0,14,0"/>
                    <Button Command="{Binding ToggleOutputCommand}"
                            ToolTip="Prende o apaga la ventana de salida en la pantalla elegida.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Setter Property="Content" Value="🔴  Poner en vivo"/>
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProjecting}" Value="True">
                                        <Setter Property="Content" Value="Apagar salida  (Esc)"/>
                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ══ Zona central: biblioteca | slides | preview/live ══
             La barra de medios va abajo de las dos primeras columnas; la
             columna derecha (preview, live y texto rápido) baja entera. -->
        <Grid x:Name="MainArea" Grid.Row="2" Margin="10,10,10,0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ContentRow" Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition x:Name="MediaRow" Height="150" MinHeight="86"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="270" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="320" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo: biblioteca + playlist -->
            <Grid x:Name="LeftPanel" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="LibraryRow" Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition x:Name="PlaylistRow" Height="240" MinHeight="120"/>
                </Grid.RowDefinitions>
                <GridSplitter x:Name="PlaylistSplitter" Grid.Row="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Height="6" Background="Transparent"/>

                <Border x:Name="LibraryPanel" Grid.Row="0" Style="{StaticResource Panel}">
                    <DockPanel>
                        <!-- Selector de pestaña, y la flecha que achica el panel -->
                        <DockPanel DockPanel.Dock="Top" Margin="10,10,10,8">
                            <Button x:Name="LibraryCollapseButton" DockPanel.Dock="Right"
                                    Content="▾" FontSize="11" Padding="7,2"
                                    Style="{StaticResource DarkButton}"
                                    AutomationProperties.Name="Achicar o agrandar canciones y Biblia"
                                    Click="LibraryCollapse_Click"
                                    ToolTip="Achicar este panel para darle lugar a la playlist (o volver a agrandarlo)"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Canciones" Style="{StaticResource TabButton}"
                                             GroupName="LibraryTab"
                                             IsChecked="{Binding IsBibleTabActive, Converter={StaticResource InverseBool}}"
                                             Command="{Binding ShowSongsTabCommand}"/>
                                <RadioButton Content="Biblia" Style="{StaticResource TabButton}"
                                             GroupName="LibraryTab" Margin="4,0,0,0"
                                             IsChecked="{Binding IsBibleTabActive}"
                                             Command="{Binding ShowBibleTabCommand}"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid x:Name="LibraryBody">
                            <!-- ── Pestaña Canciones ── -->
                            <DockPanel Visibility="{Binding IsBibleTabActive, Converter={StaticResource InverseBoolToVis}}">
                                <DockPanel DockPanel.Dock="Top">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,10,8">
                                        <Button Content="📥 ▾" FontSize="11" Padding="7,4"
                                                Style="{StaticResource DarkButton}"
                                                AutomationProperties.Name="Importar canciones"
                                                Click="ImportMenu_Click"
                                                ToolTip="Buscar canciones en internet o importarlas de otros programas o de archivos"/>
                                        <Button Content="➕" FontSize="11" Padding="7,4" Margin="4,0,0,0"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding NewSongCommand}"
                                                AutomationProperties.Name="Nueva canción"
                                                ToolTip="Nueva canción"/>
                                        <Button Content="✏️" FontSize="11" Padding="7,4" Margin="4,0,0,0"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding EditSongCommand}"
                                                AutomationProperties.Name="Editar canción"
                                                ToolTip="Editar canción"/>
                                        <Button Content="🗑" FontSize="11" Padding="7,4" Margin="4,0,0,0"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding DeleteSongCommand}"
                                                AutomationProperties.Name="Eliminar canción"
                                                ToolTip="Eliminar canción"/>
                                    </StackPanel>
                                    <TextBlock Text="CANCIONES" Style="{StaticResource PanelTitle}" Margin="12,0,12,0"
                                               Cursor="Hand" MouseLeftButtonUp="LibraryTitle_MouseLeftButtonUp"
                                               ToolTip="Clic: achicar este panel para darle lugar a la playlist"/>
                                </DockPanel>
                                <TextBox DockPanel.Dock="Top"
                                         Margin="12,0,12,8" Padding="8,6"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         CaretBrush="White"
                                         FontSize="13"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Buscar por título, artista o letra"/>
                                <ListBox x:Name="SongsList" ItemsSource="{Binding Songs}"
                                         SelectedItem="{Binding SelectedSong}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ToolTip="Doble clic proyecta · clic derecho: más opciones">
                                    <ListBox.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding ProjectFirstSlideCommand}"/>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding ProjectFirstSlideCommand}"/>
                                    </ListBox.InputBindings>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,6"/>
                                            <!-- Sin un nombre explícito, un lector de pantalla lee el
                                                 nombre del tipo en vez del de la canción. -->
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Artist}"/>
                                            <Setter Property="Tag"
                                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                            <Setter Property="ContextMenu">
                                                <Setter.Value>
                                                    <ContextMenu>
                                                        <MenuItem Header="Editar canción (diseño)"
                                                                  Command="{Binding PlacementTarget.Tag.EditSongDesignForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="Editar como texto plano"
                                                                  Command="{Binding PlacementTarget.Tag.EditSongTextForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Agregar a la playlist"
                                                                  Command="{Binding PlacementTarget.Tag.AddSongToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Duplicar canción"
                                                                  Command="{Binding PlacementTarget.Tag.DuplicateSongCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Eliminar canción"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteSongForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="bd" Background="Transparent"
                                                                CornerRadius="4" Margin="6,1"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <!-- Sin artista, el renglón no ocupa lugar -->
                                                <TextBlock Text="{Binding Artist}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Artist}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Artist}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- ── Pestaña Biblia ── -->
                            <DockPanel Visibility="{Binding IsBibleTabActive, Converter={StaticResource BoolToVis}}">
                                <!-- Versiones (hasta 2 tildadas a la vez, estilo BibleShow) -->
                                <DockPanel DockPanel.Dock="Top" Margin="12,0,12,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="▶➕" FontSize="11" Padding="7,4" Margin="0,0,4,0"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding AddCurrentPassageToPlaylistCommand}"
                                                ToolTip="Agregar el pasaje actual a la playlist"/>
                                        <Button Content="📥" FontSize="11" Padding="7,4"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding ImportBibleCommand}"
                                                ToolTip="Importar Biblia (JSON o Zefania XML)"/>
                                        <Button Content="✏️" FontSize="11" Padding="7,4" Margin="4,0,0,0"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding RenameBibleVersionCommand}"
                                                AutomationProperties.Name="Renombrar versión"
                                                ToolTip="Renombrar versión"/>
                                        <Button Content="🗑" FontSize="11" Padding="7,4" Margin="4,0,0,0"
                                                Style="{StaticResource DarkButton}"
                                                Command="{Binding DeleteBibleVersionCommand}"
                                                AutomationProperties.Name="Eliminar versión"
                                                ToolTip="Eliminar versión"/>
                                    </StackPanel>
                                    <TextBlock Text="VERSIONES — hasta 2 a la vez"
                                               FontSize="10" Foreground="{StaticResource FaintBrush}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border DockPanel.Dock="Top" Margin="12,0,12,6"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="4" MaxHeight="98">
                                    <ListBox x:Name="VersionsList"
                                             ItemsSource="{Binding BibleVersionOptions}"
                                             SelectedItem="{Binding SelectedBibleVersionOption}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="8,3"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="bd" Background="Transparent"
                                                                    CornerRadius="3"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#2C3040"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Center"
                                                              ToolTip="Activa esta versión para proyectar (la segunda se muestra debajo de la primera)"/>
                                                    <TextBlock Text="{Binding Info.Abbreviation}"
                                                               DockPanel.Dock="Right"
                                                               FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Info.Name}"
                                                               FontSize="12" Foreground="White"
                                                               Margin="6,0,6,0"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Background="Transparent"
                                                               Cursor="Hand"
                                                               ToolTip="Clic: usar solo esta versión. La casilla agrega una segunda.">
                                                        <TextBlock.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.SelectSoloVersionCommand, ElementName=VersionsList}"
                                                                          CommandParameter="{Binding}"/>
                                                        </TextBlock.InputBindings>
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <TextBox x:Name="BibleQueryBox" DockPanel.Dock="Top"
                                         Margin="12,0,12,6" Padding="8,6"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         CaretBrush="White"
                                         FontSize="13"
                                         Text="{Binding BibleQuery, UpdateSourceTrigger=PropertyChanged}"
                                         KeyUp="BibleQueryBox_KeyUp"
                                         ToolTip="Escribí el libro y se filtra la lista («ju» → Jueces, Juan, Judas; Enter abre el primero). «juan 3» abre el capítulo, «juan 3 16» marca el versículo y Enter lo proyecta. Con ? adelante busca palabras en los versículos (?paz). Ctrl+K busca en canciones, Biblia y medios a la vez.">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ProjectReferenceCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock DockPanel.Dock="Bottom"
                                           Text="{Binding BibleStatusText}"
                                           FontSize="10" Foreground="{StaticResource FaintBrush}"
                                           TextWrapping="Wrap"
                                           Margin="12,4,12,10"/>

                                <Grid>
                                    <!-- Lista de libros, en orden bíblico -->
                                    <ListBox ItemsSource="{Binding BibleBooksAvailable}"
                                             SelectedItem="{Binding SelectedBibleBook}"
                                             Visibility="{Binding ShowBooksList, Converter={StaticResource BoolToVis}}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="10,4"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="bd" Background="Transparent"
                                                                    CornerRadius="4" Margin="6,0"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="White"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Capítulos del libro elegido, como grilla numérica -->
                                    <DockPanel Visibility="{Binding ShowChaptersView, Converter={StaticResource BoolToVis}}">
                                        <DockPanel DockPanel.Dock="Top" Margin="10,0,10,6">
                                            <Button DockPanel.Dock="Left" Content="◀ Libros"
                                                    Style="{StaticResource DarkButton}"
                                                    FontSize="11" Padding="8,4"
                                                    Command="{Binding BackToBooksCommand}"/>
                                            <TextBlock Text="{Binding ChaptersTitle}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="White"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ScrollViewer x:Name="ChaptersScroll" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="ChaptersGrid"
                                                          ItemsSource="{Binding BibleChapters}"
                                                          Margin="8,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Number}"
                                                                Width="40" Height="32" Margin="2"
                                                                Padding="0" FontSize="12"
                                                                Command="{Binding DataContext.SelectChapterCommand, ElementName=ChaptersGrid}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>

                                    <!-- Resultados de búsqueda por texto -->
                                    <ListBox x:Name="BibleResultsList"
                                         ItemsSource="{Binding BibleSearchResults}"
                                         Visibility="{Binding ShowBibleResults, Converter={StaticResource BoolToVis}}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ToolTip="Doble clic proyecta el versículo y carga el capítulo">
                                    <ListBox.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding ProjectBibleResultCommand}"
                                                      CommandParameter="{Binding SelectedItem, ElementName=BibleResultsList}"/>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding ProjectBibleResultCommand}"
                                                    CommandParameter="{Binding SelectedItem, ElementName=BibleResultsList}"/>
                                    </ListBox.InputBindings>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Reference}"/>
                                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Text}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="bd" Background="Transparent"
                                                                CornerRadius="4" Margin="6,1"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Reference}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Text}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap" MaxHeight="32"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border x:Name="PlaylistPanel" Grid.Row="2" Style="{StaticResource Panel}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel x:Name="PlaylistTools" DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,8,10,4">
                                <Button Content="➕" FontSize="11" Padding="6,3"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding NewPlaylistCommand}"
                                        AutomationProperties.Name="Nueva playlist" ToolTip="Nueva playlist"/>
                                <Button Content="✨" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding EditSmartPlaylistCommand}"
                                        AutomationProperties.Name="Lista inteligente"
                                        ToolTip="Lista inteligente: se arma sola (lo que agregaste hace poco, lo que hace rato no cantás, un artista, una palabra)"/>
                                <Button Content="✏️" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding RenamePlaylistCommand}"
                                        AutomationProperties.Name="Renombrar playlist" ToolTip="Renombrar"/>
                                <Button Content="⧉" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding DuplicatePlaylistCommand}"
                                        AutomationProperties.Name="Duplicar playlist"
                                        ToolTip="Duplicar (ej. el domingo pasado)"/>
                                <Button Content="🗑" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding DeletePlaylistCommand}"
                                        AutomationProperties.Name="Eliminar playlist" ToolTip="Eliminar"/>
                            </StackPanel>
                            <!-- Clic en el título: achica la playlist a sólo esta línea -->
                            <TextBlock x:Name="PlaylistTitle" Text="▾  PLAYLIST" Style="{StaticResource PanelTitle}"
                                       Cursor="Hand" Background="Transparent"
                                       MouseLeftButtonUp="PlaylistTitle_MouseLeftButtonUp"
                                       ToolTip="Clic: achicar la playlist (o volver a agrandarla)"/>
                        </DockPanel>
                        <ComboBox x:Name="PlaylistPicker" DockPanel.Dock="Top" Margin="12,0,12,6"
                                  ItemsSource="{Binding Playlists}"
                                  SelectedItem="{Binding SelectedPlaylist}"
                                  DisplayMemberPath="Name" FontSize="12"
                                  ToolTip="Orden de la reunión: elegí la playlist que vas a usar hoy"/>
                        <Grid x:Name="PlaylistBody">
                            <TextBlock Text="Agregá canciones (clic derecho), pasajes (botón ▶➕ en Biblia)&#10;y medios (clic derecho) · doble clic proyecta.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlaylistItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox x:Name="PlaylistList"
                                     ItemsSource="{Binding PlaylistItems}"
                                     SelectedItem="{Binding SelectedPlaylistItem}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ToolTip="Clic: cargar sin proyectar · doble clic: proyectar">
                                <ListBox.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding ProjectPlaylistItemCommand}"
                                                  CommandParameter="{Binding SelectedItem, ElementName=PlaylistList}"/>
                                    <KeyBinding Key="Enter"
                                                Command="{Binding ProjectPlaylistItemCommand}"
                                                CommandParameter="{Binding SelectedItem, ElementName=PlaylistList}"/>
                                </ListBox.InputBindings>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Caption}"/>
                                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PlaylistItem_PreviewMouseLeftButtonDown"/>
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="Subir"
                                                              Command="{Binding PlacementTarget.Tag.MovePlaylistItemUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Bajar"
                                                              Command="{Binding PlacementTarget.Tag.MovePlaylistItemDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Quitar de la playlist"
                                                              Command="{Binding PlacementTarget.Tag.RemovePlaylistItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                            Margin="6,1" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock x:Name="icon" Text="🎵" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="BiblePassage">
                                                <Setter TargetName="icon" Property="Text" Value="📖"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Media">
                                                <Setter TargetName="icon" Property="Text" Value="🎞"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Alto de la barra de medios, ajustable por el operador -->
            <GridSplitter x:Name="MediaSplitter" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Height="8" Background="Transparent"
                          ToolTip="Arrastrá para agrandar o achicar la barra de medios"/>

            <!-- Panel central: la grilla de diapositivas -->
            <Border x:Name="SlidesPanel" Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="Elegí una canción o buscá un pasaje bíblico (ej. &quot;Juan 3:16&quot;)&#10;y sus diapositivas aparecen acá.&#10;&#10;Clic en una diapositiva la proyecta · doble clic en la lista arranca desde la primera&#10;· flechas ←→ navegan en vivo.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSlides}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer x:Name="SlidesScroll" VerticalScrollBarVisibility="Auto" Padding="6">
                                <ItemsControl x:Name="SlideGrid" ItemsSource="{Binding Slides}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ProjectSlideCommand, ElementName=SlideGrid}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    Tag="{Binding DataContext, ElementName=SlideGrid}"
                                                    ContextMenuOpening="SlideCard_ContextMenuOpening"
                                                    AllowDrop="True"
                                                    PreviewMouseLeftButtonDown="SlideCard_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="SlideCard_PreviewMouseMove"
                                                    DragEnter="SlideCard_DragEnter"
                                                    DragOver="SlideCard_DragOver"
                                                    DragLeave="SlideCard_DragLeave"
                                                    Drop="SlideCard_Drop"
                                                    AutomationProperties.Name="{Binding Label}"
                                                    AutomationProperties.HelpText="{Binding PreviewText}"
                                                    ToolTip="Clic: proyectar · Arrastrar: cambiarla de lugar · Clic derecho: más opciones">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Editar canción (diseño)"
                                                                  Command="{Binding PlacementTarget.Tag.EditSongDesignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="Edición rápida (solo texto)"
                                                                  Command="{Binding PlacementTarget.Tag.QuickEditSlideCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="Editar como texto plano (canción)"
                                                                  Command="{Binding PlacementTarget.Tag.EditSongAsTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Copiar"
                                                                  Command="{Binding PlacementTarget.Tag.CopySlideCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="Pegar"
                                                                  Command="{Binding PlacementTarget.Tag.PasteSlideCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="Duplicar"
                                                                  Command="{Binding PlacementTarget.Tag.DuplicateSlideCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Eliminar"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteSlideCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="card" Width="220" Height="118" Margin="6"
                                                                CornerRadius="6" Background="#10141E"
                                                                BorderBrush="{StaticResource LineBrush}"
                                                                BorderThickness="1" Padding="10">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Top"
                                                                           Text="{Binding Label}"
                                                                           FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource MutedBrush}"/>
                                                                <!-- Todas las tarjetas del mismo tamaño: la letra
                                                                     se achica hasta que entra entera -->
                                                                <TextBlock Text="{Binding PreviewText}"
                                                                           FontSize="12" Foreground="White"
                                                                           TextWrapping="Wrap"
                                                                           controls:TextFit.MaxFontSize="12"
                                                                           Margin="0,4,0,0"/>
                                                            </DockPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="card" Property="Background" Value="#1A2030"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsPreviewed}" Value="True">
                                                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource LiveBrush}"/>
                                                                <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Panel derecho: live, preview y texto rápido (llega hasta abajo).
                 Lo que está en pantalla va primero: es lo que más se mira. -->
            <Grid x:Name="RightPanel" Grid.Column="4" Grid.RowSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*" MinHeight="130"/>
                </Grid.RowDefinitions>

                <Border x:Name="PreviewPanel" Grid.Row="2" Style="{StaticResource Panel}">
                    <StackPanel>
                        <!-- Qué muestra: la diapositiva que sigue, o la pantalla
                             de escenario tal como la ven los músicos -->
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,6,10,4">
                                <RadioButton Content="Siguiente" Style="{StaticResource TabButton}"
                                             GroupName="PreviewMode" Padding="8,3" FontSize="11"
                                             IsChecked="{Binding PreviewShowsStage, Converter={StaticResource InverseBool}}"
                                             ToolTip="La diapositiva que va a salir después"/>
                                <RadioButton Content="Escenario" Style="{StaticResource TabButton}"
                                             GroupName="PreviewMode" Padding="8,3" FontSize="11" Margin="2,0,0,0"
                                             IsChecked="{Binding PreviewShowsStage}"
                                             ToolTip="Lo que ven los músicos y quien predica en la pantalla de escenario, aunque no esté prendida"/>
                            </StackPanel>
                            <TextBlock Text="PREVIEW" Style="{StaticResource PanelTitle}"/>
                        </DockPanel>
                        <Border Height="165" Margin="12,0,12,12"
                                Background="#0B0D12" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <controls:ProjectedView Slide="{Binding PreviewSlide}"
                                                        BackgroundMedia="{Binding Projection.Background}"
                                                        FillMedia="{Binding Projection.BackgroundFill}"
                                                        BackgroundBlur="{Binding Projection.BackgroundBlur}"
                                                        Logo="{Binding Projection.ActiveLogo}"
                                                        Visibility="{Binding PreviewShowsStage, Converter={StaticResource InverseBoolToVis}}"/>
                                <Viewbox Stretch="Uniform"
                                         Visibility="{Binding PreviewShowsStage, Converter={StaticResource BoolToVis}}">
                                    <controls:StageView Width="1920" Height="1080"
                                                        DataContext="{Binding Projection}"
                                                        Options="{Binding DataContext.StageOptionsForPreview, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="LivePanel" Grid.Row="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9"
                                     Fill="{StaticResource LiveBrush}"
                                     VerticalAlignment="Center"
                                     Margin="12,1,0,0"/>
                            <TextBlock Text="LIVE · PROYECTADO" Style="{StaticResource PanelTitle}" Margin="7,10,12,8"/>
                        </StackPanel>
                        <Border Height="165" Margin="12,0,12,12"
                                Background="#0B0D12" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProjecting}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource LiveBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <controls:ProjectedView x:Name="LiveView"
                                                    Slide="{Binding Projection.Slide}"
                                                    Cursor="IBeam"
                                                    PreviewMouseLeftButtonDown="LiveView_PreviewMouseLeftButtonDown"
                                                    PreviewMouseLeftButtonUp="LiveView_PreviewMouseLeftButtonUp"
                                                    ToolTip="Clic en una palabra: se resalta en la pantalla · Arrastrá sobre varias: se resalta la frase · Clic otra vez: se quita"
                                                    State="{Binding Projection.State}"
                                                    Overlay="{Binding Projection.Overlay}"
                                                    Countdown="{Binding Projection.Countdown}"
                                                    Highlight="{Binding Projection.Highlight}"
                                                    BackgroundMedia="{Binding Projection.Background}"
                                                    FillMedia="{Binding Projection.BackgroundFill}"
                                                    BackgroundBlur="{Binding Projection.BackgroundBlur}"
                                                    LiveVideoFrame="{Binding Projection.LiveFrame}"
                                                    Logo="{Binding Projection.ActiveLogo}"/>
                        </Border>

                        <!-- Transporte del video que está en pantalla, pegado a
                             lo que muestra: sólo con video (archivo o YouTube) -->
                        <StackPanel Margin="12,-4,12,12"
                                    Visibility="{Binding HasVideoPlayback, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PlaybackTimeText}" FontSize="11"
                                           VerticalAlignment="Center" TextAlignment="Right"
                                           Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="⏮" FontSize="12" Padding="8,3"
                                            Style="{StaticResource DarkButton}"
                                            AutomationProperties.Name="Volver al principio"
                                            Command="{Binding RestartVideoCommand}"
                                            ToolTip="Volver al principio del video"/>
                                    <Button Content="⏪ 10s" FontSize="11" Padding="7,3" Margin="4,0,0,0"
                                            Style="{StaticResource DarkButton}"
                                            Command="{Binding SkipBackwardCommand}"
                                            ToolTip="Retroceder 10 segundos"/>
                                    <Button FontSize="12" Padding="10,3" Margin="4,0,0,0"
                                            AutomationProperties.Name="Reproducir o pausar"
                                            Command="{Binding TogglePlayPauseCommand}"
                                            ToolTip="Reproducir o pausar el video que está en pantalla">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                <Setter Property="Content" Value="▶"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVideoPlaying}" Value="True">
                                                        <Setter Property="Content" Value="⏸"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="10s ⏩" FontSize="11" Padding="7,3" Margin="4,0,0,0"
                                            Style="{StaticResource DarkButton}"
                                            Command="{Binding SkipForwardCommand}"
                                            ToolTip="Adelantar 10 segundos"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Barra de progreso, arrastrable -->
                            <Slider Minimum="0" Maximum="{Binding PlaybackDurationSeconds}"
                                    Value="{Binding PlaybackPositionSeconds}"
                                    IsMoveToPointEnabled="True" Margin="0,6,0,0"
                                    ToolTip="Arrastrá para moverte dentro del video"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Las tres formas de escribir sobre lo proyectado, en pestañas -->
                <Border Grid.Row="4" Style="{StaticResource Panel}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,8">
                            <RadioButton x:Name="TabQuick" Content="Texto rápido"
                                         Style="{StaticResource TabButton}" GroupName="WriteTab"
                                         IsChecked="True"
                                         ToolTip="Un anuncio a pantalla completa, con el tema de las canciones"/>
                            <RadioButton x:Name="TabOverlay" Content="Aviso al pie"
                                         Style="{StaticResource TabButton}" GroupName="WriteTab" Margin="4,0,0,0"
                                         ToolTip="Una franja al pie de la pantalla, encima de todo lo demás"/>
                            <RadioButton x:Name="TabHighlight" Content="Resaltar"
                                         Style="{StaticResource TabButton}" GroupName="WriteTab" Margin="4,0,0,0"
                                         ToolTip="Pinta una palabra como con marcador sobre lo que está proyectado"/>
                            <RadioButton x:Name="TabNotes" Content="Notas"
                                         Style="{StaticResource TabButton}" GroupName="WriteTab" Margin="4,0,0,0"
                                         ToolTip="Notas para quien predica: se ven sólo en la pantalla de escenario"/>
                        </StackPanel>

                        <Grid>
                            <!-- ── Texto rápido ── -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=TabQuick, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Bottom"
                                        Content="Proyectar ▶  (Ctrl+Enter)"
                                        Style="{StaticResource AccentButton}"
                                        Command="{Binding GoLiveCommand}"
                                        Margin="12,8,12,12" Padding="10,8"
                                        ToolTip="Manda lo escrito a la pantalla, con el tema de las canciones"/>
                                <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         CaretBrush="White"
                                         Margin="12,0,12,0"
                                         Padding="8,6" FontSize="14"
                                         services:SpellChecking.Enabled="True"
                                         ToolTip="Escribí un aviso y proyectalo al instante · Enter hace un renglón nuevo, Ctrl+Enter proyecta">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding GoLiveCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>

                            <!-- ── Aviso al pie ── -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=TabOverlay, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Aparece en una franja abajo, por encima de todo — incluso con Black puesto."
                                           FontSize="11" Foreground="{StaticResource FaintBrush}"
                                           TextWrapping="Wrap" Margin="12,0,12,8"/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8,12,12">
                                    <Button Content="Mostrar" Command="{Binding ShowOverlayCommand}" Padding="16,8"
                                            ToolTip="Pone la franja en pantalla">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverlayActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Quitar" Style="{StaticResource DarkButton}" Padding="16,8" Margin="6,0,0,0"
                                            Command="{Binding HideOverlayCommand}"
                                            ToolTip="Saca la franja del aviso"/>
                                </StackPanel>
                                <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding OverlayText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         CaretBrush="White"
                                         Margin="12,0,12,0"
                                         Padding="8,6" FontSize="14"
                                         services:SpellChecking.Enabled="True"
                                         ToolTip="Ej: «el auto ABC 123 está con las luces prendidas»">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ShowOverlayCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>

                            <!-- ── Resaltar en vivo ── -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=TabHighlight, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Escribí una palabra o frase y se pinta al instante sobre el texto proyectado."
                                           FontSize="11" Foreground="{StaticResource FaintBrush}"
                                           TextWrapping="Wrap" Margin="12,0,12,8"/>
                                <TextBox DockPanel.Dock="Top"
                                         Text="{Binding HighlightText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         CaretBrush="White"
                                         Margin="12,0,12,0"
                                         Padding="8,6" FontSize="14"
                                         VerticalContentAlignment="Center"/>
                                <Button DockPanel.Dock="Top" Content="Quitar el resaltado"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding ClearHighlightCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="12,10,12,0" Padding="14,7"
                                        ToolTip="Saca el resaltado amarillo del texto proyectado"/>
                                <Grid/>
                            </DockPanel>

                            <!-- ── Notas para la plataforma ── -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=TabNotes, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Sólo se ven en la pantalla de escenario: el guion del predicador, un aviso para la banda. La congregación nunca las ve."
                                           FontSize="11" Foreground="{StaticResource FaintBrush}"
                                           TextWrapping="Wrap" Margin="12,0,12,8"/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8,12,12">
                                    <Button Content="Mostrar" Command="{Binding ShowStageNotesCommand}" Padding="16,8"
                                            ToolTip="Manda las notas a la pantalla de escenario">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStageNotesActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Quitar" Style="{StaticResource DarkButton}" Padding="16,8" Margin="6,0,0,0"
                                            Command="{Binding HideStageNotesCommand}"
                                            ToolTip="Saca las notas del escenario"/>
                                </StackPanel>
                                <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding StageNotesText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource LineBrush}"
                                         CaretBrush="White"
                                         Margin="12,0,12,0"
                                         Padding="8,6" FontSize="14"
                                         services:SpellChecking.Enabled="True"
                                         ToolTip="Ej: los puntos del mensaje, o «cantamos el coro dos veces»">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ShowStageNotesCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ══ Barra de medios ══ -->
            <Border x:Name="MediaPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource Panel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,10,2">
                        <Button Content="📥 Agregar" FontSize="11" Padding="8,4"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding ImportMediaCommand}"
                                ToolTip="Agregar imágenes o videos a la pestaña actual"/>
                        <Button Content="▶ YouTube" FontSize="11" Padding="8,4" Margin="6,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding OpenYouTubeCommand}"
                                ToolTip="Buscar en YouTube e iniciar sesión con tu cuenta (Premium: sin anuncios)"/>
                        <Button Content="🔗" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding AddYouTubeLinkCommand}"
                                ToolTip="Agregar un video de YouTube pegando el link"/>
                        <Button Content="🎲" FontSize="12" Padding="8,4" Margin="6,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding RandomBackgroundCommand}"
                                ToolTip="Poner un fondo al azar de esta pestaña. No repite ninguno hasta haberlos usado a todos."/>
                        <Button Content="Sin fondo  (F4)" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding ClearBackgroundCommand}"
                                IsEnabled="{Binding HasBackground}"
                                ToolTip="Quita la imagen o el video de fondo sin tocar la letra que está proyectada"/>
                    </StackPanel>
                    <TextBlock Text="MEDIOS" Style="{StaticResource PanelTitle}" Margin="12,8,10,4" VerticalAlignment="Center"/>
                    <!-- Pestañas por categoría -->
                    <ListBox ItemsSource="{Binding MediaTabs}" SelectedItem="{Binding SelectedMediaTab}"
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="4" Margin="2,0" Padding="10,4" Background="Transparent">
                                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <Button Content="＋" FontSize="12" Padding="7,2" Margin="4,0,0,0"
                            Style="{StaticResource DarkButton}"
                            Command="{Binding NewMediaTabCommand}"
                            ToolTip="Nueva pestaña (categoría)"/>
                    <CheckBox Content="▶▶ continua" FontSize="11" Foreground="{StaticResource MutedBrush}"
                              VerticalAlignment="Center" Margin="12,0,0,0"
                              IsChecked="{Binding ContinuousPlayback}"
                              ToolTip="En esta pestaña, al terminar un video arranca el siguiente, y al final vuelve al primero. Sirve para dejar un bucle de avisos antes de la reunión."/>
                    <CheckBox Content="🎲 al azar por canción" FontSize="11" Foreground="{StaticResource MutedBrush}"
                              VerticalAlignment="Center" Margin="10,0,0,0"
                              IsChecked="{Binding RandomBackgroundPerSong}"
                              ToolTip="Cada canción que proyectás se lleva un fondo distinto de esta pestaña, sin repetir hasta usarlos todos. Si elegís un fondo a mano, se respeta: el sorteo sólo elige cuando no hay fondo o cuando el que está salió sorteado."/>
                </DockPanel>

                <!-- ── Controles del fondo que está en pantalla ── -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                        Padding="12,6,12,8"
                        Visibility="{Binding HasBackground, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <!-- Desenfoque: sirve para imágenes y para videos -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="14,0,0,0">
                            <TextBlock Text="Desenfoque" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
                            <controls:NumericField Minimum="0" Maximum="100" Step="5" Decimals="0"
                                                   Value="{Binding BackgroundBlur}"
                                                   ToolTip="Difumina el fondo en vivo para que la letra se lea. 0 = nítido."/>
                            <Button Content="✕" FontSize="11" Padding="7,3" Margin="4,0,0,0"
                                    Style="{StaticResource DarkButton}"
                                    Command="{Binding ClearBlurCommand}"
                                    ToolTip="Volver el fondo nítido"/>
                        </StackPanel>

                        <TextBlock Text="FONDO EN PANTALLA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Grid>
                    <TextBlock Margin="16,0,16,8"
                               Text="Agregá imágenes o videos con 📥 y aplicalos con un clic.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MediaItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer x:Name="MediaScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MediaItems}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ApplyBackgroundCommand, ElementName=MediaScroll}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand" Margin="6,2"
                                            Tag="{Binding DataContext, ElementName=MediaScroll}"
                                            AutomationProperties.Name="{Binding Name}"
                                            ToolTip="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Agregar a la playlist"
                                                          Command="{Binding PlacementTarget.Tag.AddMediaToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="Descargar para uso local (YouTube)"
                                                          Command="{Binding PlacementTarget.Tag.DownloadYouTubeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          ToolTip="Guarda el video en la computadora para no depender de internet durante la reunión"/>
                                                <Separator/>
                                                <MenuItem Header="Propiedades (Inspector)…"
                                                          Command="{Binding PlacementTarget.Tag.InspectMediaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Abrir ubicación del archivo"
                                                          Command="{Binding PlacementTarget.Tag.OpenMediaLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="Quitar de la biblioteca"
                                                          Command="{Binding PlacementTarget.Tag.DeleteMediaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="card" Width="98" Height="56" CornerRadius="4"
                                                        Background="#10141E"
                                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                        Tag="{Binding DataContext, ElementName=MediaScroll}"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                                        <Border Background="#66000000" VerticalAlignment="Bottom" Padding="4,1">
                                                            <TextBlock Text="{Binding Name}" FontSize="9" Foreground="White"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                        <TextBlock Text="🎞" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="Collapsed" x:Name="videoIcon"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Video">
                                                        <Setter TargetName="videoIcon" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
            </Border>
        </Grid>

        <!-- ══ Barra de estado ══ -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   Margin="14,8,14,10" TextWrapping="Wrap"/>
    </Grid>
</Window>
