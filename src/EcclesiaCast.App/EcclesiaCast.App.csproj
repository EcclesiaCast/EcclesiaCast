<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- El SDK de Windows habilita Windows.Data.Pdf, que dibuja las páginas
         de un PDF sin agregar ninguna dependencia al instalador. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Regenerate with installer\make-icon.ps1 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Sólo para achicar el cuadro de video del panel LIVE sin copiarlo
         entero (VlcVideoSurface). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- .NET 9 turns CET (a Windows stack protection) on by default. It stays off,
         as it was with .NET 8, until VLC, Whisper and WebView2 are tried with CET
         on: the Windows version must not get worse. -->
    <CETCompat>false</CETCompat>
    <AssemblyTitle>EcclesiaCast</AssemblyTitle>
    <Product>EcclesiaCast</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for Screen (monitor enumeration); its
         implicit global usings collide with WPF types, so remove them. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EcclesiaCast.Core\EcclesiaCast.Core.csproj" />
    <ProjectReference Include="..\EcclesiaCast.Data\EcclesiaCast.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <!-- The speech recogniser for video cards (Vulkan) also brings its Linux
       files, 58 MB the installer does not need. -->
  <Target Name="LeaveOutLinuxSpeechFiles" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy(&apos;%(None.TargetPath)&apos;).StartsWith(&apos;runtimes/vulkan/linux&apos;))" />
    </ItemGroup>
  </Target>

</Project>
