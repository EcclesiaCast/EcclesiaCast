<Window x:Class="EcclesiaCast.App.Views.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText"
                   FontSize="13" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <!-- Una opción por botón, llenados desde el código -->
        <StackPanel x:Name="OptionsPanel"/>

        <!-- Sólo cuando la pregunta se repite en una tanda -->
        <CheckBox x:Name="RememberBox" Visibility="Collapsed" Margin="0,14,0,0"
                  Foreground="{StaticResource MutedBrush}"/>

        <Button Content="Cancelar" Style="{StaticResource DarkButton}" IsCancel="True"
                Padding="18,9" Margin="0,14,0,0" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
