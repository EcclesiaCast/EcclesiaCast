<Window x:Class="EcclesiaCast.App.Views.RemoteControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controlar desde el celular"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="22">
        <TextBlock Text="Control desde el celular"
                   FontSize="17" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock Text="El celular tiene que estar en la misma red wifi que esta computadora."
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,6,0,0"/>

        <Border Background="White" CornerRadius="8" Padding="12"
                HorizontalAlignment="Center" Margin="0,16,0,0">
            <Image x:Name="QrImage" Width="200" Height="200"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <TextBlock Text="Escaneá el código, o escribí esta dirección en el navegador del celular:"
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,14,0,6" TextAlignment="Center"/>

        <TextBox x:Name="AddressBox" IsReadOnly="True"
                 Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                 BorderBrush="{StaticResource LineBrush}"
                 FontSize="18" Padding="10,8" TextAlignment="Center"
                 HorizontalAlignment="Center" MinWidth="240"
                 ToolTip="Podés copiarla y mandársela por mensaje a quien vaya a manejar"/>

        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="PIN" FontSize="11" Foreground="{StaticResource FaintBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="PinText" Text="0000"
                           FontSize="34" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center"
                           FontFamily="Consolas"/>
                <TextBlock Text="Se pide una sola vez en cada celular."
                           FontSize="11" Foreground="{StaticResource FaintBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Salida limpia para el que transmite -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Para la transmisión (OBS o vMix)"
                           FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Pegá esta dirección en un «Browser Source» de OBS o en un «Web Input» de vMix: sale la letra sola, con el fondo transparente, para ponerla encima de la cámara."
                           FontSize="11" Foreground="{StaticResource FaintBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,6"/>
                <TextBox x:Name="BroadcastBox" IsReadOnly="True"
                         Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                         BorderBrush="{StaticResource LineBrush}"
                         FontSize="12" Padding="8,6" TextWrapping="Wrap"
                         ToolTip="Agregale «&amp;fondo=negro» al final si tu programa no maneja transparencia"/>
                <Button Content="Copiar la dirección" Style="{StaticResource DarkButton}"
                        FontSize="11" Padding="10,4" Margin="0,8,0,0"
                        HorizontalAlignment="Left" Click="CopyBroadcast_Click"/>

                <TextBlock Text="¿Querés cada cosa en su propia capa de la transmisión? Hay una dirección para cada una: la Biblia, las canciones y los anuncios (texto rápido, imágenes, videos, el aviso al pie y la cuenta regresiva). Así podés mostrar u ocultar cada una por separado."
                           FontSize="11" Foreground="{StaticResource FaintBrush}"
                           TextWrapping="Wrap" Margin="0,12,0,6"/>
                <WrapPanel>
                    <Button Content="Copiar: Biblia" Tag="Bible" Style="{StaticResource DarkButton}"
                            FontSize="11" Padding="10,4" Margin="0,0,6,0" Click="CopyChannel_Click"/>
                    <Button Content="Copiar: Canciones" Tag="Songs" Style="{StaticResource DarkButton}"
                            FontSize="11" Padding="10,4" Margin="0,0,6,0" Click="CopyChannel_Click"/>
                    <Button Content="Copiar: Anuncios" Tag="Announcements" Style="{StaticResource DarkButton}"
                            FontSize="11" Padding="10,4" Click="CopyChannel_Click"
                            ToolTip="Con el video se oye el sonido en la transmisión sólo si agregás «&amp;sonido=1» al final: por defecto va sin sonido para no repetir el que sale por el proyector."/>
                </WrapPanel>
                <TextBlock x:Name="ChannelCopied" FontSize="11" Foreground="{StaticResource AccentSoftBrush}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="FirewallNote"
                   Text="La primera vez, Windows puede preguntar si permitís que EcclesiaCast use la red: aceptá para redes privadas."
                   FontSize="11" Foreground="{StaticResource FaintBrush}"
                   TextWrapping="Wrap" Margin="0,14,0,0"/>

        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Left" Content="Apagar el control remoto"
                    Style="{StaticResource DarkButton}" Padding="14,8"
                    Click="Stop_Click"
                    ToolTip="Deja de escuchar en la red hasta que lo vuelvas a prender"/>
            <Button HorizontalAlignment="Right" Content="Listo"
                    Style="{StaticResource AccentButton}" Padding="24,8"
                    IsDefault="True" Click="Done_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
