<Window x:Class="EcclesiaCast.App.Views.ThemeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EcclesiaCast.App.Controls"
        xmlns:converters="clr-namespace:EcclesiaCast.App.Converters"
        Title="{Binding WindowTitle}"
        Width="1240" Height="790"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrush"/>
        <converters:IndexToVisibilityConverter x:Key="IndexToVis"/>

        <!-- Lo que se pone detrás de la vista previa para probar un tema de
             fondo transparente: una «foto» oscura y una clara. -->
        <LinearGradientBrush x:Key="PhotoDarkBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#16223F" Offset="0"/>
            <GradientStop Color="#3B2A5C" Offset="0.55"/>
            <GradientStop Color="#B8643A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PhotoLightBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#CFE0F2" Offset="0"/>
            <GradientStop Color="#F6E7C6" Offset="0.6"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBox" x:Key="Field">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <!-- Título de un grupo dentro de una sección (Sombra, Contorno, Franjas) -->
        <Style TargetType="TextBlock" x:Key="GroupTitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,16,0,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <!-- Rótulo corto a la izquierda de un campo (Intensidad, Grosor…) -->
        <Style TargetType="TextBlock" x:Key="SideLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="74"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,14,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Botón que queda apretado (negrita, cursiva, ver la caja…) -->
        <Style TargetType="ToggleButton" x:Key="SegToggle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="4"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2C303C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Opciones de las que se elige una (alineación, tipo, fondo de prueba) -->
        <Style TargetType="RadioButton" x:Key="SegRadio">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="4"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2C303C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Las secciones del editor (Letra, Fondo…): una pastilla por sección -->
        <Style TargetType="RadioButton" x:Key="SectionPill" BasedOn="{StaticResource TabButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="GroupName" Value="ThemeSections"/>
        </Style>

        <!-- Un lugar de la pantalla donde puede ir la leyenda -->
        <Style TargetType="RadioButton" x:Key="SpotRadio">
            <Setter Property="GroupName" Value="CaptionSpot"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="3" Background="#333847"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A5166"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Una plantilla lista: su dibujo y su nombre -->
        <Style TargetType="Button" x:Key="PresetCardButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Padding="4"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Lista de temas ── -->
        <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource Panel}"
                Visibility="{Binding IsThemeMode, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <!-- Sólo con el tema principal de las canciones elegido: editarlo no toca
                     las canciones con tema propio; este botón sí. -->
                <Button DockPanel.Dock="Bottom" Content="Aplicar a todas las canciones…"
                        Style="{StaticResource DarkButton}" FontSize="11" Padding="8,5" Margin="12,6,12,10"
                        Command="{Binding ApplyToAllSongsCommand}"
                        Visibility="{Binding IsMainSongTheme, Converter={StaticResource BoolToVis}}"
                        ToolTip="Guarda este tema y hace que todas las canciones lo sigan, también las que tienen tema propio. Antes pregunta."/>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,8,10,6">
                        <Button Content="➕" FontSize="11" Padding="6,3"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding NewThemeCommand}" ToolTip="Nuevo tema"/>
                        <Button Content="⧉" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding DuplicateThemeCommand}"
                                ToolTip="Duplicar: una copia de lo que se ve, para probar sin tocar el original"/>
                        <Button Content="🗑" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Command="{Binding DeleteThemeCommand}" ToolTip="Eliminar tema"/>
                    </StackPanel>
                    <TextBlock Text="TEMAS" Style="{StaticResource PanelTitle}"/>
                </DockPanel>
                <ListBox ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                                BorderBrush="Transparent" BorderThickness="1"
                                                Margin="6,1" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <!-- Cómo se ve el tema, sobre una «foto» para los de fondo transparente -->
                                <Border DockPanel.Dock="Left" Width="76" Height="42.75" Margin="0,0,10,0"
                                        Background="{StaticResource PhotoDarkBrush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        ClipToBounds="True">
                                    <controls:SlideView Slide="{Binding Preview}" IsHitTestVisible="False"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="White"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding KindLabel}" FontSize="10.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                                    <TextBlock Text="{Binding DefaultLabel}" FontSize="10.5"
                                               Foreground="{StaticResource AccentSoftBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ── Tema de una canción ── -->
        <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource Panel}"
                Visibility="{Binding IsSongMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="TEMA DE LA CANCIÓN" Style="{StaticResource PanelTitle}"/>
                <StackPanel Margin="12,0,12,12">
                    <TextBlock Text="Partir de" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,3"/>
                    <ComboBox ItemsSource="{Binding SongThemeOptions}"
                              SelectedItem="{Binding SelectedSongThemeOption}"
                              DisplayMemberPath="Label" FontSize="12"
                              AutomationProperties.Name="Partir de"
                              ToolTip="El tema que toma la canción. Si después cambiás algo, queda como tema propio de la canción."/>
                    <TextBlock Text="{Binding SongThemeNote}" TextWrapping="Wrap" FontSize="12"
                               Foreground="White" Margin="0,12,0,0"/>
                    <Button Content="↺ Volver al tema principal" Style="{StaticResource DarkButton}"
                            FontSize="11" Padding="8,5" Margin="0,14,0,0"
                            Command="{Binding ReturnToMainThemeCommand}"
                            Visibility="{Binding CanReturnToMain, Converter={StaticResource BoolToVis}}"
                            ToolTip="La canción deja su tema y vuelve a seguir al principal"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Vista previa y plantillas ── -->
        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="220"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MaxHeight="318"/>
            </Grid.RowDefinitions>

            <!-- Vista previa con caja arrastrable -->
            <Border Grid.Row="0" Background="#0B0D12" CornerRadius="6"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Viewbox Stretch="Uniform" Margin="6">
                    <Grid Width="960" Height="540" ClipToBounds="True">
                        <Rectangle>
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="{StaticResource CheckerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackdropIndex}" Value="1">
                                            <Setter Property="Fill" Value="{StaticResource PhotoDarkBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BackdropIndex}" Value="2">
                                            <Setter Property="Fill" Value="{StaticResource PhotoLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <controls:SlideView Slide="{Binding PreviewSlide}" AnimateTransitions="{Binding AnimatePreview}"/>
                        <Canvas x:Name="Overlay" Background="Transparent">
                            <Border x:Name="BoxBorder"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                                    Background="#11FFFFFF" Cursor="SizeAll"
                                    Focusable="True"
                                    Visibility="{Binding ShowBox, Converter={StaticResource BoolToVis}}"
                                    MouseLeftButtonDown="Box_MouseDown"
                                    MouseMove="Box_MouseMove"
                                    MouseLeftButtonUp="Box_MouseUp"
                                    PreviewKeyDown="Box_KeyDown"
                                    ToolTip="Arrastrá para mover · manijas para el tamaño · flechas para ajuste fino">
                                <Grid>
                                    <Thumb Style="{StaticResource BoxHandle}" Tag="NW" Cursor="SizeNWSE"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6" DragDelta="Handle_DragDelta"/>
                                    <Thumb Style="{StaticResource BoxHandle}" Tag="N" Cursor="SizeNS"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0" DragDelta="Handle_DragDelta"/>
                                    <Thumb Style="{StaticResource BoxHandle}" Tag="NE" Cursor="SizeNESW"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-6" DragDelta="Handle_DragDelta"/>
                                    <Thumb Style="{StaticResource BoxHandle}" Tag="W" Cursor="SizeWE"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0" DragDelta="Handle_DragDelta"/>
                                    <Thumb Style="{StaticResource BoxHandle}" Tag="E" Cursor="SizeWE"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-6,0" DragDelta="Handle_DragDelta"/>
                                    <Thumb Style="{StaticResource BoxHandle}" Tag="SW" Cursor="SizeNESW"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6" DragDelta="Handle_DragDelta"/>
                                    <Thumb Style="{StaticResource BoxHandle}" Tag="S" Cursor="SizeNS"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-6" DragDelta="Handle_DragDelta"/>
                                    <Thumb Style="{StaticResource BoxHandle}" Tag="SE" Cursor="SizeNWSE"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-6" DragDelta="Handle_DragDelta"/>
                                </Grid>
                            </Border>
                        </Canvas>
                    </Grid>
                </Viewbox>
            </Border>

            <!-- Con qué se mira la vista previa, y la caja -->
            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                    <TextBlock Text="Probar sobre" FontSize="11" VerticalAlignment="Center" Margin="2,0,8,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <RadioButton Content="Tablero" Style="{StaticResource SegRadio}" GroupName="Backdrop"
                                 IsChecked="{Binding BackdropIndex, Converter={StaticResource IndexIs}, ConverterParameter=0}"
                                 ToolTip="El tablero marca dónde el tema deja ver lo que haya detrás"/>
                    <RadioButton Content="Foto oscura" Style="{StaticResource SegRadio}" GroupName="Backdrop"
                                 IsChecked="{Binding BackdropIndex, Converter={StaticResource IndexIs}, ConverterParameter=1}"
                                 ToolTip="Cómo se lee la letra sobre un video o una foto oscuros"/>
                    <RadioButton Content="Foto clara" Style="{StaticResource SegRadio}" GroupName="Backdrop"
                                 IsChecked="{Binding BackdropIndex, Converter={StaticResource IndexIs}, ConverterParameter=2}"
                                 ToolTip="Cómo se lee la letra sobre un video o una foto claros"/>
                    <ToggleButton Content="Texto largo" Style="{StaticResource SegToggle}" Margin="8,0,4,0"
                                  IsChecked="{Binding LongSample}"
                                  ToolTip="Muestra cuatro renglones o un versículo entero, para ver hasta dónde se achica la letra"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ToggleButton Content="Ver la caja" Style="{StaticResource SegToggle}"
                                  IsChecked="{Binding ShowBox}"
                                  ToolTip="Muestra u oculta la caja del texto, para ver el tema limpio"/>
                    <Button Content="Centrar ↔" Style="{StaticResource DarkButton}" FontSize="11" Padding="8,4"
                            Click="CenterBoxH_Click" ToolTip="Centrar la caja a lo ancho"/>
                    <Button Content="Centrar ↕" Style="{StaticResource DarkButton}" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                            Click="CenterBoxV_Click" ToolTip="Centrar la caja a lo alto"/>
                    <Button Content="Caja completa" Style="{StaticResource DarkButton}" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                            Command="{Binding ResetBoxCommand}"
                            ToolTip="La caja vuelve a ocupar toda la pantalla, con los márgenes de siempre"/>
                </StackPanel>
            </WrapPanel>

            <!-- Plantillas listas -->
            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,10,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock DockPanel.Dock="Right" Text="Un clic la pone; después se retoca a la derecha"
                                   FontSize="11" Foreground="{StaticResource FaintBrush}"
                                   VerticalAlignment="Center" Margin="0,2,12,0"/>
                        <TextBlock Text="PLANTILLAS LISTAS" Style="{StaticResource PanelTitle}"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,2,6">
                        <ItemsControl ItemsSource="{Binding PresetCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PresetCardButton}"
                                            ToolTip="{Binding Preset.Description}"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Width="118">
                                            <Border Width="118" Height="66.4" ClipToBounds="True"
                                                    Background="{StaticResource PhotoDarkBrush}">
                                                <controls:SlideView Slide="{Binding Preview}" IsHitTestVisible="False"/>
                                            </Border>
                                            <TextBlock Text="{Binding Preset.Name}" FontSize="11" Foreground="White"
                                                       TextTrimming="CharacterEllipsis" Margin="1,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── Los campos del tema, por sección ── -->
        <Border Grid.Column="4" Grid.Row="0" Style="{StaticResource Panel}">
            <DockPanel Margin="14,4,8,10">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,6,0">
                    <!-- El tema propio de una canción no lleva nombre ni tipo: es de esa canción. -->
                    <StackPanel Visibility="{Binding IsThemeMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Nombre del tema" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Field}" Text="{Binding ThemeName, UpdateSourceTrigger=PropertyChanged}"/>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Es para" Style="{StaticResource SideLabel}" Width="58"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Canciones" Style="{StaticResource SegRadio}" GroupName="Kind"
                                         IsChecked="{Binding KindIndex, Converter={StaticResource IndexIs}, ConverterParameter=0}"/>
                            <RadioButton Content="Biblia" Style="{StaticResource SegRadio}" GroupName="Kind"
                                         IsChecked="{Binding KindIndex, Converter={StaticResource IndexIs}, ConverterParameter=1}"
                                         ToolTip="Un tema de Biblia suma lo de la cita, el número de versículo y la segunda versión"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,10"/>
                    </StackPanel>

                    <WrapPanel>
                        <RadioButton Content="Letra" Style="{StaticResource SectionPill}"
                                     IsChecked="{Binding SectionIndex, Converter={StaticResource IndexIs}, ConverterParameter=0}"/>
                        <RadioButton Content="Sombra y franjas" Style="{StaticResource SectionPill}"
                                     IsChecked="{Binding SectionIndex, Converter={StaticResource IndexIs}, ConverterParameter=1}"/>
                        <RadioButton Content="Fondo" Style="{StaticResource SectionPill}"
                                     IsChecked="{Binding SectionIndex, Converter={StaticResource IndexIs}, ConverterParameter=2}"/>
                        <RadioButton Content="Leyenda" Style="{StaticResource SectionPill}"
                                     IsChecked="{Binding SectionIndex, Converter={StaticResource IndexIs}, ConverterParameter=3}"/>
                        <RadioButton Content="Transición" Style="{StaticResource SectionPill}"
                                     IsChecked="{Binding SectionIndex, Converter={StaticResource IndexIs}, ConverterParameter=4}"/>
                        <RadioButton Content="Biblia" Style="{StaticResource SectionPill}"
                                     Visibility="{Binding IsBibleKind, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding SectionIndex, Converter={StaticResource IndexIs}, ConverterParameter=5}"/>
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,8,0">

                        <!-- 0 · Letra -->
                        <StackPanel Visibility="{Binding SectionIndex, Converter={StaticResource IndexToVis}, ConverterParameter=0}">
                            <TextBlock Text="Tipografía" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
                            <ComboBox x:Name="FontCombo" IsEditable="True" FontSize="12"
                                      Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" Width="170" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Santo 123" FontFamily="{Binding}" FontSize="15"
                                                       VerticalAlignment="Center" Opacity="0.85"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tamaño de la letra" Style="{StaticResource FieldLabel}"/>
                                    <controls:NumericField Minimum="10" Maximum="400" Step="1" HorizontalAlignment="Left"
                                                           Value="{Binding MaxFontSize}"
                                                           ToolTip="El tamaño que se usa cuando el texto entra. En puntos, sobre una pantalla de 1920 × 1080"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Se achica hasta" Style="{StaticResource FieldLabel}"/>
                                    <controls:NumericField Minimum="8" Maximum="200" Step="1" HorizontalAlignment="Left"
                                                           Value="{Binding MinFontSize}"
                                                           ToolTip="Si el texto es largo la letra se achica sola, pero nunca menos que esto"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Estilo" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Content="Negrita" FontWeight="Bold" Style="{StaticResource SegToggle}"
                                              IsChecked="{Binding Bold}"/>
                                <ToggleButton Content="Cursiva" FontStyle="Italic" Style="{StaticResource SegToggle}"
                                              IsChecked="{Binding Italic}"/>
                            </StackPanel>

                            <TextBlock Text="Color de la letra" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Padding="4" Margin="0,0,6,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding PickTextColorCommand}" ToolTip="Elegir el color">
                                    <Border Width="38" Height="18" CornerRadius="3"
                                            Background="{Binding TextColor, Converter={StaticResource HexToBrush}}"
                                            BorderBrush="#66FFFFFF" BorderThickness="1"/>
                                </Button>
                                <TextBox Style="{StaticResource Field}" Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="El código del color, por si lo querés copiar o pegar"/>
                            </DockPanel>

                            <TextBlock Text="Alineación" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Izquierda" Style="{StaticResource SegRadio}" GroupName="AlignH"
                                             IsChecked="{Binding AlignHIndex, Converter={StaticResource IndexIs}, ConverterParameter=0}"/>
                                <RadioButton Content="Centro" Style="{StaticResource SegRadio}" GroupName="AlignH"
                                             IsChecked="{Binding AlignHIndex, Converter={StaticResource IndexIs}, ConverterParameter=1}"/>
                                <RadioButton Content="Derecha" Style="{StaticResource SegRadio}" GroupName="AlignH"
                                             IsChecked="{Binding AlignHIndex, Converter={StaticResource IndexIs}, ConverterParameter=2}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton Content="Arriba" Style="{StaticResource SegRadio}" GroupName="AlignV"
                                             IsChecked="{Binding AlignVIndex, Converter={StaticResource IndexIs}, ConverterParameter=0}"/>
                                <RadioButton Content="Al medio" Style="{StaticResource SegRadio}" GroupName="AlignV"
                                             IsChecked="{Binding AlignVIndex, Converter={StaticResource IndexIs}, ConverterParameter=1}"/>
                                <RadioButton Content="Abajo" Style="{StaticResource SegRadio}" GroupName="AlignV"
                                             IsChecked="{Binding AlignVIndex, Converter={StaticResource IndexIs}, ConverterParameter=2}"/>
                            </StackPanel>

                            <TextBlock Text="Mayúsculas" Style="{StaticResource FieldLabel}"/>
                            <ComboBox SelectedIndex="{Binding CaseIndex}" FontSize="12"
                                      ToolTip="Cómo se proyecta la letra, sin tocar el texto guardado">
                                <ComboBoxItem Content="Como está escrito"/>
                                <ComboBoxItem Content="TODAS MAYÚSCULAS"/>
                                <ComboBoxItem Content="Mayúscula En Cada Palabra"/>
                                <ComboBoxItem Content="Mayúscula inicial (como oración)"/>
                                <ComboBoxItem Content="todas minúsculas"/>
                            </ComboBox>

                            <CheckBox Content="Cada renglón en una sola línea" IsChecked="{Binding FitToWidth}" Margin="0,12,0,0"
                                      ToolTip="Achica la letra hasta que ningún renglón se parta en dos"/>
                            <TextBlock Text="Dónde va el texto se decide arrastrando la caja en la vista previa."
                                       Style="{StaticResource Hint}"/>
                        </StackPanel>

                        <!-- 1 · Sombra y franjas -->
                        <StackPanel Visibility="{Binding SectionIndex, Converter={StaticResource IndexToVis}, ConverterParameter=1}">
                            <TextBlock Text="Tres ayudas para que la letra se lea sobre cualquier fondo."
                                       Style="{StaticResource Hint}" Margin="0,2,0,0"/>

                            <TextBlock Text="Sombra" Style="{StaticResource GroupTitle}" Margin="0,12,0,2"/>
                            <CheckBox Content="Sombra bajo la letra" IsChecked="{Binding Shadow}"/>
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding Shadow}" Margin="0,4,0,0">
                                <TextBlock Text="Intensidad" Style="{StaticResource SideLabel}"/>
                                <controls:NumericField Minimum="0" Maximum="100" Step="5"
                                                       Value="{Binding ShadowOpacityPercent}"
                                                       ToolTip="0 % = invisible · 100 % = negro pleno"/>
                                <TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{StaticResource FaintBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding Shadow}" Margin="0,6,0,0">
                                <TextBlock Text="Difusión" Style="{StaticResource SideLabel}"/>
                                <controls:NumericField Minimum="0" Maximum="80" Step="1"
                                                       Value="{Binding ShadowBlur}"
                                                       ToolTip="Chico = sombra dura y marcada · grande = difuminada"/>
                            </StackPanel>

                            <TextBlock Text="Contorno" Style="{StaticResource GroupTitle}"
                                       ToolTip="Un borde alrededor de cada letra: la salva cuando el fondo tiene el mismo color que el texto"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Grosor" Style="{StaticResource SideLabel}"/>
                                <controls:NumericField Minimum="0" Maximum="40" Step="1"
                                                       Value="{Binding OutlineWidth}"
                                                       ToolTip="0 = sin contorno"/>
                            </StackPanel>
                            <DockPanel Margin="0,6,0,0"
                                       IsEnabled="{Binding OutlineWidth, Converter={StaticResource NonZeroToBool}}">
                                <TextBlock DockPanel.Dock="Left" Text="Color" Style="{StaticResource SideLabel}"/>
                                <Button DockPanel.Dock="Left" Padding="4" Margin="0,0,6,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding PickOutlineColorCommand}" ToolTip="Elegir el color">
                                    <Border Width="38" Height="18" CornerRadius="3"
                                            Background="{Binding OutlineColor, Converter={StaticResource HexToBrush}}"
                                            BorderBrush="#66FFFFFF" BorderThickness="1"/>
                                </Button>
                                <TextBox Style="{StaticResource Field}" Text="{Binding OutlineColor, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <TextBlock Text="Franjas detrás de cada renglón" Style="{StaticResource GroupTitle}"
                                       ToolTip="Una franja de color detrás de cada renglón, como un subtítulo: la letra se lee sobre cualquier video o foto"/>
                            <ComboBox SelectedIndex="{Binding LineBandIndex}" FontSize="12" Margin="0,4,0,0">
                                <ComboBoxItem Content="Sin franjas"/>
                                <ComboBoxItem Content="Al ancho del texto"/>
                                <ComboBoxItem Content="De borde a borde de la pantalla"/>
                            </ComboBox>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button Content="Negras, letra blanca" FontSize="11" Padding="6,5" Margin="0,0,3,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding SetLineBandShadeCommand}" CommandParameter="black"/>
                                <Button Content="Blancas, letra negra" FontSize="11" Padding="6,5" Margin="3,0,0,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding SetLineBandShadeCommand}" CommandParameter="white"/>
                            </UniformGrid>
                            <DockPanel Margin="0,6,0,0"
                                       IsEnabled="{Binding LineBandIndex, Converter={StaticResource NonZeroToBool}}">
                                <TextBlock DockPanel.Dock="Left" Text="Color" Style="{StaticResource SideLabel}"/>
                                <Button DockPanel.Dock="Left" Padding="4" Margin="0,0,6,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding PickLineBandColorCommand}" ToolTip="Elegir el color">
                                    <Border Width="38" Height="18" CornerRadius="3"
                                            Background="{Binding LineBandColor, Converter={StaticResource HexToBrush}}"
                                            BorderBrush="#66FFFFFF" BorderThickness="1"/>
                                </Button>
                                <TextBox Style="{StaticResource Field}" Text="{Binding LineBandColor, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                        IsEnabled="{Binding LineBandIndex, Converter={StaticResource NonZeroToBool}}">
                                <TextBlock Text="Opacidad" Style="{StaticResource SideLabel}"/>
                                <controls:NumericField Minimum="10" Maximum="100" Step="5" Decimals="0"
                                                       Value="{Binding LineBandOpacityPercent}"
                                                       ToolTip="100 = franja llena · menos = se ve el fondo a través"/>
                                <TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{StaticResource FaintBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 2 · Fondo -->
                        <StackPanel Visibility="{Binding SectionIndex, Converter={StaticResource IndexToVis}, ConverterParameter=2}">
                            <CheckBox Content="Fondo transparente" IsChecked="{Binding TransparentBackground}" Margin="0,8,0,0"/>
                            <TextBlock Text="Con el fondo transparente, detrás de la letra se ve el video o la imagen que pongas desde Medios. Es lo que conviene casi siempre."
                                       Style="{StaticResource Hint}" Margin="0,2,0,0"/>

                            <StackPanel IsEnabled="{Binding TransparentBackground, Converter={StaticResource InverseBool}}">
                                <TextBlock Text="Color de fondo" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Padding="4" Margin="0,0,6,0"
                                            Style="{StaticResource DarkButton}"
                                            Command="{Binding PickBackgroundColorCommand}" ToolTip="Elegir el color">
                                        <Border Width="38" Height="18" CornerRadius="3"
                                                Background="{Binding BackgroundColor, Converter={StaticResource HexToBrush}}"
                                                BorderBrush="#66FFFFFF" BorderThickness="1"/>
                                    </Button>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>

                            <TextBlock Text="Imagen de fondo propia del tema" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" FontSize="11" Padding="7,3" Margin="4,0,0,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding ClearBackgroundImageCommand}" ToolTip="Quitar la imagen"/>
                                <Button DockPanel.Dock="Right" Content="Examinar…" FontSize="11" Padding="8,3" Margin="6,0,0,0"
                                        Style="{StaticResource DarkButton}"
                                        Command="{Binding BrowseBackgroundImageCommand}"/>
                                <TextBox Style="{StaticResource Field}" IsReadOnly="True"
                                         Text="{Binding BackgroundImagePath, Mode=OneWay}"/>
                            </DockPanel>

                            <TextBlock Text="Oscurecer el fondo" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <controls:NumericField Minimum="0" Maximum="100" Step="5"
                                                       Value="{Binding BackgroundDimPercent}"
                                                       ToolTip="Una capa negra sobre el fondo, para que la letra se lea mejor"/>
                                <TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{StaticResource FaintBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 3 · Leyenda -->
                        <StackPanel Visibility="{Binding SectionIndex, Converter={StaticResource IndexToVis}, ConverterParameter=3}">
                            <TextBlock Text="La leyenda es el renglón chico: en las canciones, el título y el autor; en la Biblia, la cita."
                                       Style="{StaticResource Hint}" Margin="0,2,0,6"/>
                            <CheckBox Content="Mostrar la leyenda" IsChecked="{Binding ShowCaption}"/>

                            <StackPanel IsEnabled="{Binding ShowCaption}">
                                <TextBlock Text="Dónde va" Style="{StaticResource FieldLabel}"/>
                                <!-- Una pantalla chica: se toca el lugar -->
                                <Border HorizontalAlignment="Left" Width="150" Height="84" CornerRadius="5"
                                        Background="#0B0D12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0" Style="{StaticResource SpotRadio}"
                                                     HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Arriba a la izquierda"
                                                     IsChecked="{Binding CaptionPositionIndex, Converter={StaticResource IndexIs}, ConverterParameter=0}"/>
                                        <RadioButton Grid.Column="1" Style="{StaticResource SpotRadio}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Top" ToolTip="Arriba al centro"
                                                     IsChecked="{Binding CaptionPositionIndex, Converter={StaticResource IndexIs}, ConverterParameter=1}"/>
                                        <RadioButton Grid.Column="2" Style="{StaticResource SpotRadio}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Arriba a la derecha"
                                                     IsChecked="{Binding CaptionPositionIndex, Converter={StaticResource IndexIs}, ConverterParameter=2}"/>
                                        <RadioButton Grid.Column="0" Style="{StaticResource SpotRadio}"
                                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" ToolTip="Abajo a la izquierda"
                                                     IsChecked="{Binding CaptionPositionIndex, Converter={StaticResource IndexIs}, ConverterParameter=3}"/>
                                        <RadioButton Grid.Column="1" Style="{StaticResource SpotRadio}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Bottom" ToolTip="Abajo al centro"
                                                     IsChecked="{Binding CaptionPositionIndex, Converter={StaticResource IndexIs}, ConverterParameter=4}"/>
                                        <RadioButton Grid.Column="2" Style="{StaticResource SpotRadio}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="Abajo a la derecha"
                                                     IsChecked="{Binding CaptionPositionIndex, Converter={StaticResource IndexIs}, ConverterParameter=5}"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Tamaño" Style="{StaticResource FieldLabel}"/>
                                <controls:NumericField Minimum="10" Maximum="160" Step="1" HorizontalAlignment="Left"
                                                       Value="{Binding CaptionFontSize}"/>

                                <TextBlock Text="Tipografía" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CaptionFontCombo" IsEditable="True" FontSize="12"
                                          Text="{Binding CaptionFontFamily, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                </ComboBox>

                                <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Padding="4" Margin="0,0,6,0"
                                            Style="{StaticResource DarkButton}"
                                            Command="{Binding PickCaptionColorCommand}" ToolTip="Elegir el color">
                                        <Border Width="38" Height="18" CornerRadius="3"
                                                Background="{Binding CaptionColor, Converter={StaticResource HexToBrush}}"
                                                BorderBrush="#66FFFFFF" BorderThickness="1"/>
                                    </Button>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding CaptionColor, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- 4 · Transición -->
                        <StackPanel Visibility="{Binding SectionIndex, Converter={StaticResource IndexToVis}, ConverterParameter=4}">
                            <TextBlock Text="Cómo entra y sale la diapositiva" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
                            <ComboBox SelectedIndex="{Binding TransitionIndex}" FontSize="12"
                                      ToolTip="Cada tema tiene la suya: las canciones pueden fundir y la Biblia cortar">
                                <ComboBoxItem Content="Sin transición (corte)"/>
                                <ComboBoxItem Content="Fundido"/>
                                <ComboBoxItem Content="De costado (entra por la derecha)"/>
                                <ComboBoxItem Content="Hacia arriba (entra por abajo)"/>
                                <ComboBoxItem Content="Se acomoda (zoom)"/>
                            </ComboBox>
                            <TextBlock Text="Cuánto dura" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <controls:NumericField Minimum="0" Maximum="5" Step="0.1" Decimals="2"
                                                       Value="{Binding TransitionSeconds}"
                                                       ToolTip="En segundos. 0,28 es el fundido de siempre; más de 0,5 se siente lento"/>
                                <TextBlock Text="segundos" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <Button Content="▶ Ver ejemplo" FontSize="12" Padding="12,6" Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource DarkButton}"
                                    Command="{Binding PlayTransitionSampleCommand}"
                                    ToolTip="Muestra en la vista previa cómo entra y sale la letra"/>
                            <TextBlock Text="Corta es mejor: una transición lenta hace que la gente llegue tarde a la letra."
                                       Style="{StaticResource Hint}"/>
                        </StackPanel>

                        <!-- 5 · Biblia -->
                        <StackPanel Visibility="{Binding SectionIndex, Converter={StaticResource IndexToVis}, ConverterParameter=5}">
                            <TextBlock Text="La cita y el versículo" Style="{StaticResource GroupTitle}" Margin="0,6,0,2"/>
                            <CheckBox Content="Mostrar la versión junto a la cita" IsChecked="{Binding ShowVersionName}"/>
                            <CheckBox Content="Número de versículo en el texto" IsChecked="{Binding ShowVerseNumbers}"/>
                            <CheckBox Content="Mostrar «Selah» y los títulos de los Salmos" IsChecked="{Binding ShowSelahAndTitles}"
                                      ToolTip="Destildada (lo normal), «Selah» y los títulos de los Salmos que traen algunas Biblias no se proyectan."/>
                            <CheckBox Content="Dividir versículos largos" IsChecked="{Binding SplitLongVerses}"
                                      ToolTip="Un versículo largo pasa en varias diapositivas, con la cita marcada (1/2), (2/2). Se corta de preferencia en un punto, después en una coma, y nunca en medio de una palabra."/>
                            <StackPanel Visibility="{Binding SplitLongVerses, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Máximo de caracteres por diapositiva" Style="{StaticResource FieldLabel}"/>
                                <controls:NumericField Minimum="50" Maximum="500" Step="10" HorizontalAlignment="Left"
                                                       Value="{Binding VerseSplitChars}"
                                                       ToolTip="Cuentan las letras, los espacios y los signos. El tamaño de la letra y «Se achica hasta» siguen valiendo para cada parte."/>
                            </StackPanel>

                            <TextBlock Text="Cuando se proyectan dos versiones" Style="{StaticResource GroupTitle}"/>
                            <CheckBox Content="La segunda se ve igual que la primera"
                                      IsChecked="{Binding SecondaryMatchesPrimary}"/>
                            <StackPanel Visibility="{Binding SecondaryMatchesPrimary, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Tamaño de la segunda (% de la primera)" Style="{StaticResource FieldLabel}"/>
                                <controls:NumericField Minimum="20" Maximum="150" Step="1" HorizontalAlignment="Left"
                                                       Value="{Binding SecondaryScalePercent}"/>
                                <CheckBox Content="En cursiva" IsChecked="{Binding SecondaryItalic}" Margin="0,8,0,0"/>
                                <TextBlock Text="Color de la segunda" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Padding="4" Margin="0,0,6,0"
                                            Style="{StaticResource DarkButton}"
                                            Command="{Binding PickSecondaryColorCommand}" ToolTip="Elegir el color">
                                        <Border Width="38" Height="18" CornerRadius="3"
                                                Background="{Binding SecondaryColor, Converter={StaticResource HexToBrush}}"
                                                BorderBrush="#66FFFFFF" BorderThickness="1"/>
                                    </Button>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding SecondaryColor, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Acciones ── -->
        <DockPanel Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                        Visibility="{Binding IsThemeMode, Converter={StaticResource BoolToVis}}">
                <Button Content="Usar en canciones" Style="{StaticResource DarkButton}"
                        Command="{Binding SetDefaultForSongsCommand}"
                        ToolTip="Este tema pasa a ser el de todas las canciones que no tengan uno propio"/>
                <Button Content="Usar en Biblia" Style="{StaticResource DarkButton}" Margin="6,0,0,0"
                        Command="{Binding SetDefaultForBibleCommand}"
                        ToolTip="Este tema pasa a ser el que usa toda la Biblia"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Deshacer cambios" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                        Command="{Binding RevertChangesCommand}"
                        ToolTip="El tema vuelve a como estaba guardado"/>
                <Button Content="Guardar tema" Style="{StaticResource AccentButton}"
                        Command="{Binding SaveThemeCommand}" Padding="18,8"
                        ToolTip="Guarda y cierra"/>
                <Button Content="Cerrar" Style="{StaticResource DarkButton}" Margin="8,0,0,0"
                        Padding="18,8" IsCancel="True"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,14,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentSoftBrush}"
                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="●  Cambios sin guardar" Foreground="#E8C34A" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
