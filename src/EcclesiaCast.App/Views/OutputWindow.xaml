<Window x:Class="EcclesiaCast.App.Views.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EcclesiaCast.App.Controls"
        Title="EcclesiaCast — Salida"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        Cursor="None"
        Background="Black">
    <Grid>
        <!-- Relleno: se ve donde el fondo no llega (zoom hacia afuera, un
             tamaño fijo más chico, o barras por la proporción) -->
        <Rectangle x:Name="FillColorLayer" Visibility="Collapsed"/>
        <Image x:Name="FillImage" Stretch="UniformToFill" Visibility="Collapsed"/>
        <controls:VlcVideoSurface x:Name="FillVideo" Visibility="Collapsed"/>

        <!-- Video de fondo (frames a WriteableBitmap), detrás de todo -->
        <controls:VlcVideoSurface x:Name="Video"/>

        <!-- YouTube a pantalla completa (solo visible mientras se proyecta) -->
        <controls:YouTubeSurface x:Name="YouTube" Visibility="Collapsed"/>

        <!-- Video del logo: encima del fondo, debajo del texto y del aviso al pie -->
        <controls:VlcVideoSurface x:Name="LogoVideo" Visibility="Collapsed"/>

        <!-- Fondo de imagen + texto + estados, compuesto encima -->
        <controls:ProjectedView x:Name="Projected"
                                Slide="{Binding Slide}"
                                State="{Binding State}"
                                Overlay="{Binding Overlay}"
                                Countdown="{Binding Countdown}"
                                Highlight="{Binding Highlight}"
                                BackgroundMedia="{Binding Background}"
                                FillMedia="{Binding BackgroundFill}"
                                Logo="{Binding ActiveLogo}"
                                IsLiveOutput="True"
                                AnimateTransitions="True"/>
    </Grid>
</Window>
