<Window x:Class="EcclesiaCast.App.Views.TutorialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tutoriales"
        Width="760" Height="680" MinWidth="520" MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <DockPanel Margin="24,20,24,16">
        <Button DockPanel.Dock="Bottom" Content="Cerrar" Style="{StaticResource DarkButton}"
                IsCancel="True" Padding="18,9" Margin="0,14,0,0" HorizontalAlignment="Right"/>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Tutoriales" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Elegí uno: el programa se queda como está y una flecha te va señalando dónde tocar, paso a paso. Cada uno dura un par de minutos."/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="208" Height="150" Margin="0,0,12,12" Padding="0"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Style="{StaticResource DarkButton}" Click="Card_Click"
                                AutomationProperties.Name="{Binding Title}"
                                ToolTip="{Binding Summary}">
                            <StackPanel Width="180" Margin="14,12" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Icon}" FontSize="26"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Summary}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" MaxHeight="48"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
