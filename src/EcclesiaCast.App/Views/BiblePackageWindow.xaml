<Window x:Class="EcclesiaCast.App.Views.BiblePackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" MinWidth="420" MinHeight="320"
        SizeToContent="Height" MaxHeight="640"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="IntroText"
                   FontSize="13" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="4" MinHeight="90">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="VersionsList" Margin="12,8,12,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="White"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" x:Name="WarningBox" Visibility="Collapsed"
                Background="#2A2418" BorderBrush="#7A5A18" BorderThickness="1"
                CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
            <TextBlock x:Name="WarningText" FontSize="12" Foreground="#E8D9A8" TextWrapping="Wrap"/>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource DarkButton}" IsCancel="True" Padding="18,9"/>
                <Button x:Name="AcceptButton" Style="{StaticResource AccentButton}"
                        Click="Accept_Click" Padding="18,9" Margin="10,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Todas" FontSize="11" Padding="10,3"
                        Style="{StaticResource DarkButton}" Click="CheckAll_Click"/>
                <Button Content="Ninguna" FontSize="11" Padding="10,3" Margin="4,0,0,0"
                        Style="{StaticResource DarkButton}" Click="CheckNone_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
