<Window x:Class="EcclesiaCast.App.Views.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EcclesiaCast"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The sign that says what kind of notice this is -->
            <Border x:Name="SignCircle" Width="40" Height="40" CornerRadius="20"
                    VerticalAlignment="Top" Margin="0,2,16,0"
                    Background="{StaticResource AccentBrush}">
                <TextBlock x:Name="SignText" Foreground="White" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>
                <TextBlock x:Name="MessageText" Foreground="{StaticResource MutedBrush}" FontSize="13"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Buttons are added from the code, one per answer -->
        <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,22,0,0"/>
    </StackPanel>
</Window>
