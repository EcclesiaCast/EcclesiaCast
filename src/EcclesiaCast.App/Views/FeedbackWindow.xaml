<Window x:Class="EcclesiaCast.App.Views.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comentarios"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="26,22,26,20">
        <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock x:Name="IntroText" FontSize="13" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,6,0,14"/>

        <TextBlock Text="Qué querés contarnos" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
        <ComboBox x:Name="KindBox" Margin="0,0,0,12"/>

        <TextBlock Text="Tu comentario" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="CommentBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True"
                 Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                 BorderBrush="{StaticResource LineBrush}" CaretBrush="White" Padding="8,6" FontSize="14"/>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tu iglesia (opcional)" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ChurchBox" Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                         BorderBrush="{StaticResource LineBrush}" CaretBrush="White" Padding="8,6" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Correo para responderte (opcional)" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="EmailBox" Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                         BorderBrush="{StaticResource LineBrush}" CaretBrush="White" Padding="8,6" FontSize="14"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="AttachCheck" Foreground="White" FontSize="13" Margin="0,16,0,0"
                  Content="Adjuntar el resumen de uso"
                  ToolTip="Cuántas veces abriste el programa, la versión y los últimos errores. No incluye canciones, nombres ni archivos tuyos."/>
        <TextBlock FontSize="12" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="22,2,0,0">
            <Run Text="Nos ayuda a entender cuánto y cómo se usa. "/>
            <Hyperlink x:Name="PreviewLink" Click="Preview_Click" Foreground="{StaticResource AccentBrush}">Ver qué se envía</Hyperlink>
        </TextBlock>
        <TextBox x:Name="SummaryBox" IsReadOnly="True" Visibility="Collapsed" Height="140" Margin="22,8,0,0"
                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource MutedBrush}"
                 BorderBrush="{StaticResource LineBrush}" Padding="8,6"/>

        <CheckBox x:Name="NeverCheck" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,16,0,0"
                  Content="No volver a mostrar este aviso al cerrar"/>

        <TextBlock x:Name="StatusText" FontSize="13" Foreground="{StaticResource AccentBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SkipButton" Content="Ahora no" Style="{StaticResource DarkButton}" IsCancel="True"
                    Padding="18,9" Click="Skip_Click"/>
            <Button x:Name="SendButton" Content="Enviar" Style="{StaticResource AccentButton}" IsDefault="True"
                    Padding="22,9" Margin="10,0,0,0" Click="Send_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
