<Window x:Class="EcclesiaCast.App.Views.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comentarios"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="26,22,26,20">
        <TextBlock Text="{Binding Heading, Mode=OneTime}" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Intro, Mode=OneTime}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,6,0,14"/>

        <TextBlock Text="Qué querés contarnos" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
        <ComboBox x:Name="KindBox" ItemsSource="{Binding Kinds, Mode=OneTime}" SelectedItem="{Binding Kind}"
                  Margin="0,0,0,12"/>

        <TextBlock Text="Tu comentario" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="CommentBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap"
                 Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                 VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True"
                 Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                 BorderBrush="{StaticResource LineBrush}" CaretBrush="White" Padding="8,6" FontSize="14"/>
        <!-- Sin texto no se puede enviar: con sólo el resumen de uso no se entiende qué pasó -->
        <TextBlock FontSize="12" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap"
                   Margin="0,4,0,0" Visibility="{Binding ShowCommentHint, Converter={StaticResource BoolToVis}}"
                   Text="Escribí aunque sea una frase para poder enviar: con sólo el resumen de uso no sabemos qué pasó ni cómo contestarte."/>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tu iglesia (opcional)" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Church, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                         BorderBrush="{StaticResource LineBrush}" CaretBrush="White" Padding="8,6" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Correo para responderte (opcional)" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                         BorderBrush="{StaticResource LineBrush}" CaretBrush="White" Padding="8,6" FontSize="14"/>
            </StackPanel>
        </Grid>

        <CheckBox IsChecked="{Binding Attach}" Foreground="White" FontSize="13" Margin="0,16,0,0"
                  Content="Adjuntar el resumen de uso"
                  ToolTip="Cuántas veces abriste el programa, la versión y los últimos errores. No incluye canciones, nombres ni archivos tuyos."/>
        <TextBlock FontSize="12" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="22,2,0,0">
            <Run Text="Nos ayuda a entender cuánto y cómo se usa. "/>
            <Hyperlink x:Name="PreviewLink" Click="Preview_Click" Foreground="{StaticResource AccentBrush}">Ver qué se envía</Hyperlink>
        </TextBlock>
        <TextBox Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True" Height="140" Margin="22,8,0,0"
                 Visibility="{Binding IsSummaryVisible, Converter={StaticResource BoolToVis}}"
                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource MutedBrush}"
                 BorderBrush="{StaticResource LineBrush}" Padding="8,6"/>

        <CheckBox IsChecked="{Binding Never}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,16,0,0"
                  Visibility="{Binding OffersNeverAgain, Converter={StaticResource BoolToVis}}"
                  Content="No volver a mostrar este aviso al cerrar"/>

        <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{StaticResource AccentBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Ahora no" Style="{StaticResource DarkButton}" IsCancel="True"
                    IsEnabled="{Binding CanSkip}" Padding="18,9" Click="Skip_Click"/>
            <Button Content="Enviar" Style="{StaticResource AccentButton}" IsDefault="True"
                    IsEnabled="{Binding CanSend}" Padding="22,9" Margin="10,0,0,0" Click="Send_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
