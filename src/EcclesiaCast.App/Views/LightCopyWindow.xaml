<Window x:Class="EcclesiaCast.App.Views.LightCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copia liviana"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontSize="15" Foreground="White" TextWrapping="Wrap"/>

        <TextBlock x:Name="StatusText" Text="Empezando… puede tardar varios minutos, según el largo del video."
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>

        <ProgressBar x:Name="Progress" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="100"
                     Background="{StaticResource SurfaceAltBrush}"
                     Foreground="{StaticResource AccentBrush}"
                     BorderThickness="0"/>

        <TextBlock Text="Tu archivo original no se toca: la copia se guarda aparte y es la que se usa para proyectar."
                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CloseButton" Content="Cancelar" Style="{StaticResource DarkButton}"
                    Padding="20,8" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
