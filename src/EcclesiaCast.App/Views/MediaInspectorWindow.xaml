<Window x:Class="EcclesiaCast.App.Views.MediaInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EcclesiaCast.App.Controls"
        Title="Propiedades del medio"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="L">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,12,0,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="120" Height="68" CornerRadius="4"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                    <Image x:Name="Poster" Stretch="UniformToFill"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Nombre" Style="{StaticResource L}" Margin="0,0,0,3"/>
                    <TextBox x:Name="NameBox" Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                             BorderBrush="{StaticResource LineBrush}" CaretBrush="White" Padding="6,4" FontSize="13"/>
                    <TextBlock x:Name="TypeText" FontSize="11" Foreground="{StaticResource FaintBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="Pestaña" Style="{StaticResource L}"/>
            <ComboBox x:Name="CategoryBox" IsEditable="True"/>

            <TextBlock Text="Comportamiento" Style="{StaticResource L}"/>
            <ComboBox x:Name="BehaviorBox">
                <ComboBoxItem Content="Fondo (detrás del texto, en bucle)"/>
                <ComboBoxItem Content="Primer plano (pantalla completa, tapa el texto)"/>
            </ComboBox>

            <TextBlock Text="Escala (si no es 16:9)" Style="{StaticResource L}"/>
            <ComboBox x:Name="ScalingBox">
                <ComboBoxItem Content="Rellenar (recorta lo que sobra)"/>
                <ComboBoxItem Content="Ajustar (todo, con barras)"/>
                <ComboBoxItem Content="Estirar (deforma)"/>
            </ComboBox>

            <!-- ── Encuadre: zoom, tamaño y relleno ── -->
            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                    Padding="12,4,12,12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Encuadre" Style="{StaticResource L}"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Zoom" FontSize="11" Width="64" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <controls:NumericField x:Name="ZoomField" Minimum="10" Maximum="400" Step="5" Decimals="0"
                                               ToolTip="100 % es como está. Más acerca y recorta; menos aleja y deja ver el relleno."/>
                        <TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <Button Content="Reencuadrar" Style="{StaticResource DarkButton}" FontSize="11"
                                Padding="10,3" Margin="12,0,0,0" Click="ResetFraming_Click"
                                ToolTip="Vuelve a 100 %, centrado y a pantalla completa"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Correr" FontSize="11" Width="64" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <controls:NumericField x:Name="OffsetXField" Minimum="-100" Maximum="100" Step="2" Decimals="0"
                                               ToolTip="Hacia los lados, en % de la pantalla"/>
                        <TextBlock Text="↔" FontSize="12" VerticalAlignment="Center" Margin="6,0,10,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <controls:NumericField x:Name="OffsetYField" Minimum="-100" Maximum="100" Step="2" Decimals="0"
                                               ToolTip="Hacia arriba y abajo, en % de la pantalla"/>
                        <TextBlock Text="↕" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <CheckBox x:Name="FixedSizeCheck" Content="Tamaño fijo en pantalla" Margin="0,12,0,0"
                              Checked="FixedSize_Changed" Unchecked="FixedSize_Changed"
                              ToolTip="Para cuando la pantalla de la iglesia no tiene la forma de la imagen del proyector"/>
                    <StackPanel x:Name="SizeRow" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="False">
                        <TextBlock Text="Medida" FontSize="11" Width="64" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <controls:NumericField x:Name="FrameWidthField" Minimum="16" Maximum="1920" Step="16" Decimals="0"/>
                        <TextBlock Text="×" FontSize="12" VerticalAlignment="Center" Margin="6,0,6,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <controls:NumericField x:Name="FrameHeightField" Minimum="16" Maximum="1080" Step="16" Decimals="0"/>
                        <TextBlock Text="px" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <ComboBox x:Name="PresetBox" Margin="64,6,0,0" FontSize="11"
                              SelectionChanged="Preset_Changed"
                              ToolTip="Medidas comunes, por si no querés escribirlas">
                        <ComboBoxItem Content="Medidas comunes…"/>
                        <ComboBoxItem Content="1920 × 1080 (16:9, toda la pantalla)"/>
                        <ComboBoxItem Content="1280 × 720 (16:9 más chico)"/>
                        <ComboBoxItem Content="1440 × 1080 (4:3)"/>
                        <ComboBoxItem Content="1080 × 1080 (cuadrado)"/>
                        <ComboBoxItem Content="1080 × 1920 (vertical, celular)"/>
                    </ComboBox>

                    <TextBlock Text="Los bordes se rellenan con" Style="{StaticResource L}"/>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="FillSwatch" Width="28" Height="24" CornerRadius="3"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                        <Button Content="Color…" Style="{StaticResource DarkButton}" FontSize="11"
                                Padding="10,3" Margin="8,0,0,0" Click="PickFillColor_Click"/>
                        <ComboBox x:Name="FillMediaBox" Width="180" Margin="8,0,0,0" FontSize="11"
                                  DisplayMemberPath="Name"
                                  ToolTip="O una imagen o video de la biblioteca detrás: el truco de siempre es una copia desenfocada del mismo video"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Color: oscurecer, aclarar, teñir ── -->
            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                    Padding="12,4,12,12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Color" Style="{StaticResource L}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Brillo" FontSize="11" Width="64" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <controls:NumericField x:Name="BrightnessField" Minimum="-100" Maximum="100" Step="5" Decimals="0"
                                               ToolTip="Negativo oscurece (ayuda a leer la letra encima), positivo aclara"/>
                        <TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Tinte" FontSize="11" Width="64" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <Border x:Name="TintSwatch" Width="28" Height="24" CornerRadius="3"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                        <Button Content="Color…" Style="{StaticResource DarkButton}" FontSize="11"
                                Padding="10,3" Margin="8,0,0,0" Click="PickTintColor_Click"/>
                        <controls:NumericField x:Name="TintField" Minimum="0" Maximum="100" Step="5" Decimals="0"
                                               Margin="8,0,0,0"
                                               ToolTip="Cuánto pesa el tinte. 0 = sin tinte."/>
                        <TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel x:Name="TrimOptions">
                <TextBlock Text="Recorte del video (segundos)" Style="{StaticResource L}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Desde" FontSize="11" Width="44" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"/>
                    <controls:NumericField x:Name="TrimStartField" Minimum="0" Maximum="36000" Step="1" Decimals="1"
                                           ToolTip="Saltea el principio: la cortina o el logo con que arrancan muchos videos"/>
                    <TextBlock Text="hasta" FontSize="11" VerticalAlignment="Center" Margin="10,0,6,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <controls:NumericField x:Name="TrimEndField" Minimum="0" Maximum="36000" Step="1" Decimals="1"
                                           ToolTip="0 = hasta el final"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Desenfoque del fondo" Style="{StaticResource L}"/>
            <StackPanel Orientation="Horizontal">
                <controls:NumericField x:Name="BlurField" Minimum="0" Maximum="100" Step="5" Decimals="0"
                                       ToolTip="Difumina este fondo para que la letra encima se lea. 0 = nítido."/>
                <TextBlock Text="%  · también se puede cambiar en vivo desde la barra de medios"
                           FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource FaintBrush}" Margin="8,0,0,0"/>
            </StackPanel>

            <StackPanel x:Name="VideoOptions">
                <TextBlock Text="Al terminar el video" Style="{StaticResource L}"/>
                <ComboBox x:Name="EndBox">
                    <ComboBoxItem Content="Repetir en bucle"/>
                    <ComboBoxItem Content="Detener al final"/>
                    <ComboBoxItem Content="Al terminar, mostrar el logo"/>
                </ComboBox>

                <CheckBox x:Name="MuteCheck" Content="Silenciar audio" Margin="0,14,0,0"/>
                <TextBlock Style="{StaticResource L}">
                    <Run Text="Volumen: "/><Run x:Name="VolValue" Text="100"/>
                </TextBlock>
                <Slider x:Name="VolSlider" Minimum="0" Maximum="100" ValueChanged="Vol_Changed"/>
            </StackPanel>

            <Button Content="📂 Abrir ubicación del archivo" Style="{StaticResource DarkButton}"
                    Click="OpenLocation_Click" Margin="0,16,0,0" HorizontalAlignment="Left" Padding="12,6"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Guardar" Style="{StaticResource AccentButton}" Click="Save_Click" Padding="20,8"/>
            <Button Content="Cancelar" Style="{StaticResource DarkButton}" IsCancel="True" Padding="20,8" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
