<Window x:Class="EcclesiaCast.App.Views.MediaInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EcclesiaCast.App.Controls"
        Title="Propiedades del medio"
        Width="820" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="L">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,12,0,3"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dos columnas: a la izquierda qué es y cómo se encuadra, a la derecha
             cómo se ve y qué pasa después. Una sola columna quedaba más alta
             que la pantalla de una notebook. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Nombre" Style="{StaticResource L}" Margin="0,0,0,3"/>
            <TextBox x:Name="NameBox" Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                     BorderBrush="{StaticResource LineBrush}" CaretBrush="White" Padding="6,4" FontSize="13"/>
            <TextBlock x:Name="TypeText" FontSize="11" Foreground="{StaticResource FaintBrush}" Margin="0,6,0,0"/>

            <TextBlock Text="Pestaña" Style="{StaticResource L}"/>
            <ComboBox x:Name="CategoryBox" IsEditable="True"/>

            <TextBlock Text="Fecha del evento (opcional)" Style="{StaticResource L}"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="EventDateBox" Width="104" Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                         BorderBrush="{StaticResource LineBrush}" CaretBrush="White" Padding="6,4" FontSize="13"
                         TextChanged="EventDateBox_TextChanged"
                         ToolTip="El día del evento que anuncia (por ejemplo 17/10/2026). Vacío: no vence nunca."/>
                <TextBlock Text="se queda" FontSize="11" Margin="10,0,6,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <controls:NumericField x:Name="ArchiveDaysField" ValueChanged="EventDate_Changed" Minimum="0" Maximum="365" Step="1" Decimals="0"
                                       ToolTip="Cuántos días después del evento sigue en esta pestaña antes de pasar a «Eventos pasados»"/>
                <TextBlock Text="días más" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <TextBlock x:Name="EventDateNote" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>

            <TextBlock Text="Comportamiento" Style="{StaticResource L}"/>
            <ComboBox x:Name="BehaviorBox" SelectionChanged="After_Changed">
                <ComboBoxItem Content="Fondo (detrás del texto, en bucle)"/>
                <ComboBoxItem Content="Primer plano (pantalla completa, tapa el texto)"/>
            </ComboBox>

            <TextBlock Text="Escala (si no es 16:9)" Style="{StaticResource L}"/>
            <ComboBox x:Name="ScalingBox" SelectionChanged="Field_SelectionChanged">
                <ComboBoxItem Content="Rellenar (recorta lo que sobra)"/>
                <ComboBoxItem Content="Ajustar (todo, con barras)"/>
                <ComboBoxItem Content="Estirar (deforma)"/>
            </ComboBox>

            <!-- ── Encuadre: zoom, tamaño y relleno ── -->
            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                    Padding="12,4,12,12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Encuadre" Style="{StaticResource L}"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Zoom" FontSize="11" Width="64" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <controls:NumericField x:Name="ZoomField" ValueChanged="Field_Changed" Minimum="10" Maximum="400" Step="5" Decimals="0"
                                               ToolTip="100 % es como está. Más acerca y recorta; menos aleja y deja ver el relleno."/>
                        <TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <Button Content="Reencuadrar" Style="{StaticResource DarkButton}" FontSize="11"
                                Padding="10,3" Margin="12,0,0,0" Click="ResetFraming_Click"
                                ToolTip="Vuelve a 100 %, centrado y a pantalla completa"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Correr" FontSize="11" Width="64" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <controls:NumericField x:Name="OffsetXField" ValueChanged="Field_Changed" Minimum="-1000" Maximum="1000" Step="2" Decimals="1"
                                               ToolTip="Hacia los lados, en % de la pantalla"/>
                        <TextBlock Text="↔" FontSize="12" VerticalAlignment="Center" Margin="6,0,10,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <controls:NumericField x:Name="OffsetYField" ValueChanged="Field_Changed" Minimum="-1000" Maximum="1000" Step="2" Decimals="1"
                                               ToolTip="Hacia arriba y abajo, en % de la pantalla"/>
                        <TextBlock Text="↕" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <CheckBox x:Name="FixedSizeCheck" Content="Tamaño fijo en pantalla" Margin="0,12,0,0"
                              Checked="FixedSize_Changed" Unchecked="FixedSize_Changed"
                              ToolTip="Para cuando la pantalla de la iglesia no tiene la forma de la imagen del proyector"/>
                    <StackPanel x:Name="SizeRow" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="False">
                        <TextBlock Text="Medida" FontSize="11" Width="64" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <controls:NumericField x:Name="FrameWidthField" ValueChanged="Field_Changed" Minimum="16" Maximum="1920" Step="16" Decimals="0"/>
                        <TextBlock Text="×" FontSize="12" VerticalAlignment="Center" Margin="6,0,6,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <controls:NumericField x:Name="FrameHeightField" ValueChanged="Field_Changed" Minimum="16" Maximum="1080" Step="16" Decimals="0"/>
                        <TextBlock Text="px" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <ComboBox x:Name="PresetBox" Margin="64,6,0,0" FontSize="11"
                              SelectionChanged="Preset_Changed"
                              ToolTip="Medidas comunes, por si no querés escribirlas">
                        <ComboBoxItem Content="Medidas comunes…"/>
                        <ComboBoxItem Content="1920 × 1080 (16:9, toda la pantalla)"/>
                        <ComboBoxItem Content="1280 × 720 (16:9 más chico)"/>
                        <ComboBoxItem Content="1440 × 1080 (4:3)"/>
                        <ComboBoxItem Content="1080 × 1080 (cuadrado)"/>
                        <ComboBoxItem Content="1080 × 1920 (vertical, celular)"/>
                    </ComboBox>

                    <TextBlock Text="Los bordes se rellenan con" Style="{StaticResource L}"/>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="FillSwatch" Width="28" Height="24" CornerRadius="3"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                        <Button Content="Color…" Style="{StaticResource DarkButton}" FontSize="11"
                                Padding="10,3" Margin="8,0,0,0" Click="PickFillColor_Click"/>
                        <ComboBox x:Name="FillMediaBox" SelectionChanged="Field_SelectionChanged" Width="180" Margin="8,0,0,0" FontSize="11"
                                  DisplayMemberPath="Name"
                                  ToolTip="O, en lugar del color: la misma imagen desenfocada (así parece una sola imagen, sin bordes), o una imagen o video de la biblioteca detrás"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>

        <StackPanel Grid.Column="2">
            <!-- ── Cómo se va a ver en pantalla ──
                 El mismo dibujo que hace la salida, y se mueve con el mouse:
                 arrastrar corre la imagen, la ruedita hace zoom. Los números
                 de al lado cambian juntos. -->
            <!-- El cuadro es un poco más alto que 16:9: alrededor del rectángulo de
                 la pantalla se ve el resto de la imagen, oscurecido. -->
            <controls:AspectFitBox AspectRatio="1.66" MaxBoxHeight="232">
            <Border x:Name="PreviewFrame" CornerRadius="4" Background="#10141E" Cursor="SizeAll"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True"
                    Focusable="True" FocusVisualStyle="{x:Null}"
                    PreviewKeyDown="PreviewFrame_PreviewKeyDown"
                    MouseLeftButtonDown="PreviewFrame_MouseLeftButtonDown"
                    MouseMove="PreviewFrame_MouseMove"
                    MouseLeftButtonUp="PreviewFrame_MouseLeftButtonUp"
                    MouseWheel="PreviewFrame_MouseWheel"
                    ToolTip="El rectángulo con borde blanco es la pantalla; lo oscurecido queda afuera. Arrastrá para correr la imagen; la ruedita hace zoom. Con el cuadro elegido, las flechas del teclado la corren de a poquito (con Mayús, más).">
                <controls:FramedMediaPreview x:Name="Preview" UseOriginal="True" ShowOutside="True" DecodeWidth="960"/>
            </Border>
            </controls:AspectFitBox>
            <TextBlock Text="Blanco = la pantalla · arrastrá para correr · ruedita = zoom · flechas = ajuste fino (Mayús: más)" FontSize="10"
                       Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0"/>

            <!-- ── Color: oscurecer, aclarar, teñir ── -->
            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                    Padding="12,4,12,12" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Color" Style="{StaticResource L}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Brillo" FontSize="11" Width="64" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <controls:NumericField x:Name="BrightnessField" ValueChanged="Field_Changed" Minimum="-100" Maximum="100" Step="5" Decimals="0"
                                               ToolTip="Negativo oscurece (ayuda a leer la letra encima), positivo aclara"/>
                        <TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Tinte" FontSize="11" Width="64" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <Border x:Name="TintSwatch" Width="28" Height="24" CornerRadius="3"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                        <Button Content="Color…" Style="{StaticResource DarkButton}" FontSize="11"
                                Padding="10,3" Margin="8,0,0,0" Click="PickTintColor_Click"/>
                        <controls:NumericField x:Name="TintField" ValueChanged="Field_Changed" Minimum="0" Maximum="100" Step="5" Decimals="0"
                                               Margin="8,0,0,0"
                                               ToolTip="Cuánto pesa el tinte. 0 = sin tinte."/>
                        <TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel x:Name="TrimOptions">
                <TextBlock Text="Recorte del video (segundos)" Style="{StaticResource L}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Desde" FontSize="11" Width="44" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"/>
                    <controls:NumericField x:Name="TrimStartField" Minimum="0" Maximum="36000" Step="1" Decimals="1"
                                           ToolTip="Saltea el principio: la cortina o el logo con que arrancan muchos videos"/>
                    <TextBlock Text="hasta" FontSize="11" VerticalAlignment="Center" Margin="10,0,6,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <controls:NumericField x:Name="TrimEndField" Minimum="0" Maximum="36000" Step="1" Decimals="1"
                                           ToolTip="0 = hasta el final"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Desenfoque del fondo" Style="{StaticResource L}"/>
            <!-- DockPanel y no StackPanel: así el texto de al lado puede bajar de renglón -->
            <DockPanel LastChildFill="True">
                <controls:NumericField x:Name="BlurField" ValueChanged="Field_Changed" DockPanel.Dock="Left" Minimum="0" Maximum="100" Step="5" Decimals="0"
                                       ToolTip="Difumina este fondo para que la letra encima se lea. 0 = nítido."/>
                <TextBlock Text="%  · también se puede cambiar en vivo desde la barra de medios"
                           FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource FaintBrush}" Margin="8,0,0,0"/>
            </DockPanel>

            <!-- ── Qué sigue después ── -->
            <StackPanel x:Name="VideoOptions">
                <TextBlock Text="Qué sigue cuando termina el video" Style="{StaticResource L}"/>
                <ComboBox x:Name="EndBox" SelectionChanged="After_Changed">
                    <ComboBoxItem Content="Repetir en bucle"/>
                    <ComboBoxItem Content="Nada: queda en el último cuadro"/>
                    <ComboBoxItem Content="Mostrar el logo"/>
                    <ComboBoxItem Content="Seguir con otro medio de la biblioteca"/>
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="ImageOptions">
                <TextBlock Text="Cuánto se ve en primer plano" Style="{StaticResource L}"/>
                <StackPanel Orientation="Horizontal">
                    <controls:NumericField x:Name="ShowSecondsField" Minimum="0" Maximum="3600" Step="1" Decimals="0"
                                           ToolTip="0 = se queda hasta que cambies. Sólo cuenta cuando la imagen va en primer plano."/>
                    <TextBlock Text="segundos (0 = hasta que cambies)" FontSize="11" VerticalAlignment="Center"
                               TextWrapping="Wrap" Foreground="{StaticResource FaintBrush}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="Qué sigue pasados esos segundos" Style="{StaticResource L}"/>
                <ComboBox x:Name="ImageEndBox" SelectionChanged="After_Changed">
                    <ComboBoxItem Content="Nada: sale de la pantalla"/>
                    <ComboBoxItem Content="Mostrar el logo"/>
                    <ComboBoxItem Content="Seguir con otro medio de la biblioteca"/>
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="NextPanel" Visibility="Collapsed">
                <TextBlock Text="Medio que sigue" Style="{StaticResource L}"/>
                <ComboBox x:Name="NextMediaBox"
                          ToolTip="Se elige de la biblioteca; arranca solo cuando termina éste">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding Category, StringFormat='  · {0}'}"
                                           Foreground="{StaticResource FaintBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="AudioOptions">

                <CheckBox x:Name="MuteCheck" Content="Silenciar audio" Margin="0,14,0,0"/>
                <TextBlock Style="{StaticResource L}">
                    <Run Text="Volumen: "/><Run x:Name="VolValue" Text="100"/>
                </TextBlock>
                <Slider x:Name="VolSlider" Minimum="0" Maximum="100" ValueChanged="Vol_Changed"/>
            </StackPanel>

            <Button Content="📂 Abrir ubicación del archivo" Style="{StaticResource DarkButton}"
                    Click="OpenLocation_Click" Margin="0,16,0,0" HorizontalAlignment="Left" Padding="12,6"/>
        </StackPanel>

        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Guardar" Style="{StaticResource AccentButton}" Click="Save_Click" Padding="20,8"/>
            <Button Content="Cancelar" Style="{StaticResource DarkButton}" IsCancel="True" Padding="20,8" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
