<Window x:Class="EcclesiaCast.App.Views.WebSongSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:EcclesiaCast.App.Services"
        Title="Buscar canciones en internet"
        Width="980" Height="680"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Content="Buscar" Style="{StaticResource AccentButton}"
                    Padding="22,0" Margin="8,0,0,0" Click="Search_Click"/>
            <TextBox x:Name="QueryBox"
                     Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                     BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                     FontSize="18" Padding="12,8"
                     PreviewKeyDown="Query_KeyDown"/>
        </DockPanel>

        <TextBlock Grid.Row="1" FontSize="11" Foreground="{StaticResource FaintBrush}"
                   Margin="2,6,0,10" TextWrapping="Wrap"
                   Text="Escribí el nombre, el artista o una frase de la letra y apretá Enter. Busca en musica.com y, como respaldo, en lrclib.net."/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Resultados -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock x:Name="SearchStatusText" DockPanel.Dock="Bottom"
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="12,6,12,10"/>
                    <ListBox x:Name="ResultsList"
                             Background="Transparent" BorderThickness="0" Margin="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="Results_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,4">
                                    <TextBlock DockPanel.Dock="Right" Text="✓"
                                               Foreground="{StaticResource AccentBrush}" FontSize="14"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               ToolTip="Ya la importaste"
                                               Visibility="{Binding Imported, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Hit.Title}" Foreground="White" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Vista previa editable -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Título" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TitleBox"
                                 Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                                 BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                                 Padding="8,6" FontSize="14"
                                 TextChanged="Preview_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Artista" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ArtistBox"
                                 Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                                 BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                                 Padding="8,6" FontSize="14"/>
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,12,0,4">
                    <TextBlock DockPanel.Dock="Right" x:Name="SourceLink" FontSize="11"
                               VerticalAlignment="Bottom" Visibility="Collapsed">
                        <Hyperlink Foreground="{StaticResource AccentBrush}" Click="OpenSource_Click">
                            <Run x:Name="SourceLinkText" Text="Ver en la web"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Letra · cada párrafo es una diapositiva. Revisala antes de importar: podés corregirla acá mismo."/>
                </DockPanel>

                <TextBox Grid.Row="2" x:Name="LyricsBox"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                         BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                         Padding="10,8" FontSize="14"
                         TextChanged="Preview_Changed"
                         services:SpellChecking.Enabled="True"/>

                <TextBlock Grid.Row="3" x:Name="PreviewInfoText" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       MaxWidth="560"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ImportButton" Content="Importar a la biblioteca"
                        Style="{StaticResource AccentButton}" Padding="20,8"
                        IsEnabled="False" Click="Import_Click"/>
                <Button Content="Cerrar" Style="{StaticResource DarkButton}" Padding="20,8"
                        Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
