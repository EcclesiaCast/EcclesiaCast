<Window x:Class="EcclesiaCast.App.Views.LogoManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EcclesiaCast.App.Controls"
        xmlns:services="clr-namespace:EcclesiaCast.App.Services"
        Title="Logos de la iglesia"
        Width="900" Height="640"
        MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,12,0,3"/>
        </Style>
        <Style TargetType="TextBox" x:Key="Field">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,14,0"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Lista de logos ── -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,8,10,6">
                        <Button Content="➕" FontSize="11" Padding="6,3"
                                Style="{StaticResource DarkButton}"
                                Click="New_Click" ToolTip="Nuevo logo"/>
                        <Button Content="⧉" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Click="Duplicate_Click" ToolTip="Duplicar el logo elegido"/>
                        <Button Content="🗑" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Click="Delete_Click" ToolTip="Eliminar el logo elegido"/>
                    </StackPanel>
                    <TextBlock Text="LOGOS" Style="{StaticResource PanelTitle}"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,4,12,10">
                    <Button Content="↑" FontSize="11" Padding="8,3"
                            Style="{StaticResource DarkButton}"
                            Click="MoveUp_Click" ToolTip="Subir en la lista"/>
                    <Button Content="↓" FontSize="11" Padding="8,3" Margin="4,0,0,0"
                            Style="{StaticResource DarkButton}"
                            Click="MoveDown_Click" ToolTip="Bajar en la lista"/>
                </StackPanel>
                <ListBox x:Name="LogosList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="LogosList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                Margin="6,1" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock x:Name="icon" DockPanel.Dock="Left" Text="🖼" FontSize="12" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Video">
                                    <Setter TargetName="icon" Property="Text" Value="🎞"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Text">
                                    <Setter TargetName="icon" Property="Text" Value="🔤"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ── Vista previa + campos ── -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0B0D12" CornerRadius="6"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Height="230" Margin="0,0,0,10" ClipToBounds="True"
                    x:Name="PreviewFrame" Focusable="True" FocusVisualStyle="{x:Null}"
                    PreviewKeyDown="PreviewFrame_PreviewKeyDown"
                    MouseLeftButtonDown="PreviewFrame_MouseLeftButtonDown"
                    MouseMove="PreviewFrame_MouseMove"
                    MouseLeftButtonUp="PreviewFrame_MouseLeftButtonUp"
                    MouseWheel="PreviewFrame_MouseWheel"
                    ToolTip="Con una imagen o un video: arrastrá para correrlo, la ruedita hace zoom, las flechas lo corren de a poquito (con Mayús, más).">
                <controls:SlideView x:Name="Preview" State="Logo"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Fields" Margin="2,0,10,0">
                    <TextBlock Text="Nombre (el que ves al elegirlo)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource Field}" TextChanged="Field_Changed"/>

                    <TextBlock Text="Tipo de logo" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="KindBox" SelectionChanged="Field_Changed">
                        <ComboBoxItem Content="Imagen (PNG, JPG…)"/>
                        <ComboBoxItem Content="Video en bucle"/>
                        <ComboBoxItem Content="Texto libre"/>
                    </ComboBox>

                    <!-- Archivo: imagen o video -->
                    <StackPanel x:Name="FilePanel">
                        <TextBlock Text="Archivo" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Examinar…" FontSize="11" Padding="10,4" Margin="6,0,0,0"
                                    Style="{StaticResource DarkButton}" Click="Browse_Click"/>
                            <TextBox x:Name="PathBox" Style="{StaticResource Field}" IsReadOnly="True"/>
                        </DockPanel>

                        <TextBlock Text="Cómo se acomoda en la pantalla" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ScalingBox" SelectionChanged="Field_Changed">
                            <ComboBoxItem Content="Rellenar (recorta lo que sobra)"/>
                            <ComboBoxItem Content="Entero (con bordes del color de fondo)"/>
                            <ComboBoxItem Content="Estirar (deforma)"/>
                        </ComboBox>

                        <!-- ── Encuadre: lo mismo que en Propiedades de un medio ── -->
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                                Padding="12,4,12,12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Encuadre" Style="{StaticResource FieldLabel}"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Zoom" FontSize="11" Width="64" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <controls:NumericField x:Name="ZoomField" ValueChanged="Field_Changed" Minimum="10" Maximum="400" Step="5" Decimals="0"
                                                           ToolTip="100 % es como está. Más acerca y recorta; menos aleja y deja ver el relleno."/>
                                    <TextBlock Text="%" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <Button Content="Reencuadrar" Style="{StaticResource DarkButton}" FontSize="11"
                                            Padding="10,3" Margin="12,0,0,0" Click="ResetFraming_Click"
                                            ToolTip="Vuelve a 100 %, centrado y a pantalla completa"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Correr" FontSize="11" Width="64" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <controls:NumericField x:Name="OffsetXField" ValueChanged="Field_Changed" Minimum="-1000" Maximum="1000" Step="2" Decimals="1"
                                                           ToolTip="Hacia los lados, en % de la pantalla"/>
                                    <TextBlock Text="↔" FontSize="12" VerticalAlignment="Center" Margin="6,0,10,0"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <controls:NumericField x:Name="OffsetYField" ValueChanged="Field_Changed" Minimum="-1000" Maximum="1000" Step="2" Decimals="1"
                                                           ToolTip="Hacia arriba y abajo, en % de la pantalla"/>
                                    <TextBlock Text="↕" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>

                                <CheckBox x:Name="FixedSizeCheck" Content="Tamaño fijo en pantalla" Margin="0,12,0,0"
                                          Checked="FixedSize_Changed" Unchecked="FixedSize_Changed"
                                          ToolTip="Para cuando la pantalla de la iglesia no tiene la forma de la imagen del proyector"/>
                                <StackPanel x:Name="SizeRow" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="False">
                                    <TextBlock Text="Medida" FontSize="11" Width="64" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <controls:NumericField x:Name="FrameWidthField" ValueChanged="Field_Changed" Minimum="16" Maximum="1920" Step="16" Decimals="0"/>
                                    <TextBlock Text="×" FontSize="12" VerticalAlignment="Center" Margin="6,0,6,0"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <controls:NumericField x:Name="FrameHeightField" ValueChanged="Field_Changed" Minimum="16" Maximum="1080" Step="16" Decimals="0"/>
                                    <TextBlock Text="px" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="PresetBox" Margin="64,6,0,0" FontSize="11" IsEnabled="False"
                                          SelectionChanged="Preset_Changed"
                                          ToolTip="Medidas comunes, por si no querés escribirlas">
                                    <ComboBoxItem Content="Medidas comunes…"/>
                                    <ComboBoxItem Content="1920 × 1080 (16:9, toda la pantalla)"/>
                                    <ComboBoxItem Content="1280 × 720 (16:9 más chico)"/>
                                    <ComboBoxItem Content="1440 × 1080 (4:3)"/>
                                    <ComboBoxItem Content="1080 × 1080 (cuadrado)"/>
                                    <ComboBoxItem Content="1080 × 1920 (vertical, celular)"/>
                                </ComboBox>

                                <TextBlock Text="Los bordes se rellenan con" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="FillMediaBox" SelectionChanged="Field_Changed" DisplayMemberPath="Name"
                                          ToolTip="El color de fondo (más abajo), la misma imagen desenfocada (así parece una sola imagen, sin bordes), o una imagen de la biblioteca"/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="MuteCheck" Content="Silenciar el audio del video"
                                  Checked="Field_Changed" Unchecked="Field_Changed"/>
                    </StackPanel>

                    <!-- Texto libre -->
                    <StackPanel x:Name="TextPanel">
                        <TextBlock Text="Texto a mostrar" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TextBoxField" Style="{StaticResource Field}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                                 VerticalContentAlignment="Top"
                                 services:SpellChecking.Enabled="True"
                                 TextChanged="Field_Changed"
                                 ToolTip="Podés usar varios renglones (ej. el nombre de la iglesia y el lema)"/>

                        <TextBlock Text="Tipografía" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FontCombo" IsEditable="True"
                                  SelectionChanged="Field_Changed" LostFocus="Field_Changed"/>

                        <TextBlock Text="Tamaño de letra" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <controls:NumericField x:Name="SizeField" Minimum="10" Maximum="400" Step="2"
                                                   Value="120" ValueChanged="Field_Changed"/>
                            <CheckBox x:Name="BoldCheck" Content="Negrita" Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Checked="Field_Changed" Unchecked="Field_Changed"/>
                        </StackPanel>

                        <TextBlock Text="Color del texto" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Paleta…" FontSize="11" Padding="8,3" Margin="6,0,0,0"
                                    Style="{StaticResource DarkButton}" Click="PickTextColor_Click"/>
                            <TextBox x:Name="TextColorBox" Style="{StaticResource Field}" TextChanged="Field_Changed"/>
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Text="Color de fondo de la pantalla (y de los bordes)" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Paleta…" FontSize="11" Padding="8,3" Margin="6,0,0,0"
                                Style="{StaticResource DarkButton}" Click="PickBackColor_Click"/>
                        <TextBox x:Name="BackColorBox" Style="{StaticResource Field}" TextChanged="Field_Changed"/>
                    </DockPanel>

                    <TextBlock Text="Desenfoque al usarlo como fondo (%)" Style="{StaticResource FieldLabel}"
                               ToolTip="Cuando ponés el logo detrás de la letra conviene difuminarlo para que se lea"/>
                    <controls:NumericField x:Name="BlurField" Minimum="0" Maximum="100" Step="5"
                                           Value="40" HorizontalAlignment="Left"
                                           ValueChanged="Field_Changed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Acciones ── -->
        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                       Text="Los cambios se guardan al cerrar."
                       FontSize="11" Foreground="{StaticResource FaintBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Listo" Style="{StaticResource AccentButton}" Padding="22,8" Click="Done_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
