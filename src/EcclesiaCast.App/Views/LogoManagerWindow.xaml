<Window x:Class="EcclesiaCast.App.Views.LogoManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EcclesiaCast.App.Controls"
        xmlns:services="clr-namespace:EcclesiaCast.App.Services"
        Title="Logos de la iglesia"
        Width="900" Height="640"
        MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,12,0,3"/>
        </Style>
        <Style TargetType="TextBox" x:Key="Field">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,14,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Lista de logos ── -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,8,10,6">
                        <Button Content="➕" FontSize="11" Padding="6,3"
                                Style="{StaticResource DarkButton}"
                                Click="New_Click" ToolTip="Nuevo logo"/>
                        <Button Content="⧉" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Click="Duplicate_Click" ToolTip="Duplicar el logo elegido"/>
                        <Button Content="🗑" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                Style="{StaticResource DarkButton}"
                                Click="Delete_Click" ToolTip="Eliminar el logo elegido"/>
                    </StackPanel>
                    <TextBlock Text="LOGOS" Style="{StaticResource PanelTitle}"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,4,12,10">
                    <Button Content="↑" FontSize="11" Padding="8,3"
                            Style="{StaticResource DarkButton}"
                            Click="MoveUp_Click" ToolTip="Subir en la lista"/>
                    <Button Content="↓" FontSize="11" Padding="8,3" Margin="4,0,0,0"
                            Style="{StaticResource DarkButton}"
                            Click="MoveDown_Click" ToolTip="Bajar en la lista"/>
                </StackPanel>
                <ListBox x:Name="LogosList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="LogosList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                Margin="6,1" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#20242F"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock x:Name="icon" DockPanel.Dock="Left" Text="🖼" FontSize="12" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Video">
                                    <Setter TargetName="icon" Property="Text" Value="🎞"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Text">
                                    <Setter TargetName="icon" Property="Text" Value="🔤"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ── Vista previa + campos ── -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0B0D12" CornerRadius="6"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Height="230" Margin="0,0,0,10">
                <controls:SlideView x:Name="Preview" State="Logo"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Fields" Margin="2,0,10,0">
                    <TextBlock Text="Nombre (el que ves al elegirlo)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource Field}" TextChanged="Field_Changed"/>

                    <TextBlock Text="Tipo de logo" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="KindBox" SelectionChanged="Field_Changed">
                        <ComboBoxItem Content="Imagen (PNG, JPG…)"/>
                        <ComboBoxItem Content="Video en bucle"/>
                        <ComboBoxItem Content="Texto libre"/>
                    </ComboBox>

                    <!-- Archivo: imagen o video -->
                    <StackPanel x:Name="FilePanel">
                        <TextBlock Text="Archivo" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Examinar…" FontSize="11" Padding="10,4" Margin="6,0,0,0"
                                    Style="{StaticResource DarkButton}" Click="Browse_Click"/>
                            <TextBox x:Name="PathBox" Style="{StaticResource Field}" IsReadOnly="True"/>
                        </DockPanel>

                        <TextBlock Text="Cómo se acomoda en la pantalla" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ScalingBox" SelectionChanged="Field_Changed">
                            <ComboBoxItem Content="Rellenar (recorta lo que sobra)"/>
                            <ComboBoxItem Content="Entero (con bordes del color de fondo)"/>
                            <ComboBoxItem Content="Estirar (deforma)"/>
                        </ComboBox>

                        <CheckBox x:Name="MuteCheck" Content="Silenciar el audio del video"
                                  Checked="Field_Changed" Unchecked="Field_Changed"/>
                    </StackPanel>

                    <!-- Texto libre -->
                    <StackPanel x:Name="TextPanel">
                        <TextBlock Text="Texto a mostrar" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TextBoxField" Style="{StaticResource Field}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                                 VerticalContentAlignment="Top"
                                 services:SpellChecking.Enabled="True"
                                 TextChanged="Field_Changed"
                                 ToolTip="Podés usar varios renglones (ej. el nombre de la iglesia y el lema)"/>

                        <TextBlock Text="Tipografía" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FontCombo" IsEditable="True"
                                  SelectionChanged="Field_Changed" LostFocus="Field_Changed"/>

                        <TextBlock Text="Tamaño de letra" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <controls:NumericField x:Name="SizeField" Minimum="10" Maximum="400" Step="2"
                                                   Value="120" ValueChanged="Field_Changed"/>
                            <CheckBox x:Name="BoldCheck" Content="Negrita" Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Checked="Field_Changed" Unchecked="Field_Changed"/>
                        </StackPanel>

                        <TextBlock Text="Color del texto" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Paleta…" FontSize="11" Padding="8,3" Margin="6,0,0,0"
                                    Style="{StaticResource DarkButton}" Click="PickTextColor_Click"/>
                            <TextBox x:Name="TextColorBox" Style="{StaticResource Field}" TextChanged="Field_Changed"/>
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Text="Color de fondo de la pantalla" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Paleta…" FontSize="11" Padding="8,3" Margin="6,0,0,0"
                                Style="{StaticResource DarkButton}" Click="PickBackColor_Click"/>
                        <TextBox x:Name="BackColorBox" Style="{StaticResource Field}" TextChanged="Field_Changed"/>
                    </DockPanel>

                    <TextBlock Text="Desenfoque al usarlo como fondo (%)" Style="{StaticResource FieldLabel}"
                               ToolTip="Cuando ponés el logo detrás de la letra conviene difuminarlo para que se lea"/>
                    <controls:NumericField x:Name="BlurField" Minimum="0" Maximum="100" Step="5"
                                           Value="40" HorizontalAlignment="Left"
                                           ValueChanged="Field_Changed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Acciones ── -->
        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                       Text="Los cambios se guardan al cerrar."
                       FontSize="11" Foreground="{StaticResource FaintBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Listo" Style="{StaticResource AccentButton}" Padding="22,8" Click="Done_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
