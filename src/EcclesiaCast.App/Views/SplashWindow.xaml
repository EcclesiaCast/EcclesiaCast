<Window x:Class="EcclesiaCast.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EcclesiaCast"
        Width="480" Height="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#0B1A33"
        FontFamily="Segoe UI">
    <!-- The loading screen: the sanctuary in the dark and a projector lamp
         whose beam reaches the logo, the name and the version. It does not
         move (the window thread is busy loading), so it carries no spinner
         that would freeze half way and look broken. The gold line at the
         bottom is the lamp's light on the floor, not a progress bar. -->
    <Border BorderBrush="#2A3F66" BorderThickness="1">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#17325C" Offset="0"/>
                    <GradientStop Color="#0B1A33" Offset="0.6"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- The beam: from the lamp at the left edge, widening to the right -->
            <Canvas IsHitTestVisible="False">
                <Polygon Points="0,146 0,154 478,18 478,282">
                    <Polygon.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#2EF4B942" Offset="0"/>
                            <GradientStop Color="#00F4B942" Offset="0.85"/>
                        </LinearGradientBrush>
                    </Polygon.Fill>
                </Polygon>
                <Ellipse Canvas.Left="10" Canvas.Top="140" Width="20" Height="20" Fill="#F4B942"/>
                <Ellipse Canvas.Left="2" Canvas.Top="132" Width="36" Height="36" Fill="#33F4B942"/>
            </Canvas>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0,0,0">
                <Image Source="{StaticResource AppLogoImage}" Width="96" Height="96"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"/>
                <TextBlock Text="EcclesiaCast" FontSize="32" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="Proyección gratis para tu iglesia" FontSize="13.5" Foreground="#F4B942"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="#9FB0CC"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="Cargando…" FontSize="12" Foreground="#9FB0CC"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <Rectangle VerticalAlignment="Bottom" Height="3" Fill="#F4B942" Opacity="0.85"
                       HorizontalAlignment="Stretch"/>
        </Grid>
    </Border>
</Window>
