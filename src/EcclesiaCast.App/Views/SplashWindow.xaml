<Window x:Class="EcclesiaCast.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EcclesiaCast"
        Width="440" Height="270"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <!-- The loading screen: the logo, the name, the version. It does not move
         (the window thread is busy loading), so it carries no spinner that
         would freeze half way and look broken. -->
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="{StaticResource AppLogoImage}" Width="92" Height="92"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="EcclesiaCast" FontSize="28" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock x:Name="VersionText" FontSize="13" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock Text="Cargando…" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" Margin="0,26,0,0"/>
        </StackPanel>
    </Border>
</Window>
