<Window x:Class="EcclesiaCast.App.Views.MediaTabRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="22,2,0,0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

        <RadioButton x:Name="PerItemRadio" Content="Como diga cada medio" GroupName="mode"
                     Checked="Mode_Changed"/>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Cada imagen o video usa lo que dice en sus Propiedades (fondo o primer plano)."/>

        <RadioButton x:Name="BackgroundRadio" Content="Todo va como fondo" GroupName="mode"
                     Checked="Mode_Changed"/>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Se ve detrás de la letra, y al cambiar de diapositiva sigue."/>

        <RadioButton x:Name="ForegroundRadio" Content="Todo va en primer plano" GroupName="mode"
                     Checked="Mode_Changed"/>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Ocupa toda la pantalla y tapa la letra (anuncios, videos de presentación)."/>

        <CheckBox x:Name="LogoCheck" Content="Al terminar, mostrar el logo" Margin="22,10,0,0"
                  Foreground="White" FontSize="12"/>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Los videos terminan en el logo. Las imágenes, pasados los segundos que tengan puestos en sus Propiedades; si no tienen, se quedan hasta que cambies."/>

        <CheckBox x:Name="PresentationCheck" Content="📑 Usar como presentación" Margin="0,16,0,0"
                  Foreground="White" FontSize="13"/>
        <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                   Text="Las imágenes y los videos de la pestaña se abren en el cuadro central, uno por página, como una canción: un clic en una tarjeta la proyecta y las flechas pasan de página. Va bien con un PDF o una presentación importados."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Guardar" Style="{StaticResource AccentButton}" IsDefault="True"
                    Click="Save_Click" Padding="20,8"/>
            <Button Content="Cancelar" Style="{StaticResource DarkButton}" IsCancel="True"
                    Padding="20,8" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
