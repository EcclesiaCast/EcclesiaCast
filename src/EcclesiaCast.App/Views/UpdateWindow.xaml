<Window x:Class="EcclesiaCast.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizar EcclesiaCast"
        Width="540" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <StackPanel x:Name="Root" Margin="26,22,26,20">
        <TextBlock x:Name="TitleText" Text="Hay una versión nueva de EcclesiaCast"
                   FontSize="19" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock x:Name="VersionsText" FontSize="13" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,6,0,0"/>

        <!-- Lo que trae la versión nueva -->
        <StackPanel x:Name="NotesPanel" Margin="0,18,0,0">
            <TextBlock Text="Lo que trae" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer x:Name="NotesScroll" MaxHeight="260"
                              VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <TextBlock x:Name="NotesText" FontSize="13" Foreground="#D5D9E3"
                               TextWrapping="Wrap" LineHeight="19"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Mientras baja, comprueba y guarda la copia, o cuando algo falló -->
        <StackPanel x:Name="WorkPanel" Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Progress" Height="6" Margin="0,12,0,0"
                         Background="{StaticResource SurfaceAltBrush}"
                         Foreground="{StaticResource AccentBrush}"
                         BorderThickness="0"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" FontSize="13" Foreground="#E88A8A" TextWrapping="Wrap"
                   Margin="0,18,0,0" Visibility="Collapsed"/>

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="Saltar esta versión"
                    Style="{StaticResource DarkButton}" Padding="14,8" Click="Skip_Click"
                    ToolTip="No avisar más por esta versión. Cuando salga una más nueva, avisa de nuevo."/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="LaterButton" Content="Más tarde"
                        Style="{StaticResource DarkButton}" Padding="18,8" IsCancel="True" Click="Later_Click"/>
                <Button x:Name="UpdateButton" Content="Actualizar ahora" Margin="8,0,0,0"
                        Style="{StaticResource AccentButton}" Padding="20,8" IsDefault="True" Click="Update_Click"/>
                <Button x:Name="CancelButton" Content="Cancelar" Margin="8,0,0,0"
                        Style="{StaticResource DarkButton}" Padding="20,8" Visibility="Collapsed" Click="Cancel_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
