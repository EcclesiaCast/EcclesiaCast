<Window x:Class="EcclesiaCast.App.Views.PixabayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EcclesiaCast.App.Converters"
        Title="Buscar fondos en Pixabay"
        Width="1040" Height="760" MinWidth="760" MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <converters:ThumbnailUrlConverter x:Key="ThumbnailFromUrl"/>
        <Style TargetType="RadioButton" x:Key="SegRadio">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="4" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Una tarjeta de resultado: se elige con un clic -->
        <Style TargetType="ToggleButton" x:Key="Card">
            <Setter Property="Width" Value="232"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="8" Padding="4" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="#1B2A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Búsqueda -->
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Buscar" Style="{StaticResource AccentButton}"
                    Padding="18,7" Margin="8,0,0,0" Click="Search_Click" IsDefault="True"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                <RadioButton x:Name="VideosRadio" Content="Videos" GroupName="Kind" Style="{StaticResource SegRadio}"
                             IsChecked="True" Click="Kind_Click"/>
                <RadioButton x:Name="PhotosRadio" Content="Fotos" GroupName="Kind" Style="{StaticResource SegRadio}"
                             Click="Kind_Click"/>
            </StackPanel>
            <Grid>
                <TextBox x:Name="QueryBox" FontSize="15" Padding="10,6" VerticalContentAlignment="Center"
                         Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                         BorderBrush="{StaticResource LineBrush}" CaretBrush="White"/>
                <TextBlock Text="Qué fondo buscás: cruz, cielo, luces, montañas, partículas…" IsHitTestVisible="False"
                           Margin="13,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource FaintBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <!-- Abajo: a qué pestaña, bajar, estado y crédito -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12">
                <Hyperlink x:Name="CreditLink" Foreground="{StaticResource AccentSoftBrush}" Click="Credit_Click">
                    <Run x:Name="CreditText"/>
                </Hyperlink>
            </TextBlock>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Agregar a" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="TabCombo" Width="180" FontSize="12" VerticalAlignment="Center"
                          ItemsSource="{Binding MediaTabs}" SelectedItem="{Binding SelectedMediaTab}"/>
                <Button x:Name="AddButton" Content="Bajar los elegidos" Style="{StaticResource AccentButton}"
                        Padding="18,8" Margin="10,0,0,0" Click="Add_Click" IsEnabled="False"/>
                <Button Content="Cerrar" Style="{StaticResource DarkButton}" Padding="18,8" Margin="8,0,0,0"
                        IsCancel="True" Click="Close_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusLine" Foreground="{StaticResource AccentSoftBrush}" FontSize="12"
                       VerticalAlignment="Center" TextAlignment="Right" Margin="12,0,14,0"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Resultados -->
        <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
            <Grid>
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="12,12,0,4">
                    <StackPanel>
                        <ItemsControl x:Name="Results">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource Card}" IsChecked="{Binding IsSelected}"
                                                  ToolTip="{Binding Tip}">
                                        <StackPanel>
                                            <Grid Height="126" ClipToBounds="True">
                                                <Border CornerRadius="5" Background="#0B0D12"/>
                                                <Image Source="{Binding ThumbnailUrl, Converter={StaticResource ThumbnailFromUrl}}" Stretch="UniformToFill"/>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                                        Background="#CC08142A" CornerRadius="4" Padding="6,2"
                                                        Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Hit.DurationText}" Foreground="White" FontSize="11"/>
                                                </Border>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                        Width="22" Height="22" CornerRadius="11" Background="{StaticResource AccentBrush}"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="✓" Foreground="White" FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                                                        Background="#CCF4B942" CornerRadius="4" Padding="6,2"
                                                        Visibility="{Binding AlreadyHave, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Ya está en tus medios" Foreground="#101826" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding AuthorLine}" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" Margin="2,6,2,2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="MoreButton" Content="Ver más resultados" Style="{StaticResource DarkButton}"
                                HorizontalAlignment="Center" Padding="18,8" Margin="0,4,0,12"
                                Visibility="Collapsed" Click="More_Click"/>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" FontSize="14"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Buscá un fondo arriba. Los videos y fotos de Pixabay se pueden usar gratis en la iglesia. Elegí los que quieras con un clic y tocá «Bajar los elegidos»."/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
