<Window x:Class="EcclesiaCast.App.Views.YouTubeDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Descargar video"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding Title, Mode=OneTime}"
                   FontSize="15" Foreground="White" TextWrapping="Wrap"/>

        <TextBlock Text="{Binding Status}"
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>

        <ProgressBar Height="6" Margin="0,12,0,0"
                     Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                     Background="{StaticResource SurfaceAltBrush}"
                     Foreground="{StaticResource AccentBrush}"
                     BorderThickness="0"/>

        <TextBlock Text="{Binding Quality, Mode=OneTime}"
                   FontSize="11" Foreground="{StaticResource FaintBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{Binding CloseText}" Style="{StaticResource DarkButton}"
                    Padding="20,8" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
