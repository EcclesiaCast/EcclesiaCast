<Window x:Class="EcclesiaCast.App.Views.YouTubeDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Descargar video"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="Descargando de YouTube"
                   FontSize="15" Foreground="White" TextWrapping="Wrap"/>

        <TextBlock x:Name="StatusText" Text="Preparando…"
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>

        <ProgressBar x:Name="Progress" Height="6" Margin="0,12,0,0"
                     Background="{StaticResource SurfaceAltBrush}"
                     Foreground="{StaticResource AccentBrush}"
                     BorderThickness="0"/>

        <TextBlock x:Name="QualityText"
                   FontSize="11" Foreground="{StaticResource FaintBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CloseButton" Content="Cancelar" Style="{StaticResource DarkButton}"
                    Padding="20,8" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
