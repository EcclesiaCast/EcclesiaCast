<Window x:Class="EcclesiaCast.App.Views.SongEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:EcclesiaCast.App.Services"
        Title="Canción"
        Width="680" Height="680"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Título *" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TitleBox"
                     Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                     BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                     Padding="8,6" FontSize="14"
                     services:SpellChecking.Enabled="True"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Artista" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ArtistBox"
                         Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                         BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                         Padding="8,6" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Copyright / CCLI" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="CopyrightBox"
                         Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                         BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                         Padding="8,6" FontSize="14"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" x:Name="ThemeRow">
            <TextBlock Text="Tema de proyección" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="ThemeCombo" FontSize="13"
                      DisplayMemberPath="Label"
                      ToolTip="'(Tema principal)' sigue al tema principal de las canciones. Para retocar el tema de esta canción: clic derecho en la canción → Tema de esta canción…"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Letra *" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,4"/>
        <TextBlock Grid.Row="4"
                   FontSize="11" Foreground="{StaticResource FaintBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="Cada párrafo es una diapositiva: separá las diapositivas con una línea en blanco. Para marcar el coro y las estrofas, poné el cursor en el párrafo y tocá un botón: agrega arriba una línea como [Coro] o [Estrofa 1], que no se proyecta y le pone nombre a los párrafos que siguen."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Marcar como:" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Coro" Tag="Coro" Click="Tag_Click" Focusable="False"
                    Style="{StaticResource DarkButton}" Padding="12,5" FontSize="12"
                    ToolTip="Pone [Coro] arriba del párrafo donde está el cursor"/>
            <Button Content="Estrofa" Tag="Estrofa" Click="Tag_Click" Focusable="False"
                    Style="{StaticResource DarkButton}" Padding="12,5" FontSize="12" Margin="6,0,0,0"
                    ToolTip="Pone [Estrofa 1], [Estrofa 2]… arriba del párrafo donde está el cursor: se numera sola"/>
            <Button Content="Puente" Tag="Puente" Click="Tag_Click" Focusable="False"
                    Style="{StaticResource DarkButton}" Padding="12,5" FontSize="12" Margin="6,0,0,0"
                    ToolTip="Pone [Puente] arriba del párrafo donde está el cursor"/>
            <Button Content="Final" Tag="Final" Click="Tag_Click" Focusable="False"
                    Style="{StaticResource DarkButton}" Padding="12,5" FontSize="12" Margin="6,0,0,0"
                    ToolTip="Pone [Final] arriba del párrafo donde está el cursor"/>
        </StackPanel>

        <TextBox Grid.Row="6"
                 x:Name="LyricsBox"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                 BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                 Padding="10,8" FontSize="14"
                 services:SpellChecking.Enabled="True"
                 ToolTip="Las palabras dudosas se subrayan en rojo · clic derecho para las sugerencias o para agregarlas al diccionario"/>

        <DockPanel Grid.Row="7" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText"
                       Foreground="#E08A8A" FontSize="12"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Style="{StaticResource DarkButton}"
                        IsCancel="True"
                        Padding="18,9"/>
                <Button Content="Guardar"
                        Style="{StaticResource AccentButton}"
                        Click="Save_Click"
                        IsDefault="False"
                        Padding="18,9" Margin="10,0,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
