<Window x:Class="EcclesiaCast.App.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:EcclesiaCast.App.Services"
        Title="Cuenta regresiva"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="18">

        <TextBlock Text="Se proyecta sobre el fondo que tengas puesto, hasta que la detengas."
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <!-- Cuánto falta: minutos desde ahora, o una hora del reloj -->
        <RadioButton x:Name="ByMinutes" GroupName="Modo" IsChecked="True"
                     Foreground="White" VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Empezar en" VerticalAlignment="Center" Foreground="White"/>
                <TextBox x:Name="MinutesBox" Text="5" Width="56" Margin="8,0"
                         Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                         BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                         Padding="8,5" TextAlignment="Center"
                         PreviewTextInput="Digits_Only"/>
                <TextBlock Text="minutos" VerticalAlignment="Center" Foreground="White"/>
            </StackPanel>
        </RadioButton>

        <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
            <Button Content="5" Width="44" Style="{StaticResource DarkButton}" Click="Preset_Click" Tag="5"/>
            <Button Content="10" Width="44" Style="{StaticResource DarkButton}" Margin="6,0,0,0" Click="Preset_Click" Tag="10"/>
            <Button Content="15" Width="44" Style="{StaticResource DarkButton}" Margin="6,0,0,0" Click="Preset_Click" Tag="15"/>
            <Button Content="30" Width="44" Style="{StaticResource DarkButton}" Margin="6,0,0,0" Click="Preset_Click" Tag="30"/>
        </StackPanel>

        <RadioButton x:Name="ByClock" GroupName="Modo" Margin="0,14,0,0"
                     Foreground="White" VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Empezar a las" VerticalAlignment="Center" Foreground="White"/>
                <TextBox x:Name="ClockBox" Text="10:30" Width="76" Margin="8,0"
                         Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                         BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                         Padding="8,5" TextAlignment="Center"
                         GotFocus="Clock_GotFocus"
                         ToolTip="Hora del reloj, en 24 horas: 10:30, 19:00"/>
                <TextBlock Text="(hora del reloj)" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </StackPanel>
        </RadioButton>

        <TextBlock Text="Texto de arriba" Margin="0,18,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        <TextBox x:Name="HeadingBox"
                 Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                 BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                 Padding="10,7" FontSize="14"
                 services:SpellChecking.Enabled="True"/>

        <TextBlock Text="Cuando llega a cero" Margin="0,14,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        <TextBox x:Name="FinishedBox"
                 Background="{StaticResource SurfaceAltBrush}" Foreground="White"
                 BorderBrush="{StaticResource LineBrush}" CaretBrush="White"
                 Padding="10,7" FontSize="14"
                 services:SpellChecking.Enabled="True"
                 ToolTip="Queda en pantalla hasta que la detengas. Vacío deja el 0:00."/>

        <TextBlock x:Name="ErrorText" Foreground="#E86A6A" FontSize="12"
                   Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="StopButton" Content="Detener la que corre" Style="{StaticResource DarkButton}"
                    Padding="16,8" Margin="0,0,8,0" Visibility="Collapsed" Click="Stop_Click"/>
            <Button Content="Proyectar" Style="{StaticResource AccentButton}" Padding="22,8"
                    IsDefault="True" Click="Start_Click"/>
            <Button Content="Cancelar" Style="{StaticResource DarkButton}" Padding="20,8"
                    Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
