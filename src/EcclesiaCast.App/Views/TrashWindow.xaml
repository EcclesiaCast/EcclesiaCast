<Window x:Class="EcclesiaCast.App.Views.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Papelera"
        Width="640" Height="460" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" FontSize="12" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Lo que borrás de la biblioteca queda acá 30 días. Después se borra del todo."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RestoreButton" Content="Restaurar" Padding="14,6" Style="{StaticResource DarkButton}"
                    IsEnabled="False" Click="Restore_Click"/>
            <Button x:Name="PurgeButton" Content="Borrar del todo" Padding="14,6" Margin="8,0,0,0"
                    Style="{StaticResource DarkButton}" IsEnabled="False" Click="Purge_Click"/>
            <Button x:Name="EmptyButton" Content="Vaciar la papelera" Padding="14,6" Margin="8,0,0,0"
                    Style="{StaticResource DarkButton}" Click="Empty_Click"/>
            <Button Content="Cerrar" Padding="14,6" Margin="8,0,0,0" Style="{StaticResource DarkButton}"
                    IsCancel="True" IsDefault="True"/>
        </StackPanel>

        <Border Style="{StaticResource Panel}">
            <Grid>
                <ListBox x:Name="TrashList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="TrashList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,3">
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="La papelera está vacía."
                           Style="{StaticResource PlaceholderText}" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
