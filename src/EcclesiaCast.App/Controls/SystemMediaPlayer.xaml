<UserControl x:Class="EcclesiaCast.App.Controls.SystemMediaPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mini reproductor de lo que suene en la computadora (Spotify, el
         navegador…): la carátula, el título y los botones. Lo lee de los
         controles multimedia de Windows; no tiene nada de Spotify adentro. -->
    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="6" Padding="10">
        <StackPanel>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="4" ClipToBounds="True"
                        Background="{StaticResource BgBrush}" Margin="0,0,10,0">
                    <Grid>
                        <TextBlock Text="♪" FontSize="26" Foreground="{StaticResource FaintBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="Cover" Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistText" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SourceText" FontSize="10.5" Margin="0,2,0,0"
                               Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>

            <DockPanel x:Name="TimeRow" Margin="0,10,0,0">
                <TextBlock x:Name="TotalText" DockPanel.Dock="Right" FontSize="10.5" Margin="8,0,0,0"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="PositionText" DockPanel.Dock="Left" FontSize="10.5" Margin="0,0,8,0"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="1" VerticalAlignment="Center"
                             Background="{StaticResource LineBrush}" Foreground="{StaticResource AccentSoftBrush}"
                             BorderThickness="0"/>
            </DockPanel>

            <UniformGrid Columns="3" Margin="0,10,0,0">
                <Button Content="⏮" FontSize="16" Padding="0,7" Margin="0,0,3,0" Style="{StaticResource DarkButton}"
                        Click="Previous_Click" AutomationProperties.Name="Canción anterior"
                        ToolTip="Canción anterior"/>
                <Button x:Name="PlayPauseButton" Content="⏯" FontSize="16" Padding="0,7" Margin="3,0"
                        Style="{StaticResource DarkButton}" Click="PlayPause_Click"
                        AutomationProperties.Name="Reproducir o pausar" ToolTip="Reproducir o pausar"/>
                <Button Content="⏭" FontSize="16" Padding="0,7" Margin="3,0,0,0" Style="{StaticResource DarkButton}"
                        Click="Next_Click" AutomationProperties.Name="Canción siguiente"
                        ToolTip="Canción siguiente"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
