<UserControl x:Class="EcclesiaCast.App.Controls.YouTubeSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Background="Black">
        <!-- El video no se toca en la salida (el operador lo maneja desde el panel).
             El mouse y Esc los atrapa una capa dentro de la página del reproductor y
             los pasa al programa (DoubleClicked, MenuRequested, EscapePressed): así
             el doble clic y Esc siguen sirviendo para volver cuando la salida tapa
             la única pantalla. -->
        <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="Black" Focusable="False"/>
    </Grid>
</UserControl>
