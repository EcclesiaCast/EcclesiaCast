<UserControl x:Class="EcclesiaCast.App.Controls.VlcVideoSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True">
    <!-- The decoded video frames are written into a WriteableBitmap, so the
         text (a normal WPF layer above) composites cleanly on top — no
         native/WPF airspace problem. ClipToBounds: «Rellenar» dibuja la
         imagen entera y deja que lo que no entra sobresalga; el borde de la
         pantalla es el único recorte. -->
    <Grid>
        <Image x:Name="Surface" Stretch="UniformToFill"/>

        <!-- El último cuadro del video anterior, congelado, mientras llega el
             primero del que sigue (o mientras una imagen se funde encima): así
             cambiar de medio no pasa por negro. -->
        <Image x:Name="Hold" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
