<UserControl x:Class="EcclesiaCast.App.Controls.ProjectedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EcclesiaCast.App.Controls">
    <!-- Transparent root so the video (behind, in the output window) shows
         through where there is no image background. -->
    <Grid Background="Transparent" ClipToBounds="True">
        <!-- Relleno: lo que se ve donde la imagen no llega, por zoom hacia
             afuera o por un tamaño fijo más chico que la pantalla. -->
        <Rectangle x:Name="FillColorLayer" Visibility="Collapsed"/>
        <Image x:Name="FillImage" Stretch="UniformToFill" Visibility="Collapsed"/>

        <!-- Capa de fondo global (imagen; el video llega después) -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed"
               RenderTransformOrigin="0.5,0.5"/>

        <!-- En los previews del operador: el mismo cuadro que está dibujando
             el proyector, así el video se ve avanzar y no como una foto -->
        <Image x:Name="LiveVideo" Stretch="UniformToFill" Visibility="Collapsed"
               RenderTransformOrigin="0.5,0.5"/>

        <!-- Ajustes de imagen del medio: se aplican tanto a la imagen de acá
             como al video que corre detrás, porque esta capa va encima -->
        <Rectangle x:Name="BrightnessLayer" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Rectangle x:Name="TintLayer" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- Texto, estados (Clear/Black/Logo), aviso al pie y resaltado -->
        <controls:SlideView x:Name="SlideRenderer"/>
    </Grid>
</UserControl>
