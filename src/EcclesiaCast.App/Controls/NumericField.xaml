<UserControl x:Class="EcclesiaCast.App.Controls.NumericField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Botón cuadrado de paso (−/+), del alto del campo -->
        <Style TargetType="RepeatButton" x:Key="StepButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Delay" Value="450"/>
            <Setter Property="Interval" Value="70"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="bd" CornerRadius="3"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2C3040"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <RepeatButton x:Name="Down" DockPanel.Dock="Left" Content="−"
                      Style="{StaticResource StepButton}" Margin="0,0,4,0"
                      Click="Down_Click" ToolTip="Bajar (Shift = paso grande)"/>
        <RepeatButton x:Name="Up" DockPanel.Dock="Right" Content="+"
                      Style="{StaticResource StepButton}" Margin="4,0,0,0"
                      Click="Up_Click" ToolTip="Subir (Shift = paso grande)"/>
        <TextBox x:Name="Entry"
                 Background="{StaticResource SurfaceAltBrush}"
                 Foreground="White"
                 BorderBrush="{StaticResource LineBrush}"
                 CaretBrush="White"
                 Padding="6,3" FontSize="12"
                 MinWidth="46"
                 TextAlignment="Center"
                 VerticalContentAlignment="Center"
                 TextChanged="Entry_TextChanged"
                 LostFocus="Entry_LostFocus"
                 PreviewKeyDown="Entry_KeyDown"
                 MouseWheel="Entry_MouseWheel"
                 ToolTip="Escribí el número, o usá − / + · rueda del mouse y flechas ↑↓ también"/>
    </DockPanel>
</UserControl>
