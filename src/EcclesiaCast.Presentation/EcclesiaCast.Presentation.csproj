<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that decides something and does not draw: view models,
       services and the platform interfaces. Plain .NET, without WPF or
       anything of Windows, so the Windows (WPF) and the Mac (Avalonia)
       programs share it. If it does not compile without WPF, it does not
       belong here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EcclesiaCast.Core\EcclesiaCast.Core.csproj" />
    <ProjectReference Include="..\EcclesiaCast.Data\EcclesiaCast.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

</Project>
